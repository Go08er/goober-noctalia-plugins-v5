def _usage_error(wire: str, message: str) -> int:
    _emit_fields(wire, "error", "usage", message)
    return 64


def main(arguments: list[str]) -> int:
    if arguments == ["probe", "--protocol", "1"]:
        _emit_fields(
            BACKEND_PROBE_WIRE,
            "ok",
            BACKEND_PROTOCOL,
            BACKEND_VERSION,
            BACKEND_CAPABILITIES,
        )
        return 0
    if arguments == ["motionbgs-probe", "--protocol", "1"]:
        _emit_fields(PROBE_WIRE, "ok", PROTOCOL, VERSION, CAPABILITIES)
        return 0
    if arguments == ["self-test"]:
        try:
            _backend_self_test()
            _motionbgs_self_test()
        except Exception as error:
            _emit_fields(
                BACKEND_SELF_TEST_WIRE,
                "error",
                "self-test",
                _clean_field(error),
            )
            return 1
        _emit_fields(BACKEND_SELF_TEST_WIRE, "ok", BACKEND_VERSION)
        return 0
    if arguments == ["motionbgs-self-test"]:
        try:
            _motionbgs_self_test()
        except Exception as error:
            _emit_fields(SELF_TEST_WIRE, "error", "self-test", _clean_field(error))
            return 1
        _emit_fields(SELF_TEST_WIRE, "ok", VERSION)
        return 0
    if arguments and arguments[0] in {"rpc", "motionbgs-rpc"}:
        if (
            len(arguments) != 9
            or arguments[1:3] != ["--protocol", "1"]
            or arguments[3] != "--request"
            or arguments[5] != "--response"
            or arguments[7] != "--guard"
        ):
            return _usage_error(
                BACKEND_RPC_WIRE if arguments[0] == "rpc" else RPC_WIRE,
                "rpc expects --protocol 1 --request ABS --response ABS --guard ABS",
            )
        try:
            if arguments[0] == "rpc":
                return _backend_rpc(arguments[4], arguments[6], arguments[8])
            return _motionbgs_rpc(arguments[4], arguments[6], arguments[8])
        except HelperError as error:
            if arguments[0] == "rpc":
                _emit_fields(BACKEND_RPC_WIRE, "error", error.kind, error.message)
            else:
                _emit_rpc_error(error)
            return error.exit_code
        except Exception as error:
            failure = HelperError("internal", f"unexpected helper failure: {error}", 70)
            if arguments[0] == "rpc":
                _emit_fields(BACKEND_RPC_WIRE, "error", failure.kind, failure.message)
            else:
                _emit_rpc_error(failure)
            return failure.exit_code
    if arguments and arguments[0] in {"motionbgs-probe", "motionbgs-rpc"}:
        wire = PROBE_WIRE if arguments[0] == "motionbgs-probe" else RPC_WIRE
    else:
        wire = BACKEND_PROBE_WIRE if arguments and arguments[0] == "probe" else BACKEND_SELF_TEST_WIRE
    return _usage_error(
        wire,
        "expected probe --protocol 1, rpc ..., self-test, or a motionbgs-* compatibility command",
    )


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except BrokenPipeError:
        raise SystemExit(74)
