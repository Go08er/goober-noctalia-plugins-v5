        raise HelperError(
            "invalid-slug", f"{label} is not a lowercase MotionBGS slug", 64
        )
    return value


def _normalize_provider_url(value: str, *, base: str | None = None) -> str:
    if not isinstance(value, str) or not value or len(value) > 2048:
        raise HelperError("invalid-url", "provider URL is empty or too long", 64)
    if any(ord(char) < 32 or ord(char) == 127 for char in value) or "\\" in value:
        raise HelperError("invalid-url", "provider URL contains unsafe characters", 64)
    candidate = urljoin(base or ORIGIN + "/", value)
    parsed = urlsplit(candidate)
    try:
        port = parsed.port
    except ValueError as error:
        raise HelperError(
            "invalid-url", "provider URL contains an invalid port", 64
        ) from error
    if (
        parsed.scheme.lower() != "https"
        or (parsed.hostname or "").lower() != HOST
        or port not in (None, 443)
        or parsed.username is not None
        or parsed.password is not None
        or parsed.fragment
    ):
        raise HelperError(
            "invalid-url", "only the exact MotionBGS HTTPS origin is accepted", 64
        )
    if not parsed.path.startswith("/") or "//" in parsed.path:
        raise HelperError("invalid-url", "provider URL path is malformed", 64)
    decoded_path = re.sub("%2f", "/", parsed.path, flags=re.IGNORECASE)
    decoded_path = re.sub("%5c", lambda _match: "\\", decoded_path, flags=re.IGNORECASE)
    decoded_path = re.sub("%2e", ".", decoded_path, flags=re.IGNORECASE)
    if "\\" in decoded_path or any(
        part in {".", ".."} for part in decoded_path.split("/")
    ):
        raise HelperError("invalid-url", "provider URL contains a traversal path", 64)
    # Port 443 is the default HTTPS origin, so canonicalize it away. This keeps
    # helper output byte-for-byte compatible with the bridge's fixed BASE_URL.
    return urlunsplit(("https", HOST, parsed.path, parsed.query, ""))


def _site_path(value: str) -> str:
    path = urlsplit(_normalize_provider_url(value)).path.rstrip("/")
    return path or "/"


def _still_url(value: Any) -> str:
    if not isinstance(value, str) or not value:
        return ""
    try:
        normalized = _normalize_provider_url(value)
    except HelperError:
        return ""
    parsed = urlsplit(normalized)
    if parsed.query:
        return ""
    match = STILL_PATH_RE.fullmatch(parsed.path)
    if match is None:
        return ""
    width, height, _media_id, filename = match.groups()
    if width is not None and (int(width) > 4096 or int(height) > 4096):
        return ""
    if not filename.lower().endswith((".jpg", ".jpeg", ".png", ".webp")):
        return ""
    return normalized


def _video_url(value: Any) -> str:
    if not isinstance(value, str) or not value:
        return ""
    try:
        normalized = _normalize_provider_url(value)
    except HelperError:
        return ""
    parsed = urlsplit(normalized)
    return (
        normalized
        if not parsed.query and VIDEO_PATH_RE.fullmatch(parsed.path) is not None
        else ""
    )


def _bounded_text(value: Any, maximum: int) -> str:
    return _clean_field(html.unescape(str(value if value is not None else "")), maximum)


def _browse_request(request: dict[str, Any]) -> tuple[str, str, str, int]:
    mode = request.get("mode")
    if mode not in {"search", "latest", "genre", "4k", "hd"}:
        raise HelperError(
            "invalid-browse", "browse mode must be search, latest, genre, 4k, or hd", 64
        )
    page = _int_field(request.get("page"), "page", 1, MAX_PAGE)
    query = ""
    genre = ""
    if mode == "search":
        query = _normalized_query(request.get("query"))
        if request.get("query") != query:
            raise HelperError(
                "invalid-browse",
                "search query must already be whitespace-normalized",
                64,
            )
        if page != 1:
            raise HelperError(
                "invalid-browse", "MotionBGS text search does not expose pagination", 64
            )
    elif request.get("query", "") not in (None, ""):
        raise HelperError("invalid-browse", "query is valid only in search mode", 64)
    if mode == "genre":
        genre = _slug(request.get("genre"), label="genre")
    elif request.get("genre", "") not in (None, ""):
        raise HelperError("invalid-browse", "genre is valid only in genre mode", 64)
    if mode == "hd" and page != 1:
        raise HelperError(
            "invalid-browse",
            "MotionBGS HD browsing is intentionally first-page-only",
            64,
        )
    return mode, query, genre, page


def _browse_url(mode: str, query: str, genre: str, page: int) -> str:
    if mode == "search":
        return f"{ORIGIN}/search?q={quote_plus(query)}"
    if mode == "latest":
        return ORIGIN + "/" + ("" if page == 1 else f"{page}/")
    if mode == "genre":
        return f"{ORIGIN}/tag:{genre}/" + ("" if page == 1 else f"{page}/")
    if mode == "4k":
        return f"{ORIGIN}/4k/" + ("" if page == 1 else f"{page}/")
    return f"{ORIGIN}/hd/"


def _canonical_search_slug(query: str) -> str | None:
    candidate = query.lower().replace(" ", "-")
    return candidate if SLUG_RE.fullmatch(candidate) is not None else None


def _listing_route_matches(
    mode: str, query: str, genre: str, page: int, value: str
) -> bool:
    normalized = _normalize_provider_url(value)
    parsed = urlsplit(normalized)
    actual = parsed.path.rstrip("/") or "/"
    if mode == "search":
        canonical = _canonical_search_slug(query)
        return normalized == _browse_url(mode, query, genre, page) or (
            parsed.query == ""
            and canonical is not None
            and actual == f"/tag:{canonical}"
        )
    return parsed.query == "" and actual == _site_path(
        _browse_url(mode, query, genre, page)
    )


def _validate_request_keys(request: dict[str, Any], action: str) -> None:
    # The bridge emits cache_ttl_seconds in its common envelope, including a
    # clear request where the value is informational and no cache read occurs.
    common = {
        "schema",
        "request_id",
        "action",
        "cache_directory",
        "cache_ttl_seconds",
        "guard_path",
        "operation_timeout_ms",
    }
    action_keys = {
        "search": {"mode", "query", "genre", "page", "limit", "force"},
        "details": {"slug", "force"},
        "download": {
            "slug",
            "quality",
            "download_directory",
            "managed_marker_path",
            "max_download_bytes",
            "download_timeout_seconds",
            "force",
        },
        "clear": set(),
    }
    extras = set(request) - common - action_keys[action]
    if extras:
        raise HelperError(
            "invalid-request",
            f"request contains unsupported field: {sorted(extras)[0]}",
            64,
        )


def _load_request(path: str) -> dict[str, Any]:
    request_path = _safe_absolute_path(path)
    raw = _read_bounded_file(request_path, MAX_REQUEST_BYTES)
    try:
        decoded = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise HelperError(
            "invalid-request", f"request is not bounded UTF-8 JSON: {error}", 64
        ) from error
    if not isinstance(decoded, dict) or decoded.get("schema") != PROTOCOL:
        raise HelperError(
            "invalid-request", "request must be a schema-1 JSON object", 64
        )
    request_id = decoded.get("request_id")
    if not isinstance(request_id, str) or REQUEST_ID_RE.fullmatch(request_id) is None:
        raise HelperError(
            "invalid-request", "request_id has an invalid wire format", 64
        )
    action = decoded.get("action")
    if action not in {"search", "details", "download", "clear"}:
        raise HelperError(
            "invalid-request", "action must be search, details, download, or clear", 64
        )
    _validate_request_keys(decoded, action)
    cache_directory = _existing_directory(decoded.get("cache_directory"))
    if not _is_within(request_path, cache_directory):
        raise HelperError(
            "invalid-path", "request file must be inside its cache directory", 64
        )
    decoded["cache_directory"] = cache_directory
    guard_path = _safe_absolute_path(decoded.get("guard_path"))
    if (
        not _is_within(guard_path, cache_directory)
        or GUARD_NAME_RE.fullmatch(os.path.basename(guard_path)) is None
    ):
        raise HelperError(
            "invalid-path",
            "cancellation guard must be a named file inside the cache directory",
            64,
        )
    decoded["guard_path"] = guard_path
    decoded["operation_timeout_ms"] = _int_field(
        decoded.get("operation_timeout_ms"),
        "operation_timeout_ms",
        MIN_OPERATION_TIMEOUT_MS,
        MAX_OPERATION_TIMEOUT_MS,
    )
    decoded["_deadline_monotonic"] = (
        time.monotonic() + decoded["operation_timeout_ms"] / 1000.0
    )
    decoded["force"] = _bool_field(decoded.get("force", False), "force")
    decoded["cache_ttl_seconds"] = _int_field(
        decoded.get("cache_ttl_seconds"),
        "cache_ttl_seconds",
        MIN_CACHE_TTL_SECONDS,
        MAX_CACHE_TTL_SECONDS,
    )
    if action == "search":
        mode, query, genre, page = _browse_request(decoded)
        decoded.update(mode=mode, query=query, genre=genre, page=page)
        decoded["limit"] = _int_field(decoded.get("limit"), "limit", 1, MAX_RESULTS)
    elif action in {"details", "download"}:
        decoded["slug"] = _slug(decoded.get("slug"))
    if action == "download":
        quality = decoded.get("quality")
        if quality not in {"hd", "4k"}:
            raise HelperError("invalid-quality", "quality must be hd or 4k", 64)
        decoded["quality"] = quality
        download_directory = _existing_directory(decoded.get("download_directory"))
        marker_path = _safe_absolute_path(decoded.get("managed_marker_path"))
        expected_marker = download_directory + "/" + MARKER_NAME
        if marker_path != expected_marker:
            raise HelperError(
                "invalid-marker",
                "managed marker path does not match the download directory",
                64,
            )
        marker = _read_bounded_file(marker_path, len(MARKER_CONTENT))
        if marker != MARKER_CONTENT:
            raise HelperError(
                "invalid-marker", "managed MotionBGS directory marker is invalid", 65
            )
        decoded["download_directory"] = download_directory
        decoded["managed_marker_path"] = marker_path
        decoded["max_download_bytes"] = _int_field(
            decoded.get("max_download_bytes"),
            "max_download_bytes",
            MIN_DOWNLOAD_BYTES,
            MAX_DOWNLOAD_BYTES,
        )
        decoded["download_timeout_seconds"] = _int_field(
            decoded.get("download_timeout_seconds"), "download_timeout_seconds", 10, 50
        )
    return decoded


def _empty_cache() -> dict[str, Any]:
    return {
        "schema": 1,
        "searches": {},
        "search_order": [],
        "details": {},
        "detail_order": [],
    }


def _cache_path(directory: str) -> str:
    return directory + "/" + CACHE_NAME


def _load_cache(directory: str) -> dict[str, Any]:
    path = _cache_path(directory)
    try:
        raw = _read_bounded_file(path, MAX_CACHE_BYTES)
    except HelperError as error:
        if not os.path.lexists(path) or error.kind in {"size-limit", "invalid-path"}:
            return _empty_cache()
        raise
    try:
        candidate = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return _empty_cache()
    if not isinstance(candidate, dict) or candidate.get("schema") != 1:
        return _empty_cache()
    searches = candidate.get("searches")
    search_order = candidate.get("search_order")
    details = candidate.get("details")
    detail_order = candidate.get("detail_order")
    if not all(
        isinstance(value, expected)
        for value, expected in (
            (searches, dict),
            (search_order, list),
            (details, dict),
            (detail_order, list),
        )
    ):
        return _empty_cache()
    normalized = _empty_cache()
    seen: set[str] = set()
    for key in search_order[-MAX_SEARCH_CACHE:]:
        if (
            isinstance(key, str)
            and SAFE_CACHE_KEY_RE.fullmatch(key)
            and key not in seen
            and isinstance(searches.get(key), dict)
        ):
            normalized["searches"][key] = searches[key]
            normalized["search_order"].append(key)
            seen.add(key)
    seen.clear()
    for key in detail_order[-MAX_DETAIL_CACHE:]:
        if (
            isinstance(key, str)
            and SLUG_RE.fullmatch(key)
            and key not in seen
            and isinstance(details.get(key), dict)
        ):
            normalized["details"][key] = details[key]
            normalized["detail_order"].append(key)
            seen.add(key)
    return normalized


def _save_cache(directory: str, cache: dict[str, Any]) -> None:
    payload = _encode_json(cache, MAX_CACHE_BYTES)
    target = _cache_path(directory)
    if os.path.lexists(target):
        try:
            info = os.lstat(target)
        except OSError as error:
            raise HelperError(
                "cache", f"could not inspect the MotionBGS cache: {error.strerror}", 74
            ) from error
        if (
            not stat.S_ISREG(info.st_mode)
            or stat.S_ISLNK(info.st_mode)
            or info.st_uid != os.getuid()
        ):
            raise HelperError("cache", "existing MotionBGS cache path is unsafe", 65)
        if info.st_size > MAX_CACHE_BYTES:
            # A bounded reader intentionally refuses this file. It is still
            # safe to discard only after lstat proves it is our regular file;
            # otherwise one oversized cache would make every future save fail.
            try:
                os.unlink(target)
            except OSError as error:
                raise HelperError(
                    "cache",
                    f"could not discard an oversized MotionBGS cache: {error.strerror}",
                    74,
                ) from error
    temporary = _new_temporary(directory, ".wall-in-one-motionbgs-cache.")
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY
            | os.O_TRUNC
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
        try:
            _write_all(descriptor, payload)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.replace(temporary, target)
        _forget_temporary(temporary)
    except OSError as error:
        raise HelperError(
            "cache", f"could not persist the MotionBGS cache: {error.strerror}", 74
        ) from error


def _touch_order(cache: dict[str, Any], domain: str, key: str, maximum: int) -> None:
    order_name = "search_order" if domain == "searches" else "detail_order"
    order = [item for item in cache[order_name] if item != key]
    order.append(key)
    while len(order) > maximum:
        cache[domain].pop(order.pop(0), None)
    cache[order_name] = order


def _cache_key(request: dict[str, Any]) -> str:
    canonical = {
        "mode": request["mode"],
        "query": request["query"].lower(),
        "genre": request["genre"],
        "page": request["page"],
        "limit": request["limit"],
    }
    return hashlib.sha256(_encode_json(canonical, 1024)).hexdigest()


def _fresh(timestamp: Any, ttl: int) -> bool:
    if type(timestamp) not in (int, float):
        return False
    age = time.time() - float(timestamp)
    return 0 <= age <= ttl


def _require_guard(path: str) -> None:
    try:
        payload = _read_bounded_file(
            path, len(GUARD_CONTENT), minimum=len(GUARD_CONTENT)
        )
    except HelperError as error:
        raise Cancelled() from error
    if payload != GUARD_CONTENT:
        raise Cancelled()


def _remaining_seconds(
    request: dict[str, Any], maximum: int, *, reserve: float = 0.25
) -> int:
    deadline = request.get("_deadline_monotonic")
    if type(deadline) is not float:
        raise HelperError(
            "invalid-request", "operation deadline was not initialized", 64
        )
    remaining = deadline - time.monotonic() - reserve
    if remaining < 1.0:
        raise HelperError(
            "timeout", "MotionBGS operation exhausted its end-to-end deadline", 69
        )
    return max(1, min(maximum, int(remaining)))


def _ensure_live(request: dict[str, Any]) -> None:
    _require_guard(request["guard_path"])
    _remaining_seconds(request, MAX_OPERATION_TIMEOUT_MS // 1000)


def _open_lock(directory: str, request: dict[str, Any]) -> int:
    path = directory + "/" + LOCK_NAME
    flags = (
        os.O_RDWR
        | os.O_CREAT
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    descriptor = -1
    try:
        descriptor = os.open(path, flags, 0o600)
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise HelperError("invalid-path", "MotionBGS lock file is unsafe", 65)
        os.fchmod(descriptor, 0o600)
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                _ensure_live(request)
                time.sleep(0.05)
        return descriptor
    except HelperError:
        if descriptor >= 0:
            os.close(descriptor)
        raise
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        raise HelperError(
            "local-io",
            f"could not acquire the MotionBGS operation lock: {error.strerror}",
            74,
        ) from error


def _wait_for_network_slot(request: dict[str, Any]) -> None:
    _ensure_live(request)
    directory = request["cache_directory"]
    path = directory + "/" + RATE_NAME
    previous = 0.0
    if os.path.lexists(path):
        try:
            raw = _read_bounded_file(path, 64).decode("ascii").strip()
            previous = float(raw)
        except HelperError as error:
            if error.kind != "size-limit":
                raise
            # Recover from an oversized/truncated rate file only after proving
            # that it is our regular file. Never turn a symlink or foreign
            # path into a replace target merely because the bounded read
            # rejected it.
            try:
                info = os.lstat(path)
            except OSError as inspect_error:
                raise HelperError(
                    "local-io",
                    f"could not inspect request spacing: {inspect_error.strerror}",
                    74,
                ) from inspect_error
            if (
                not stat.S_ISREG(info.st_mode)
                or stat.S_ISLNK(info.st_mode)
                or info.st_uid != os.getuid()
            ):
                raise HelperError("invalid-path", "request-spacing path is unsafe", 65)
            try:
                os.unlink(path)
            except OSError as unlink_error:
                raise HelperError(
                    "local-io",
                    f"could not discard invalid request spacing: {unlink_error.strerror}",
                    74,
                ) from unlink_error
        except (UnicodeDecodeError, ValueError):
            previous = 0.0
    delay = NETWORK_DELAY_SECONDS - (time.time() - previous)
    if delay > 0:
        bounded_delay = min(delay, NETWORK_DELAY_SECONDS)
        remaining = request["_deadline_monotonic"] - time.monotonic()
        if remaining <= bounded_delay + 0.5:
            raise HelperError(
                "timeout", "request spacing would exceed the operation deadline", 69
            )
        time.sleep(bounded_delay)
    _ensure_live(request)
    payload = f"{time.time():.6f}\n".encode("ascii")
    temporary = _new_temporary(directory, ".wall-in-one-motionbgs-rate.")
    try:
        with open(temporary, "wb", buffering=0) as stream:
            stream.write(payload)
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        _forget_temporary(temporary)
    except OSError as error:
        raise HelperError(
            "local-io", f"could not persist request spacing: {error.strerror}", 74
        ) from error
    _ensure_live(request)


def _header_value(path: str, wanted: str) -> str:
    try:
        payload = _read_bounded_file(path, MAX_HEADER_BYTES, minimum=0)
    except HelperError as error:
        if error.kind == "size-limit":
            raise HelperError(
                "headers", "response headers exceeded 64 KiB", 65
            ) from error
        raise
    found = ""
    for raw_line in payload.splitlines():
        if b":" not in raw_line:
            continue
        raw_key, raw_value = raw_line.split(b":", 1)
        if raw_key.decode("ascii", "ignore").strip().lower() == wanted.lower():
            found = raw_value.decode("latin-1", "replace").strip()
    return found


def _curl_file_limit(maximum: int) -> Any:
    def set_limit() -> None:
        current_soft, current_hard = resource.getrlimit(resource.RLIMIT_FSIZE)
        hard = (
            maximum
            if current_hard == resource.RLIM_INFINITY
            else min(current_hard, maximum)
        )
        soft = min(maximum, hard)
        resource.setrlimit(resource.RLIMIT_FSIZE, (soft, hard))

    return set_limit


def _curl_once(
    url: str,
    directory: str,
    maximum: int,
    timeout_seconds: int,
    accept: str,
) -> dict[str, Any]:
    global _ACTIVE_CHILD
    requested = _normalize_provider_url(url)
    body = _new_temporary(directory, ".motionbgs-body.")
    headers = _new_temporary(directory, ".motionbgs-headers.")
    command = [
        "curl",
        "--disable",
        "--silent",
        "--show-error",
        "--request",
        "GET",
        "--connect-timeout",
        "10",
        "--max-time",
        str(timeout_seconds),
        "--max-filesize",
        str(maximum),
        "--speed-limit",
        "1024",
        "--speed-time",
        "15",
        "--proto",
        "=https",
        "--proto-redir",
        "=https",
        "--max-redirs",
        "0",
        "--tlsv1.2",
        "--header",
        "Accept-Language: en-US,en;q=0.8",
        "--header",
        f"Accept: {accept}",
        "--user-agent",
        USER_AGENT,
        "--dump-header",
        headers,
        "--output",
        body,
        "--write-out",
        "%{http_code}\t%{url_effective}\t%{content_type}\t%{size_download}",
        "--url",
        requested,
    ]
    environment = os.environ.copy()
    environment.pop("CURL_HOME", None)
    try:
        _ACTIVE_CHILD = subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=environment,
            preexec_fn=_curl_file_limit(max(maximum, MAX_HEADER_BYTES)),
        )
    except FileNotFoundError as error:
        _remove_temporary(body)
        _remove_temporary(headers)
        raise HelperError(
            "missing-curl", "curl is required by wall-in-one-motionbgs", 127
        ) from error
    try:
        stdout, stderr = _ACTIVE_CHILD.communicate(timeout=timeout_seconds + 5)
    except subprocess.TimeoutExpired as error:
        _ACTIVE_CHILD.kill()
        _ACTIVE_CHILD.communicate()
        raise HelperError(
            "timeout", f"request exceeded its {timeout_seconds}s deadline", 69
        ) from error
    finally:
        return_code = _ACTIVE_CHILD.returncode
        _ACTIVE_CHILD = None
    if return_code != 0:
        _remove_temporary(body)
        _remove_temporary(headers)
        detail = _clean_field(stderr.decode("utf-8", "replace"), 320)
        if return_code == 28:
            raise HelperError("timeout", detail or "curl request timed out", 69)
        if return_code in {63, 153}:
            raise HelperError("size-limit", "response exceeded its hard byte limit", 65)
        raise HelperError(
            "transport", detail or f"curl failed with code {return_code}", 69
        )
    try:
        fields = stdout.decode("ascii").split("\t")
    except UnicodeDecodeError as error:
        _remove_temporary(body)
        _remove_temporary(headers)
        raise HelperError(
            "protocol", "curl returned a non-ASCII transfer record", 70
        ) from error
    if len(fields) != 4 or re.fullmatch(r"[0-9]{3}", fields[0]) is None:
        _remove_temporary(body)
        _remove_temporary(headers)
        raise HelperError("protocol", "curl returned a malformed transfer record", 70)
    status_code = int(fields[0])
    effective = fields[1]
    content_type = fields[2].split(";", 1)[0].strip().lower()
    try:
        reported_bytes = int(float(fields[3]))
    except ValueError as error:
        _remove_temporary(body)
        _remove_temporary(headers)
        raise HelperError(
            "protocol", "curl returned an invalid byte count", 70
        ) from error
    if effective != requested:
        _remove_temporary(body)
        _remove_temporary(headers)
        raise HelperError(
            "redirects", "curl effective URL differed from the requested URL", 69
        )
    info = _lstat_regular(body, maximum=maximum, minimum=0)
    if info.st_size != reported_bytes:
        _remove_temporary(body)
        _remove_temporary(headers)
        raise HelperError(
            "size-mismatch", "curl byte count did not match the response file", 65
        )
    result = {
        "status": status_code,
        "effective_url": effective,
        "content_type": content_type,
        "bytes": info.st_size,
        "path": body,
        "headers": headers,
    }
    return result


def _fetch(
    request: dict[str, Any],
    start_url: str,
    directory: str,
    maximum: int,
    timeout_seconds: int,
    accept: str,
    purpose: str,
) -> dict[str, Any]:
    url = _normalize_provider_url(start_url)
    for redirect_count in range(MAX_REDIRECTS + 1):
        _ensure_live(request)
        _wait_for_network_slot(request)
        transfer = _curl_once(
            url,
            directory,
            maximum,
            _remaining_seconds(request, timeout_seconds),
            accept,
        )
        try:
            _ensure_live(request)
        except BaseException:
            _remove_temporary(transfer["path"])
            _remove_temporary(transfer["headers"])
            raise
        status_code = transfer["status"]
        if status_code in {301, 302, 303, 307, 308}:
            if redirect_count >= MAX_REDIRECTS:
                _remove_temporary(transfer["path"])
                _remove_temporary(transfer["headers"])
                raise HelperError(
                    "redirects", "MotionBGS returned too many redirects", 69
                )
            location = _header_value(transfer["headers"], "location")
            _remove_temporary(transfer["path"])
            _remove_temporary(transfer["headers"])
            if not location:
                raise HelperError(
                    "redirects", "redirect did not include a Location header", 69
                )
            url = _normalize_provider_url(location, base=url)
            _ensure_live(request)
            continue
        _remove_temporary(transfer["headers"])
        transfer.pop("headers", None)
        if status_code in {403, 429}:
            _remove_temporary(transfer["path"])
            raise HelperError(
                "challenge",
                f"MotionBGS refused the public request (HTTP {status_code}); no bypass was attempted",
                77,
            )
        if status_code < 200 or status_code >= 300:
            _remove_temporary(transfer["path"])
            raise HelperError(
                "http", f"MotionBGS returned HTTP {status_code} for {purpose}", 69
            )
        transfer["effective_url"] = url
        return transfer
    raise HelperError("redirects", "redirect processing did not terminate", 69)


def _validate_html_transfer(transfer: dict[str, Any]) -> bytes:
    if transfer["content_type"] not in {"text/html", "application/xhtml+xml"}:
        _remove_temporary(transfer["path"])
        raise HelperError(
            "content-type",
            f"expected HTML but received {transfer['content_type'] or 'unknown'}",
            65,
        )
    payload = _read_bounded_file(transfer["path"], MAX_HTML_BYTES)
    signature = payload[:4096].lstrip(b"\xef\xbb\xbf\x00\t\r\n ").lower()
    if not (
        signature.startswith(b"<!doctype html")
        or signature.startswith(b"<html")
        or signature.startswith(b"<?xml")
    ):
        _remove_temporary(transfer["path"])
        raise HelperError(
            "content-type", "HTML MIME type did not match the response signature", 65
        )
    if b"\x00" in payload:
        _remove_temporary(transfer["path"])
        raise HelperError("content-type", "HTML response contains NUL bytes", 65)
    _remove_temporary(transfer["path"])
    return payload


def _decode_html(payload: bytes) -> str:
    return payload.decode("utf-8", "replace")


class _BoundedParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.tags_seen = 0

    def _attributes(self, attributes: list[tuple[str, str | None]]) -> dict[str, str]:
        self.tags_seen += 1
        if self.tags_seen > MAX_HTML_TAGS:
            raise HelperError(
                "site-markup", "MotionBGS page exceeded the bounded tag limit", 65
            )
        if len(attributes) > MAX_ATTRIBUTES_PER_TAG:
            raise HelperError(
                "site-markup", "MotionBGS tag exceeded the bounded attribute limit", 65
            )
        normalized: dict[str, str] = {}
        for key, value in attributes:
            lower = key.lower()
            text = value or ""
            if len(text.encode("utf-8", "replace")) > MAX_ATTRIBUTE_BYTES:
                continue
            if lower not in normalized:
                normalized[lower] = text
        return normalized


class _ListingParser(_BoundedParser):
    def __init__(self) -> None:
        super().__init__()
        self.anchor: dict[str, Any] | None = None
        self.anchor_depth = 0
        self.span_class = ""
        self.title_depth = 0
        self.title_parts: list[str] = []
        self.links: list[dict[str, str]] = []
        self.cards: list[dict[str, Any]] = []

    def handle_starttag(
        self, tag: str, attributes: list[tuple[str, str | None]]
    ) -> None:
        attrs = self._attributes(attributes)
        tag = tag.lower()
        if tag == "title":
            self.title_depth += 1
        if tag == "link" and len(self.links) < 64:
            self.links.append(attrs)
        if tag == "a":
            if self.anchor is None:
                self.anchor = {
                    "attrs": attrs,
                    "ttl": [],
                    "frm": [],
                    "text": [],
                    "image": "",
                }
                self.anchor_depth = 1
            else:
                self.anchor_depth += 1
            return
        if self.anchor is None:
            return
        if tag == "span":
            classes = set(attrs.get("class", "").split())
            if "ttl" in classes:
                self.span_class = "ttl"
            elif "frm" in classes:
                self.span_class = "frm"
        elif tag == "img" and not self.anchor["image"]:
            for key in ("data-src", "data-lazy-src", "data-original", "src"):
                candidate = _still_url(attrs.get(key, ""))
                if candidate:
                    self.anchor["image"] = candidate
                    break
        elif tag == "source" and not self.anchor["image"]:
            for key in ("data-srcset", "srcset", "data-src", "src"):
                value = attrs.get(key, "")
                for candidate_text in value.split(","):
                    candidate = _still_url(candidate_text.strip().split(" ", 1)[0])
                    if candidate:
                        self.anchor["image"] = candidate
                        break
                if self.anchor["image"]:
                    break

    def handle_endtag(self, tag: str) -> None:
        tag = tag.lower()
        if tag == "title" and self.title_depth:
            self.title_depth -= 1
        if self.anchor is None:
            return
        if tag == "span":
            self.span_class = ""
        elif tag == "a":
            self.anchor_depth -= 1
            if self.anchor_depth <= 0:
                self.cards.append(self.anchor)
                self.anchor = None
                self.anchor_depth = 0
                self.span_class = ""

    def handle_data(self, data: str) -> None:
        if self.title_depth:
            self.title_parts.append(data)
        if self.anchor is None:
            return
        self.anchor["text"].append(data)
        if self.span_class:
            self.anchor[self.span_class].append(data)


class _DetailParser(_BoundedParser):
    def __init__(self) -> None:
        super().__init__()
        self.metas: dict[str, str] = {}
        self.sources: list[dict[str, str]] = []
        self.anchors: list[dict[str, Any]] = []
        self.anchor: dict[str, Any] | None = None
        self.anchor_depth = 0
        self.title_depth = 0
        self.title_parts: list[str] = []

    def handle_starttag(
        self, tag: str, attributes: list[tuple[str, str | None]]
    ) -> None:
        attrs = self._attributes(attributes)
        tag = tag.lower()
        if tag == "title":
            self.title_depth += 1
        elif tag == "meta":
            key = (attrs.get("property") or attrs.get("name") or "").lower()
            if key and key not in self.metas:
                self.metas[key] = attrs.get("content", "")
        elif tag == "source" and len(self.sources) < 64:
            self.sources.append(attrs)
        elif tag == "a":
            if self.anchor is None:
                self.anchor = {"attrs": attrs, "text": []}
                self.anchor_depth = 1
            else:
                self.anchor_depth += 1

    def handle_endtag(self, tag: str) -> None:
        tag = tag.lower()
        if tag == "title" and self.title_depth:
            self.title_depth -= 1
        if self.anchor is not None and tag == "a":
            self.anchor_depth -= 1
            if self.anchor_depth <= 0:
                self.anchors.append(self.anchor)
                self.anchor = None
                self.anchor_depth = 0

    def handle_data(self, data: str) -> None:
        if self.title_depth:
            self.title_parts.append(data)
        if self.anchor is not None:
            self.anchor["text"].append(data)


def _challenge_page(markup: str) -> bool:
    prefix = markup[:16_384].lower()
    return any(
        marker in prefix
        for marker in (
            "<title>just a moment",
            "challenge-error-text",
            "checking your browser",
        )
    )


def _parse_listing(
    markup: str, request: dict[str, Any], source_url: str
) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    if _challenge_page(markup):
        raise HelperError(
            "challenge",
            "MotionBGS returned an anti-bot challenge; no bypass was attempted",
            77,
        )
    parser = _ListingParser()
    try:
        parser.feed(markup)
        parser.close()
    except HelperError:
        raise
    except Exception as error:
        raise HelperError(
            "site-markup", f"could not parse bounded MotionBGS listing: {error}", 65
        ) from error
    items: list[dict[str, Any]] = []
    seen: set[str] = set()
    for card in parser.cards:
        attrs = card["attrs"]
        href = attrs.get("href", "")
        title_attr = attrs.get("title", "")
        title = _bounded_text(" ".join(card["ttl"]), 240)
        if not title and "live wallpaper" not in title_attr.lower():
            continue
        try:
            normalized_href = _normalize_provider_url(href)
        except HelperError:
            continue
        path = urlsplit(normalized_href).path
        match = re.fullmatch(r"/([a-z0-9][a-z0-9-]{0,119})/?", path)
        if match is None or match.group(1) in seen:
            continue
        slug = match.group(1)
        if not title:
            title = _bounded_text(
                re.sub(r"live\s+wallpaper", "", title_attr, flags=re.IGNORECASE), 240
            )
        quality = _bounded_text(" ".join(card["frm"]), 20).upper()
        if not quality:
            quality_match = re.search(r"\b(4K|HD)\b", title_attr, flags=re.IGNORECASE)
            quality = quality_match.group(1).upper() if quality_match else ""
        thumbnail = card["image"]
        identifier_match = re.search(r"/media/([0-9]{1,12})/", thumbnail)
        items.append(
            {
                "slug": slug,
                "id": identifier_match.group(1) if identifier_match else "",
                "title": title or slug,
                "quality": quality,
                "source_url": f"{ORIGIN}/{slug}",
                "thumbnail_url": thumbnail,
                "provider": "MotionBGS",
            }
        )
        seen.add(slug)
        if len(items) >= request["limit"]:
            break
    if not items:
        prefix = markup[:16_384].lower()
        if not any(
            marker in prefix
            for marker in ("no wallpapers", "nothing found", "no results")
        ):
            raise HelperError(
                "site-markup",
                "MotionBGS returned no recognizable wallpaper cards; its public markup may have changed",
                65,
            )

    mode, query, genre, page = (
        request[key] for key in ("mode", "query", "genre", "page")
    )
    if not _listing_route_matches(mode, query, genre, page, source_url):
        raise HelperError(
            "redirects", "MotionBGS redirected into a different catalog route", 69
        )
    pageable = mode in {"latest", "genre", "4k"}
    has_previous = False
    has_next = False
    if pageable:
        for attrs in parser.links[:32]:
            relations = {token.lower() for token in attrs.get("rel", "").split()}
            href = attrs.get("href", "")
            try:
                candidate = _normalize_provider_url(href)
            except HelperError:
                continue
            if (
                "prev" in relations
                and page > 1
                and _listing_route_matches(mode, query, genre, page - 1, candidate)
            ):
                has_previous = True
            if (
                "next" in relations
                and page < MAX_PAGE
                and _listing_route_matches(mode, query, genre, page + 1, candidate)
            ):
                has_next = True
    title = _bounded_text(" ".join(parser.title_parts), 300)
    total_match = re.match(r"^([0-9,]+)\+", title)
    total_hint = (
        min(int(total_match.group(1).replace(",", "")), 9_007_199_254_740_991)
        if total_match
        else 0
    )
    meta = {
        "current_page": page,
        "has_previous": has_previous,
        "has_next": has_next,
        "pageable": pageable,
        "total_hint": total_hint,
        "count": len(items),
    }
    return items, meta


def _parse_details(markup: str, slug: str) -> dict[str, Any]:
    if _challenge_page(markup):
        raise HelperError(
            "challenge",
            "MotionBGS returned an anti-bot challenge; no bypass was attempted",
            77,
        )
    parser = _DetailParser()
    try:
        parser.feed(markup)
        parser.close()
    except HelperError:
        raise
    except Exception as error:
        raise HelperError(
            "site-markup", f"could not parse bounded MotionBGS details: {error}", 65
        ) from error
    title = _bounded_text(
        parser.metas.get("og:title") or " ".join(parser.title_parts), 240
    )
    title = re.sub(r"\s+live\s+wallpaper\s*$", "", title, flags=re.IGNORECASE)
    poster = _still_url(parser.metas.get("og:image", ""))
    preview = _video_url(parser.metas.get("og:video", ""))
    if not preview:
        for attrs in parser.sources:
            media_type = attrs.get("type", "").split(";", 1)[0].lower()
            candidate = _video_url(attrs.get("src", ""))
            if candidate and (media_type in {"", "video/mp4"}):
                preview = candidate
                break
    downloads: dict[str, Any] = {}
    wallpaper_id = ""
    for anchor in parser.anchors:
        href = anchor["attrs"].get("href", "")
        try:
            normalized = _normalize_provider_url(href)
        except HelperError:
            continue
        match = DOWNLOAD_PATH_RE.fullmatch(urlsplit(normalized).path)
        if match is None:
            continue
        quality, identifier = match.groups()
        body = _bounded_text(" ".join(anchor["text"]), 240)
        resolution = ""
        resolution_match = re.search(r"([0-9]{2,5})\s*[xX]\s*([0-9]{2,5})", body)
        if resolution_match:
            resolution = f"{resolution_match.group(1)}x{resolution_match.group(2)}"
        size_match = re.search(
            r"\(([0-9]+(?:\.[0-9]+)?)\s*MB\)", body, flags=re.IGNORECASE
        )
        downloads[quality] = {
            "id": identifier,
            "quality": quality,
            "label": quality.upper(),
            "resolution": resolution,
            "advertised_size_mb": float(size_match.group(1)) if size_match else 0,
            "url": f"{ORIGIN}/dl/{quality}/{identifier}/",
        }
        wallpaper_id = wallpaper_id or identifier
    if not downloads or not wallpaper_id:
        raise HelperError(
            "site-markup",
            "MotionBGS did not expose recognizable HD/4K download links; its public markup may have changed",
            65,
        )
    duration_match = re.search(r'"duration"\s*:\s*"(PT[^"\\]{1,40})"', markup)
    return {
        "slug": slug,
        "id": wallpaper_id,
        "title": title or slug,
        "source_url": f"{ORIGIN}/{slug}",
        "preview_url": preview,
        "poster_url": poster,
        "duration": duration_match.group(1) if duration_match else "",
        "downloads": downloads,
        "fetched_at": int(time.time()),
        "provider": "MotionBGS",
    }


def _valid_item(item: Any) -> bool:
    if not isinstance(item, dict):
        return False
    try:
        slug = _slug(item.get("slug"))
    except HelperError:
        return False
    if (
        item.get("provider") != "MotionBGS"
        or item.get("source_url") != f"{ORIGIN}/{slug}"
    ):
        return False
    if (
        not isinstance(item.get("title"), str)
        or len(item["title"].encode("utf-8")) > 240
    ):
        return False
    identifier = item.get("id", "")
    quality = item.get("quality", "")
    if not isinstance(identifier, str) or (
        identifier and WALLPAPER_ID_RE.fullmatch(identifier) is None
    ):
        return False
    if not isinstance(quality, str) or len(quality.encode("utf-8")) > 20:
        return False
    thumbnail = item.get("thumbnail_url", "")
    return thumbnail == "" or _still_url(thumbnail) == thumbnail


def _valid_detail(detail: Any, expected_slug: str) -> bool:
    if not isinstance(detail, dict) or detail.get("slug") != expected_slug:
        return False
    if (
        detail.get("provider") != "MotionBGS"
        or detail.get("source_url") != f"{ORIGIN}/{expected_slug}"
    ):
        return False
    if not WALLPAPER_ID_RE.fullmatch(str(detail.get("id", ""))):
        return False
    if (
        not isinstance(detail.get("title"), str)
        or len(detail["title"].encode("utf-8")) > 240
    ):
        return False
    poster = detail.get("poster_url", "")
    preview = detail.get("preview_url", "")
    if (poster and _still_url(poster) != poster) or (
        preview and _video_url(preview) != preview
    ):
        return False
    downloads = detail.get("downloads")
    if not isinstance(downloads, dict) or not downloads:
        return False
    valid = False
    for quality, value in downloads.items():
        if quality not in {"hd", "4k"} or not isinstance(value, dict):
            return False
        identifier = str(value.get("id", ""))
        if not WALLPAPER_ID_RE.fullmatch(identifier) or value.get("quality") != quality:
            return False
        if value.get("url") != f"{ORIGIN}/dl/{quality}/{identifier}/":
            return False
        valid = True
    return valid and type(detail.get("fetched_at")) in (int, float)


def _cached_search(
    cache: dict[str, Any], request: dict[str, Any]
) -> dict[str, Any] | None:
    key = _cache_key(request)
    record = cache["searches"].get(key)
    if not isinstance(record, dict) or not _fresh(
        record.get("fetched_at"), request["cache_ttl_seconds"]
    ):
        return None
    for field in ("mode", "query", "genre", "page", "limit"):
        if record.get(field) != request[field]:
            return None
    items = record.get("items")
    meta = record.get("meta")
    source_url = record.get("source_url")
    unique_slugs = (
        {
            item.get("slug")
            for item in items
            if isinstance(item, dict) and isinstance(item.get("slug"), str)
        }
        if isinstance(items, list)
        else set()
    )
    if (
        not isinstance(items, list)
        or len(items) > request["limit"]
        or not all(_valid_item(item) for item in items)
        or len(unique_slugs) != len(items)
        or not isinstance(meta, dict)
        or not isinstance(source_url, str)
        or not _listing_route_matches(
            request["mode"],
            request["query"],
            request["genre"],
            request["page"],
            source_url,
        )
    ):
        return None
    if (
        meta.get("current_page") != request["page"]
        or type(meta.get("has_previous")) is not bool
        or type(meta.get("has_next")) is not bool
        or type(meta.get("pageable")) is not bool
        or type(meta.get("total_hint")) is not int
        or meta["total_hint"] < 0
        or meta.get("count") != len(items)
    ):
        return None
    return record


def _cached_detail(
    cache: dict[str, Any], request: dict[str, Any]
) -> dict[str, Any] | None:
    detail = cache["details"].get(request["slug"])
    if not _valid_detail(detail, request["slug"]):
        return None
    return (
        detail
        if _fresh(detail.get("fetched_at"), request["cache_ttl_seconds"])
        else None
    )


def _search(request: dict[str, Any], cache: dict[str, Any]) -> dict[str, Any]:
    cached = None if request["force"] else _cached_search(cache, request)
    if cached is not None:
        record = cached
        was_cached = True
    else:
        requested_url = _browse_url(
            request["mode"], request["query"], request["genre"], request["page"]
        )
        transfer = _fetch(
            request,
            requested_url,
            request["cache_directory"],
            MAX_HTML_BYTES,
            HTML_TIMEOUT_SECONDS,
            "text/html,application/xhtml+xml;q=0.9",
            "listing",
        )
        payload = _validate_html_transfer(transfer)
        _ensure_live(request)
        source_url = transfer["effective_url"]
        items, meta = _parse_listing(_decode_html(payload), request, source_url)
        _ensure_live(request)
        record = {
            "mode": request["mode"],
            "query": request["query"],
            "genre": request["genre"],
            "page": request["page"],
            "limit": request["limit"],
            "source_url": source_url,
            "fetched_at": int(time.time()),
            "items": items,
            "meta": meta,
        }
        key = _cache_key(request)
        cache["searches"][key] = record
        _touch_order(cache, "searches", key, MAX_SEARCH_CACHE)
        _save_cache(request["cache_directory"], cache)
        _ensure_live(request)
        was_cached = False
    return {
        "schema": 1,
        "ok": True,
        "action": "search",
        "request_id": request["request_id"],
        "cached": was_cached,
        "source_url": record["source_url"],
        "fetched_at": record["fetched_at"],
        "mode": record["mode"],
        "query": record["query"],
        "genre": record["genre"],
        "page": record["page"],
        "items": record["items"],
        "meta": record["meta"],
    }


def _fetch_detail(
    request: dict[str, Any], cache: dict[str, Any]
) -> tuple[dict[str, Any], bool]:
    detail = None if request["force"] else _cached_detail(cache, request)
    if detail is not None:
        return detail, True
    source_url = f"{ORIGIN}/{request['slug']}"
    transfer = _fetch(
        request,
        source_url,
        request["cache_directory"],
        MAX_HTML_BYTES,
        HTML_TIMEOUT_SECONDS,
        "text/html,application/xhtml+xml;q=0.9",
        "details",
    )
    if _site_path(transfer["effective_url"]) != _site_path(source_url):
        _remove_temporary(transfer["path"])
        raise HelperError("redirects", "detail request redirected to another page", 69)
    detail = _parse_details(
        _decode_html(_validate_html_transfer(transfer)), request["slug"]
    )
    _ensure_live(request)
    cache["details"][request["slug"]] = detail
    _touch_order(cache, "details", request["slug"], MAX_DETAIL_CACHE)
    _save_cache(request["cache_directory"], cache)
    _ensure_live(request)
    return detail, False


def _details(request: dict[str, Any], cache: dict[str, Any]) -> dict[str, Any]:
    detail, cached = _fetch_detail(request, cache)
    return {
        "schema": 1,
        "ok": True,
        "action": "details",
        "request_id": request["request_id"],
        "cached": cached,
        "source_url": detail["source_url"],
        "fetched_at": detail["fetched_at"],
        "selected": detail,
    }


def _sha256(path: str, request: dict[str, Any]) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as stream:
        while True:
            chunk = stream.read(1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            _ensure_live(request)
    return digest.hexdigest()


def _validate_mp4(
    path: str,
    content_type: str,
    maximum: int,
    request: dict[str, Any],
) -> tuple[int, str]:
    if content_type not in {"video/mp4", "application/octet-stream"}:
        raise HelperError(
            "content-type", f"expected MP4 but received {content_type or 'unknown'}", 65
        )
    info = _lstat_regular(path, maximum=maximum)
    with open(path, "rb") as stream:
        prefix = stream.read(64)
    if len(prefix) < 12 or prefix[4:8] != b"ftyp":
        raise HelperError(
            "content-type",
            "download MIME type did not match an ISO-BMFF ftyp signature",
            65,
        )
    box_size = int.from_bytes(prefix[:4], "big")
    if box_size != 0 and (box_size < 12 or box_size > info.st_size):
        raise HelperError(
            "content-type", "MP4 ftyp box has an invalid declared size", 65
        )
    return info.st_size, _sha256(path, request)


def _validate_download_route(value: str, quality: str, identifier: str) -> str:
    """Bind a successful transfer to the detail record that authorized it."""
    normalized = _normalize_provider_url(value)
    parsed = urlsplit(normalized)
    if parsed.query:
        raise HelperError(
            "redirects", "download resolved to a URL with unexpected query data", 69
        )
    download_match = DOWNLOAD_PATH_RE.fullmatch(parsed.path)
    if download_match is not None:
        if download_match.groups() == (quality, identifier):
            return normalized
        raise HelperError(
            "redirects", "download resolved to a different MotionBGS media id", 69
        )
    video_match = VIDEO_PATH_RE.fullmatch(parsed.path)
    if video_match is not None and video_match.group(1) == identifier:
        return normalized
    raise HelperError(
        "redirects",
        "download resolved outside the authorized MotionBGS media route",
        69,
    )


def _download_destination(directory: str, slug: str, quality: str) -> str:
    stem = f"{slug}.{quality}"
    for suffix in range(0, 10_000):
        name = f"{stem}.mp4" if suffix == 0 else f"{stem}-{suffix}.mp4"
        candidate = f"{directory}/{name}"
        if not os.path.lexists(candidate) and not os.path.lexists(
            candidate + ".motionbgs.json"
        ):
            return candidate
    raise HelperError(
        "conflict", "could not allocate a unique MotionBGS download name", 73
    )


def _install_download(
    transfer_path: str,
    destination: str,
    sidecar_payload: bytes,
) -> tuple[str, str]:
    directory = os.path.dirname(destination)
    sidecar_destination = destination + ".motionbgs.json"
    sidecar_temp = _new_temporary(directory, ".motionbgs-metadata.")
    installed_media = False
    installed_sidecar = False
    try:
        descriptor = os.open(
            sidecar_temp,
            os.O_WRONLY
            | os.O_TRUNC
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
        try:
            _write_all(descriptor, sidecar_payload)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.link(transfer_path, destination, follow_symlinks=False)
        installed_media = True
        os.link(sidecar_temp, sidecar_destination, follow_symlinks=False)
        installed_sidecar = True
        os.unlink(transfer_path)
        os.unlink(sidecar_temp)
        _forget_temporary(transfer_path)
        _forget_temporary(sidecar_temp)
        return destination, sidecar_destination
    except BaseException as error:
        if installed_sidecar:
            try:
                os.unlink(sidecar_destination)
            except OSError:
                pass
        if installed_media:
            try:
                os.unlink(destination)
            except OSError:
                pass
        if isinstance(error, FileExistsError):
            raise HelperError(
                "conflict",
                "download destination appeared before no-replace installation",
                73,
            ) from error
        if isinstance(error, HelperError):
            raise
        if isinstance(error, OSError):
            raise HelperError(
                "local-io",
                f"could not install download and sidecar: {error.strerror}",
                74,
            ) from error
        raise


def _download(
    request: dict[str, Any], cache: dict[str, Any]
) -> tuple[dict[str, Any], tuple[str, str]]:
    detail, cached = _fetch_detail(request, cache)
    choice = detail["downloads"].get(request["quality"])
    if not isinstance(choice, dict) or not WALLPAPER_ID_RE.fullmatch(
        str(choice.get("id", ""))
    ):
        raise HelperError("quality", "selected MotionBGS quality is not available", 65)
    identifier = str(choice["id"])
    endpoint = f"{ORIGIN}/dl/{request['quality']}/{identifier}/"
    transfer = _fetch(
        request,
        endpoint,
        request["download_directory"],
        request["max_download_bytes"],
        request["download_timeout_seconds"],
        "video/mp4,application/octet-stream;q=0.8",
        "download",
    )
    try:
        transfer["effective_url"] = _validate_download_route(
            transfer["effective_url"], request["quality"], identifier
        )
        size, digest = _validate_mp4(
            transfer["path"],
            transfer["content_type"],
            request["max_download_bytes"],
            request,
        )
        if size != transfer["bytes"]:
            raise HelperError(
                "size-mismatch",
                "validated MP4 size did not match the transfer record",
                65,
            )
        destination = _download_destination(
            request["download_directory"], request["slug"], request["quality"]
        )
        downloaded_at = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        sidecar = {
            "schema": 1,
            "plugin": "goober/wall-in-one",
            "provider": "MotionBGS",
            "path": destination,
            "title": detail["title"],
            "source_page": detail["source_url"],
            "download_url": transfer["effective_url"],
            "quality": request["quality"],
            "content_type": transfer["content_type"],
            "bytes": size,
            "sha256": digest,
            "downloaded_at": downloaded_at,
        }
        sidecar_payload = _encode_json(sidecar, MAX_SIDECAR_BYTES)
        # The guard is the caller's revocable authority to install. Check it at
        # the last safe point before the first no-replace link is created.
        _ensure_live(request)
        installed_path, installed_sidecar = _install_download(
            transfer["path"], destination, sidecar_payload
        )
        try:
            _ensure_live(request)
        except BaseException:
            for installed_path_part in (installed_sidecar, installed_path):
                try:
                    os.unlink(installed_path_part)
                except OSError:
                    pass
            raise
    except BaseException:
        _remove_temporary(transfer["path"])
        raise
    response = {
        "schema": 1,
        "ok": True,
        "action": "download",
        "request_id": request["request_id"],
        "cached": cached,
        "source_url": detail["source_url"],
        "fetched_at": detail["fetched_at"],
        "selected": detail,
        "download": {
            "path": installed_path,
            "sidecar": installed_sidecar,
            "slug": request["slug"],
            "title": detail["title"],
            "quality": request["quality"],
            "bytes": size,
            "source_url": detail["source_url"],
            "download_url": transfer["effective_url"],
            "content_type": transfer["content_type"],
            "sha256": digest,
            "downloaded_at": downloaded_at,
        },
    }
    return response, (installed_path, installed_sidecar)


def _clear(request: dict[str, Any]) -> dict[str, Any]:
    _ensure_live(request)
    _save_cache(request["cache_directory"], _empty_cache())
    _ensure_live(request)
    return {
        "schema": 1,
        "ok": True,
        "action": "clear",
        "request_id": request["request_id"],
        "cleared": True,
    }


def _error_response(request: dict[str, Any], error: HelperError) -> dict[str, Any]:
    return {
        "schema": 1,
        "ok": False,
        "action": request["action"],
        "request_id": request["request_id"],
        "error": {"kind": error.kind, "message": error.message},
    }


def _motionbgs_rpc(request_path: str, response_path: str, guard_path: str) -> int:
    request = _load_request(request_path)
    response = _safe_absolute_path(response_path)
    _existing_directory(os.path.dirname(response))
    if not _is_within(response, request["cache_directory"]):
        raise HelperError(
            "invalid-path", "response must be inside the request cache directory", 64
        )
    guard = _safe_absolute_path(guard_path)
    if guard != request["guard_path"]:
        raise HelperError(
            "invalid-path", "command guard does not match the request envelope", 64
        )
    _require_guard(guard)
    if os.path.lexists(response):
        raise HelperError("conflict", "response path already exists", 73)
    installed: tuple[str, str] | None = None
    lock = _open_lock(request["cache_directory"], request)
    try:
        try:
            _ensure_live(request)
            try:
                if request["action"] == "clear":
                    result = _clear(request)
                else:
                    cache = _load_cache(request["cache_directory"])
                    if request["action"] == "search":
                        result = _search(request, cache)
                    elif request["action"] == "details":
                        result = _details(request, cache)
                    else:
                        result, installed = _download(request, cache)
            except Cancelled:
                raise
            except HelperError as error:
                result = _error_response(request, error)
            _ensure_live(request)
            payload = _encode_json(result, MAX_RESPONSE_BYTES)
            size = _write_no_replace(response, payload, MAX_RESPONSE_BYTES)
            try:
                _ensure_live(request)
            except BaseException:
                try:
                    os.unlink(response)
                except OSError:
                    pass
                raise
        except BaseException:
            try:
                os.unlink(response)
            except OSError:
                pass
            if installed is not None:
                for path in installed:
                    try:
                        os.unlink(path)
                    except OSError:
                        pass
            raise
    finally:
        try:
            fcntl.flock(lock, fcntl.LOCK_UN)
        finally:
            os.close(lock)
    _emit_fields(RPC_WIRE, "ok", request["request_id"], response, size)
    return 0


def _backend_bounded_text(value: Any, maximum: int = 320) -> str:
    text = "".join(
        " " if ord(character) < 32 or ord(character) == 127 else character
        for character in str(value if value is not None else "")
    )
    text = " ".join(text.split())
    encoded = text.encode("utf-8")
    if len(encoded) <= maximum:
        return text
    return encoded[:maximum].decode("utf-8", errors="ignore")


def _backend_readable_directory(value: Any) -> str:
    normalized = _safe_absolute_path(value).rstrip("/")
    try:
        info = os.lstat(normalized)
    except OSError:
        return ""
    if (
        not stat.S_ISDIR(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or not os.access(normalized, os.R_OK | os.X_OK)
    ):
        return ""
    return normalized


def _backend_optional_root(value: Any, label: str) -> str:
    if value == "":
        return ""
    if not isinstance(value, str):
        raise HelperError("invalid-request", f"{label} must be an absolute path or empty", 64)
    return _backend_readable_directory(value)


def _backend_direct_child(path: str, directory: str) -> bool:
    return bool(directory) and os.path.dirname(path) == directory and os.path.basename(path) != ""


def _backend_read_regular(path: str, maximum: int) -> tuple[bytes, os.stat_result]:
    normalized = _safe_absolute_path(path)
    try:
        before = os.lstat(normalized)
    except OSError as error:
        raise HelperError("local-io", f"could not inspect bounded file: {error.strerror}", 74) from error
    if (
        not stat.S_ISREG(before.st_mode)
        or stat.S_ISLNK(before.st_mode)
        or before.st_size < 1
        or before.st_size > maximum
    ):
        raise HelperError("invalid-path", "bounded file is not a safe regular file", 64)
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(normalized, flags)
        try:
            opened = os.fstat(descriptor)
            if (
                not stat.S_ISREG(opened.st_mode)
                or opened.st_dev != before.st_dev
                or opened.st_ino != before.st_ino
                or opened.st_size != before.st_size
            ):
                raise HelperError("invalid-path", "bounded file changed before it was read", 64)
            chunks: list[bytes] = []
            remaining = maximum + 1
            while remaining > 0:
                chunk = os.read(descriptor, min(64 * 1024, remaining))
                if not chunk:
                    break
                chunks.append(chunk)
                remaining -= len(chunk)
        finally:
            os.close(descriptor)
    except HelperError:
        raise
    except OSError as error:
        raise HelperError("local-io", f"could not read bounded file: {error.strerror}", 74) from error
    payload = b"".join(chunks)
    if len(payload) != before.st_size or len(payload) > maximum:
        raise HelperError("size-limit", "bounded file changed while it was read", 65)
    return payload, before


def _backend_json_file(path: str, maximum: int) -> Any:
    payload, _info = _backend_read_regular(path, maximum)
    try:
        return json.loads(payload.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise HelperError("invalid-json", f"bounded file is not UTF-8 JSON: {error}", 65) from error


def _backend_number(value: Any) -> int | None:
    if type(value) not in (int, float):
        return None
    integer = int(value)
    return integer if float(value) == float(integer) and integer >= 0 else None


def _backend_load_pair_registry(runtime_path: str) -> dict[str, dict[str, Any]]:
    try:
        raw = _read_bounded_file(runtime_path, BACKEND_MAX_RUNTIME_BYTES)
        candidate = json.loads(raw.decode("utf-8"))
    except (HelperError, UnicodeDecodeError, json.JSONDecodeError):
        return {}
    if not isinstance(candidate, dict) or candidate.get("schema_version") != 6:
        return {}
    raw_registry = candidate.get("pair_registry")
    if not isinstance(raw_registry, dict) or len(raw_registry) > BACKEND_MAX_PAIR_REGISTRY_ENTRIES:
        return {}
    result: dict[str, dict[str, Any]] = {}
    for key, record in raw_registry.items():
        if (
            not isinstance(key, str)
            or not key
            or len(key.encode("utf-8")) > 4096
            or any(ord(character) < 32 or ord(character) == 127 for character in key)
            or not isinstance(record, dict)
            or record.get("dynamic_id") != key
        ):
            return {}
        still_path = record.get("still_path")
        try:
            still_path = _safe_absolute_path(still_path)
        except HelperError:
            return {}
        fingerprints = {
            name: _backend_number(record.get(name))
            for name in ("still_size", "still_mtime", "source_size", "source_mtime")
        }
        if any(value is None for value in fingerprints.values()):
            return {}
        result[key] = {"still_path": still_path, **fingerprints}
    return result


def _backend_regular_info(path: str) -> os.stat_result | None:
    try:
        info = os.lstat(path)
    except OSError:
        return None
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_size <= 0:
        return None
    return info


def _backend_cached_pair(
    registry: dict[str, dict[str, Any]], dynamic_id: str, source: os.stat_result
) -> str:
    record = registry.get(dynamic_id)
    if not isinstance(record, dict):
        return ""
    still_path = str(record.get("still_path", ""))
    still = _backend_regular_info(still_path)
    if still is None:
        return ""
    if (
        record.get("still_size") != still.st_size
        or record.get("still_mtime") != int(still.st_mtime)
        or record.get("source_size") != source.st_size
        or record.get("source_mtime") != int(source.st_mtime)
    ):
        return ""
    return still_path


def _backend_library_token(path: str) -> str:
    encoded = path.encode("utf-8")
    hash_a = 0
    hash_b = 0
    for index, byte in enumerate(encoded, start=1):
        hash_a = (hash_a * 131 + byte) % 2_147_483_647
        hash_b = (hash_b * 65_599 + byte + index) % 2_147_483_629
    return f"{hash_a:08x}{hash_b:08x}{len(encoded):08x}"


def _backend_safe_relative(value: Any) -> str:
    if not isinstance(value, str) or not value or value.startswith("/"):
        return ""
    if "\\" in value or any(ord(character) < 32 or ord(character) == 127 for character in value):
        return ""
    components = value.split("/")
    if any(component in {"", ".", ".."} for component in components):
        return ""
    return value if len(value.encode("utf-8")) <= 4096 else ""


def _backend_sidecar(path: str, suffix: str, provider: str) -> tuple[dict[str, Any] | None, str]:
    sidecar_path = path + suffix
    try:
        record = _backend_json_file(sidecar_path, BACKEND_MAX_SIDECAR_BYTES)
    except HelperError:
        return None, sidecar_path
    if (
        not isinstance(record, dict)
        or record.get("schema") != 1
        or record.get("plugin") != "goober/wall-in-one"
        or record.get("provider") != provider
        or record.get("path") != path
    ):
        return None, sidecar_path
    return record, sidecar_path


def _backend_automatic_sidecar(path: str) -> tuple[dict[str, Any] | None, str]:
    sidecar_path = path + BACKEND_MANAGED_STILL_SUFFIX
    try:
        record = _backend_json_file(sidecar_path, BACKEND_MAX_SIDECAR_BYTES)
    except HelperError:
        return None, sidecar_path
    dynamic_id = record.get("dynamic_id") if isinstance(record, dict) else None
    if (
        not isinstance(record, dict)
        or record.get("schema") != 1
        or record.get("plugin") != "goober/wall-in-one"
        or record.get("kind") != "automatic-still"
        or record.get("path") != path
        or not isinstance(dynamic_id, str)
        or not dynamic_id
        or len(dynamic_id.encode("utf-8")) > 4096
    ):
        return None, sidecar_path
    return record, sidecar_path


class _ReverseLexName:
    """Reverse lexical ordering so heap[0] is the largest retained name."""

    __slots__ = ("value",)

    def __init__(self, value: str) -> None:
        self.value = value

    def __lt__(self, other: "_ReverseLexName") -> bool:
        return self.value > other.value


def _backend_directory_names(directory: str, ensure_live: Any | None = None) -> list[str]:
    if not directory:
        return []
    selected: list[_ReverseLexName] = []
    examined = 0
    try:
        with os.scandir(directory) as entries:
            for entry in entries:
                examined += 1
                if examined % 32 == 0 and ensure_live is not None:
                    ensure_live()
                name = entry.name
                if (
                    not name
                    or "/" in name
                    or "\\" in name
                    or any(ord(character) < 32 or ord(character) == 127 for character in name)
                ):
                    continue
                candidate = _ReverseLexName(name)
                if len(selected) < BACKEND_MAX_LIBRARY_CANDIDATES:
                    heapq.heappush(selected, candidate)
                elif name < selected[0].value:
                    heapq.heapreplace(selected, candidate)
    except OSError:
        return []
    if ensure_live is not None:
        ensure_live()
    return sorted(candidate.value for candidate in selected)


def _backend_append_candidates(
    target: list[dict[str, str]],
    root: str,
    media_type: str,
    ownership: str,
    provider: str,
    seen: set[tuple[str, str]],
    ensure_live: Any,
) -> None:
    for name in _backend_directory_names(root, ensure_live):
        path = root + "/" + name
        key = (media_type, path)
        if key in seen:
            continue
        seen.add(key)
        target.append(
            {
                "path": path,
                "name": name,
                "media_type": media_type,
                "ownership": ownership,
                "provider": provider,
            }
        )


def _backend_media_entry(
    candidate: dict[str, str],
    instance_id: str,
    image_root: str,
    video_root: str,
    registry: dict[str, dict[str, Any]],
    provider_installs: dict[str, dict[str, str]],
    representative_stills: dict[str, dict[str, str]],
) -> dict[str, Any] | None:
    path = candidate["path"]
    info = _backend_regular_info(path)
    if info is None:
        return None
    extension = os.path.splitext(path)[1].lower()
    media_type = candidate["media_type"]
    supported = extension in (
        BACKEND_IMAGE_EXTENSIONS if media_type == "image" else BACKEND_VIDEO_EXTENSIONS
    )
    if media_type == "image" and extension == ".gif" and image_root == video_root:
        supported = False
    if not supported:
        return None
    entry: dict[str, Any] = {
        "id": f"{media_type}:{instance_id}:{_backend_library_token(path)}",
        "path": path,
        "name": candidate["name"],
        "size": info.st_size,
        "mtime": int(info.st_mtime),
        "media_type": media_type,
        "provider": "local",
        "ownership": "user",
        "managed": False,
        "deletable": False,
        "sidecar": "",
    }
    ownership = candidate["ownership"]
    if ownership == "managed-auto":
        record, sidecar_path = _backend_automatic_sidecar(path)
        if record is not None:
            entry.update(
                ownership="managed",
                managed=True,
                deletable=True,
                sidecar=sidecar_path,
                dynamic_id=record["dynamic_id"],
                provider=str(record.get("provider") or "Wall-in-One")[:80],
            )
    elif ownership == "managed-motionbgs":
        record, sidecar_path = _backend_sidecar(path, ".motionbgs.json", "MotionBGS")
        if record is not None:
            source_url = str(record.get("source_page") or "")
            quality = str(record.get("quality") or "").lower()
            recorded_bytes = _backend_number(record.get("bytes"))
            match = re.fullmatch(r"https://motionbgs\.com/([a-z0-9][a-z0-9-]{0,119})", source_url)
            if match is not None and quality in {"hd", "4k"} and recorded_bytes == info.st_size:
                provider_id = match.group(1)
                entry.update(
                    ownership="managed",
                    managed=True,
                    deletable=True,
                    sidecar=sidecar_path,
                    source_url=source_url,
                    provider="MotionBGS",
                    provider_id=provider_id,
                    quality=quality,
                )
                provider_installs["motionbgs"][provider_id + ":" + quality] = path
    elif ownership == "managed-wallhaven":
        record, sidecar_path = _backend_sidecar(path, ".wallhaven.json", "Wallhaven")
        if record is not None:
            provider_id = str(record.get("id") or "")
            source_url = str(record.get("source_page") or "")
            recorded_bytes = _backend_number(record.get("bytes"))
            if (
                BACKEND_WALLHAVEN_ID_RE.fullmatch(provider_id) is not None
                and source_url == "https://wallhaven.cc/w/" + provider_id
                and recorded_bytes == info.st_size
            ):
                entry.update(
                    ownership="managed",
                    managed=True,
                    deletable=True,
                    sidecar=sidecar_path,
                    source_url=source_url,
                    provider="Wallhaven",
                    provider_id=provider_id,
                )
                provider_installs["wallhaven"][provider_id.lower()] = path
    if media_type == "video":
        preview = _backend_cached_pair(registry, "video:" + path, info)
        entry["paired_preview"] = preview
        if preview:
            representative_stills["video"][path] = preview
    return entry


def _backend_scan_workshops(
    roots: list[str],
    registry: dict[str, dict[str, Any]],
    ensure_live: Any,
) -> tuple[list[dict[str, Any]], dict[str, str]]:
    candidates: list[tuple[str, str]] = []
    seen: set[str] = set()
    examined = 0
    for root in roots:
        for identifier in _backend_directory_names(root, ensure_live):
            examined += 1
            if BACKEND_WORKSHOP_ID_RE.fullmatch(identifier) is not None and identifier not in seen:
                seen.add(identifier)
                candidates.append((identifier, root + "/" + identifier + "/"))
                if len(candidates) >= BACKEND_MAX_LIBRARY_CANDIDATES:
                    break
            if examined >= BACKEND_MAX_LIBRARY_CANDIDATES:
                break
        if len(candidates) >= BACKEND_MAX_LIBRARY_CANDIDATES or examined >= BACKEND_MAX_LIBRARY_CANDIDATES:
            break
        ensure_live()
    result: list[dict[str, Any]] = []
    representatives: dict[str, str] = {}
    for index, (identifier, directory) in enumerate(candidates):
        if len(result) >= BACKEND_MAX_LIBRARY_ITEMS:
            break
        project_path = directory + "project.json"
        project_info = _backend_regular_info(project_path)
        if project_info is None or project_info.st_size > BACKEND_MAX_PROJECT_BYTES:
            continue
        try:
            project = _backend_json_file(project_path, BACKEND_MAX_PROJECT_BYTES)
        except HelperError:
            continue
        if not isinstance(project, dict):
            continue
        preview = _backend_safe_relative(project.get("preview", "preview.jpg"))
        paired_preview = _backend_cached_pair(registry, identifier, project_info)
        if paired_preview:
            representatives[identifier] = paired_preview
        result.append(
            {
                "id": identifier,
                "title": _backend_bounded_text(project.get("title") or ("Workshop " + identifier)),
                "kind": _backend_bounded_text(project.get("type") or "unknown"),
                "directory": directory,
                "preview": directory + preview if preview else "",
                "paired_preview": paired_preview,
                "ownership": "steam",
                "managed": False,
                "deletable": False,
            }
        )
        if index % 32 == 31:
            ensure_live()
    result.sort(key=lambda entry: str(entry["title"]).lower())
    return result, representatives


def _wallhaven_text(value: Any, maximum: int) -> str:
    if not isinstance(value, str):
        return ""
    text = "".join(
        " " if ord(character) < 32 or ord(character) == 127 else character
        for character in value
    ).strip()
    encoded = text.encode("utf-8")
    if len(encoded) <= maximum:
        return text
    return encoded[:maximum].decode("utf-8", errors="ignore")


def _wallhaven_integer(value: Any, fallback: int, minimum: int, maximum: int) -> int:
    if type(value) not in (int, float) or not math.isfinite(float(value)):
        number = fallback
    else:
        number = math.floor(float(value))
    return max(minimum, min(maximum, number))


def _wallhaven_id(value: Any) -> str:
    if not isinstance(value, str):
        raise HelperError("validation", "wallpaper ID must be six alphanumeric characters", 64)
    identifier = value.lower()
    if WALLHAVEN_ID_RE.fullmatch(identifier) is None:
        raise HelperError("validation", "wallpaper ID must be six alphanumeric characters", 64)
    return identifier


def _wallhaven_cdn_url(value: Any, identifier: str) -> tuple[str, str]:
    if not isinstance(value, str) or len(value.encode("utf-8")) > WALLHAVEN_MAX_URL_BYTES:
        raise HelperError("response", "wallpaper result has an unsupported media URL", 65)
    match = WALLHAVEN_CDN_RE.fullmatch(value)
    if (
        match is None
        or match.group(1) != identifier[:2]
        or match.group(2) != identifier
    ):
        raise HelperError("response", "wallpaper result has an unsupported media URL", 65)
    return value, match.group(3)


def _wallhaven_thumb_url(value: Any) -> str:
    if not isinstance(value, str) or len(value.encode("utf-8")) > WALLHAVEN_MAX_URL_BYTES:
        return ""
    if any(ord(character) < 32 or ord(character) == 127 for character in value):
        return ""
    if "?" in value or "#" in value or not value.startswith(WALLHAVEN_THUMB_ORIGIN + "/"):
        return ""
    path = value[len(WALLHAVEN_THUMB_ORIGIN) + 1 :]
    if (
        not path
        or "//" in path
        or any(component in {".", ".."} for component in path.split("/"))
        or re.fullmatch(r"[A-Za-z0-9._/-]+", path) is None
    ):
        return ""
    return WALLHAVEN_THUMB_ORIGIN + "/" + path


def _wallhaven_colors(value: Any) -> list[str]:
    if not isinstance(value, list):
        return []
    colors: list[str] = []
    for candidate in value:
        if len(colors) >= 8:
            break
        if isinstance(candidate, str) and re.fullmatch(r"#[0-9A-Fa-f]{6}", candidate):
            colors.append(candidate.lower())
    return colors


def _wallhaven_tags(value: Any) -> list[dict[str, Any]]:
    if not isinstance(value, list):
        return []
    tags: list[dict[str, Any]] = []
    for candidate in value:
        if len(tags) >= WALLHAVEN_MAX_TAGS:
            break
        if not isinstance(candidate, dict):
            continue
        identifier = _wallhaven_integer(candidate.get("id"), 0, 0, 9_007_199_254_740_991)
        name = _wallhaven_text(candidate.get("name"), 160)
        if identifier > 0 and name:
            tags.append(
                {
                    "id": identifier,
                    "name": name,
                    "alias": _wallhaven_text(candidate.get("alias"), 160),
                    "category": _wallhaven_text(candidate.get("category"), 80),
                    "purity": _wallhaven_text(candidate.get("purity"), 16),
                }
            )
    return tags


def _wallhaven_normalize_wallpaper(value: Any, include_detail: bool) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise HelperError("response", "wallpaper result is not an object", 65)
    identifier = _wallhaven_id(value.get("id"))
    path, extension = _wallhaven_cdn_url(value.get("path"), identifier)
    file_type = _wallhaven_text(value.get("file_type"), 32).lower()
    expected_type = "image/jpeg" if extension == "jpg" else "image/png"
    if file_type != expected_type:
        raise HelperError("response", "wallpaper result file type does not match its URL", 65)
    dimension_x = _wallhaven_integer(value.get("dimension_x"), 0, 0, 1_000_000)
    dimension_y = _wallhaven_integer(value.get("dimension_y"), 0, 0, 1_000_000)
    item: dict[str, Any] = {
        "id": identifier,
        "url": WALLHAVEN_SITE_ORIGIN + "/w/" + identifier,
        "short_url": WALLHAVEN_SHORT_ORIGIN + "/" + identifier,
        "path": path,
        "extension": extension,
        "file_type": file_type,
        "file_size": _wallhaven_integer(value.get("file_size"), 0, 0, 9_007_199_254_740_991),
        "views": _wallhaven_integer(value.get("views"), 0, 0, 9_007_199_254_740_991),
        "favorites": _wallhaven_integer(value.get("favorites"), 0, 0, 9_007_199_254_740_991),
        "purity": _wallhaven_text(value.get("purity"), 16),
        "category": _wallhaven_text(value.get("category"), 32),
        "dimension_x": dimension_x,
        "dimension_y": dimension_y,
        "resolution": (
            f"{dimension_x}x{dimension_y}"
            if dimension_x > 0 and dimension_y > 0
            else _wallhaven_text(value.get("resolution"), 32)
        ),
        "ratio": _wallhaven_text(value.get("ratio"), 32),
        "source": _wallhaven_text(value.get("source"), WALLHAVEN_MAX_TEXT_BYTES),
        "created_at": _wallhaven_text(value.get("created_at"), 64),
        "colors": _wallhaven_colors(value.get("colors")),
        "thumbs": {},
    }
    thumbs = value.get("thumbs")
    if isinstance(thumbs, dict):
        item["thumbs"] = {
            "large": _wallhaven_thumb_url(thumbs.get("large")),
            "original": _wallhaven_thumb_url(thumbs.get("original")),
            "small": _wallhaven_thumb_url(thumbs.get("small")),
        }
    if include_detail:
        item["tags"] = _wallhaven_tags(value.get("tags"))
        uploader = value.get("uploader")
        item["uploader"] = (
            {
                "username": _wallhaven_text(uploader.get("username"), 80),
                "group": _wallhaven_text(uploader.get("group"), 40),
            }
            if isinstance(uploader, dict)
            else {}
        )
    return item


def _wallhaven_bits(value: Any, fallback: str, label: str) -> str:
    bits = fallback if value in (None, "") else str(value)
    if re.fullmatch(r"[01]{3}", bits) is None or bits == "000":
        raise HelperError("validation", f"{label} must be a three-bit Wallhaven mask", 64)
    return bits


def _wallhaven_resolution(value: Any) -> str:
    if value in (None, ""):
        return ""
    if not isinstance(value, str) or len(value.encode("utf-8")) > 24:
        raise HelperError("validation", "Minimum resolution must look like 1920x1080", 64)
    match = re.fullmatch(r"([0-9]+)x([0-9]+)", value)
    if match is None:
        raise HelperError("validation", "Minimum resolution must look like 1920x1080", 64)
    width, height = int(match.group(1)), int(match.group(2))
    if not (1 <= width <= 100_000 and 1 <= height <= 100_000):
        raise HelperError("validation", "Minimum resolution must look like 1920x1080", 64)
    return f"{width}x{height}"


def _wallhaven_csv_resolutions(value: Any) -> str:
    if value in (None, ""):
        return ""
    if (
        not isinstance(value, str)
        or len(value.encode("utf-8")) > 192
        or any(character.isspace() or ord(character) < 32 for character in value)
    ):
        raise HelperError("validation", "Exact resolutions must be comma-separated values", 64)
    parts = value.split(",")
    if not 1 <= len(parts) <= 12:
        raise HelperError("validation", "resolutions accepts at most twelve exact values", 64)
    normalized = ",".join(_wallhaven_resolution(part) for part in parts)
    if normalized != value:
        raise HelperError("validation", "Exact resolutions must be comma-separated values", 64)
    return normalized


def _wallhaven_csv_ratios(value: Any) -> str:
    if value in (None, ""):
        return ""
    if (
        not isinstance(value, str)
        or len(value.encode("utf-8")) > 96
        or any(character.isspace() or ord(character) < 32 for character in value)
    ):
        raise HelperError("validation", "ratios must be a comma-separated list such as 16x9,16x10", 64)
    parts = value.split(",")
    if not 1 <= len(parts) <= 8:
        raise HelperError("validation", "ratios accepts at most eight values", 64)
    normalized: list[str] = []
    for part in parts:
        match = re.fullmatch(r"([0-9]+)x([0-9]+)", part)
        if match is None:
            raise HelperError("validation", "ratios must be a comma-separated list such as 16x9,16x10", 64)
        width, height = int(match.group(1)), int(match.group(2))
        if not (1 <= width <= 1000 and 1 <= height <= 1000):
            raise HelperError("validation", "ratios must be a comma-separated list such as 16x9,16x10", 64)
        normalized.append(f"{width}x{height}")
    result = ",".join(normalized)
    if result != value:
        raise HelperError("validation", "ratios must be a comma-separated list such as 16x9,16x10", 64)
    return result


def _wallhaven_filters(value: Any, authenticated: bool) -> dict[str, Any]:
    required = {
        "query", "categories", "purity", "sorting", "order", "atleast",
        "resolutions", "ratios", "colors", "top_range", "seed", "page",
    }
    if not isinstance(value, dict) or set(value) != required:
        raise HelperError("invalid-request", "Wallhaven filters must be an exact object", 64)
    query = value.get("query")
    if (
        not isinstance(query, str)
        or len(query.encode("utf-8")) > WALLHAVEN_MAX_QUERY_BYTES
        or any(ord(character) < 32 or ord(character) == 127 for character in query)
    ):
        raise HelperError("validation", "query must be control-free text no longer than 256 bytes", 64)
    query = query.strip()
    categories = _wallhaven_bits(value.get("categories"), "111", "categories")
    purity = _wallhaven_bits(value.get("purity"), "100", "purity")
    if purity[2] == "1" and not authenticated:
        raise HelperError("validation", "NSFW search requires a Wallhaven API key", 64)
    sorting = str(value.get("sorting") or "date_added").lower()
    order = str(value.get("order") or "desc").lower()
    if sorting not in WALLHAVEN_SORTING:
        raise HelperError("validation", "sorting is not supported by Wallhaven API v1", 64)
    if order not in WALLHAVEN_ORDER:
        raise HelperError("validation", "order must be asc or desc", 64)
    atleast = _wallhaven_resolution(value.get("atleast"))
    resolutions = _wallhaven_csv_resolutions(value.get("resolutions"))
    if atleast and resolutions:
        raise HelperError("validation", "Choose either minimum resolution or exact resolutions, not both", 64)
    ratios = _wallhaven_csv_ratios(value.get("ratios"))
    raw_color = value.get("colors")
    if raw_color in (None, ""):
        color = ""
    elif isinstance(raw_color, str) and raw_color.lower().lstrip("#") in WALLHAVEN_COLORS:
        color = raw_color.lower().lstrip("#")
    else:
        raise HelperError("validation", "colors must be one of Wallhaven's documented color values", 64)
    top_range = str(value.get("top_range") or "1M")
    if top_range not in WALLHAVEN_TOP_RANGE:
        raise HelperError("validation", "topRange has an unsupported value", 64)
    seed = str(value.get("seed") or "")
    if seed and (sorting != "random" or re.fullmatch(r"[A-Za-z0-9]{6}", seed) is None):
        raise HelperError("validation", "seed must be six alphanumeric characters used with random sorting", 64)
    page = _wallhaven_integer(value.get("page"), 0, 0, 10_001)
    if type(value.get("page")) not in (int, float) or isinstance(value.get("page"), bool):
        page = 0
    if page < 1 or page > 10_000 or float(value.get("page")) != page:
        raise HelperError("validation", "page must be an integer from 1 through 10000", 64)
    return {
        "query": query,
        "categories": categories,
        "purity": purity,
        "sorting": sorting,
        "order": order,
        "atleast": atleast,
        "resolutions": resolutions,
        "ratios": ratios,
        "colors": color,
        "top_range": top_range,
        "seed": seed,
        "page": page,
    }


def _wallhaven_search_url(filters: dict[str, Any]) -> str:
    pairs: list[tuple[str, str]] = []
    for name, value in (
        ("q", filters["query"]),
        ("categories", filters["categories"]),
        ("purity", filters["purity"]),
        ("sorting", filters["sorting"]),
        ("order", filters["order"]),
        ("atleast", filters["atleast"]),
        ("resolutions", filters["resolutions"]),
        ("ratios", filters["ratios"]),
        ("colors", filters["colors"]),
    ):
        if value != "":
            pairs.append((name, str(value)))
    if filters["sorting"] == "toplist":
        pairs.append(("topRange", filters["top_range"]))
    elif filters["sorting"] == "random" and filters["seed"]:
        pairs.append(("seed", filters["seed"]))
    pairs.append(("page", str(filters["page"])))
    query = "&".join(
        quote(name, safe="-._~") + "=" + quote(value, safe="-._~")
        for name, value in pairs
    )
    return WALLHAVEN_API_ORIGIN + WALLHAVEN_API_PREFIX + "/search?" + query


def _wallhaven_credential(value: Any, transport: str) -> str:
    if value == "":
        return ""
    path = _safe_absolute_path(value)
    if (
        not _backend_direct_child(path, transport)
        or WALLHAVEN_CREDENTIAL_RE.fullmatch(os.path.basename(path)) is None
    ):
        raise HelperError("credential", "Wallhaven API key path is unsafe", 65)
    payload = _read_bounded_file(path, 280, minimum=12)
    if re.fullmatch(rb"X-API-Key: [A-Za-z0-9_-]{1,256}\n", payload) is None:
        raise HelperError("credential", "Wallhaven API key file is invalid", 65)
    try:
        os.chmod(path, 0o600, follow_symlinks=False)
    except OSError as error:
        raise HelperError("credential", f"could not protect Wallhaven API key: {error.strerror}", 65) from error
    return path


def _wallhaven_validate_marker(directory: str) -> None:
    marker_path = directory + "/" + WALLHAVEN_MARKER_NAME
    try:
        marker = json.loads(_read_bounded_file(marker_path, WALLHAVEN_MAX_MARKER_BYTES).decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise HelperError("invalid-marker", "managed Wallhaven ownership marker is invalid", 65) from error
    if (
        not isinstance(marker, dict)
        or marker.get("schema") != 1
        or marker.get("plugin") != "goober/wall-in-one"
        or marker.get("kind") != "wallhaven"
        or marker.get("ownership") != "managed"
    ):
        raise HelperError("invalid-marker", "managed Wallhaven ownership marker is invalid", 65)


def _wallhaven_validate_request(decoded: dict[str, Any], request_path: str) -> dict[str, Any]:
    action = decoded.get("action")
    common = {
        "schema", "request_id", "action", "transport_directory", "guard_path",
        "operation_timeout_ms", "api_key_path",
    }
    action_fields = {
        "wallhaven.search": {"filters"},
        "wallhaven.detail": {"id"},
        "wallhaven.download": {"item", "image_root", "target_path"},
        "wallhaven.clear": set(),
    }
    if action not in action_fields or set(decoded) != common | action_fields[action]:
        raise HelperError("invalid-request", "Wallhaven request has unsupported or missing fields", 64)
    transport = _existing_directory(decoded.get("transport_directory"))
    if not _backend_direct_child(request_path, transport):
        raise HelperError("invalid-path", "request must be a direct transport child", 64)
    guard = _safe_absolute_path(decoded.get("guard_path"))
    if (
        not _backend_direct_child(guard, transport)
        or BACKEND_GUARD_NAME_RE.fullmatch(os.path.basename(guard)) is None
    ):
        raise HelperError("invalid-path", "backend guard must be a named transport child", 64)
    timeout = _int_field(
        decoded.get("operation_timeout_ms"),
        "operation_timeout_ms",
        BACKEND_MIN_OPERATION_TIMEOUT_MS,
        BACKEND_MAX_OPERATION_TIMEOUT_MS,
    )
    credential = _wallhaven_credential(decoded.get("api_key_path"), transport)
    if action in {"wallhaven.download", "wallhaven.clear"} and credential:
        raise HelperError("credential", "this Wallhaven action does not accept an API key", 64)
    decoded.update(
        _request_path=request_path,
        _deadline_monotonic=time.monotonic() + timeout / 1000.0,
        transport_directory=transport,
        guard_path=guard,
        operation_timeout_ms=timeout,
        api_key_path=credential,
    )
    if action == "wallhaven.search":
        decoded["filters"] = _wallhaven_filters(decoded.get("filters"), bool(credential))
    elif action == "wallhaven.detail":
        decoded["id"] = _wallhaven_id(decoded.get("id"))
    elif action == "wallhaven.download":
        item = decoded.get("item")
        item_keys = {
            "id", "path", "short_url", "file_type", "file_size",
            "dimension_x", "dimension_y",
        }
        if not isinstance(item, dict) or set(item) != item_keys:
            raise HelperError("invalid-request", "Wallhaven download item must be an exact object", 64)
        identifier = _wallhaven_id(item.get("id"))
        media_url, extension = _wallhaven_cdn_url(item.get("path"), identifier)
        if item.get("short_url") != WALLHAVEN_SHORT_ORIGIN + "/" + identifier:
            raise HelperError("validation", "Wallhaven short URL does not match its ID", 64)
        expected_type = "image/jpeg" if extension == "jpg" else "image/png"
        if item.get("file_type") != expected_type:
            raise HelperError("validation", "Wallhaven media type does not match its URL", 64)
        file_size = _int_field(item.get("file_size"), "file_size", 1, WALLHAVEN_MAX_DOWNLOAD_BYTES)
        width = _int_field(item.get("dimension_x"), "dimension_x", 1, 100_000)
        height = _int_field(item.get("dimension_y"), "dimension_y", 1, 100_000)
        if width * height > 512 * 1024 * 1024:
            raise HelperError("validation", "Wallhaven image dimensions exceed the safety ceiling", 65)
        image_root = _existing_directory(decoded.get("image_root"))
        managed_directory = image_root + "/Wall-in-One/Wallhaven"
        managed_directory = _existing_directory(managed_directory)
        _wallhaven_validate_marker(managed_directory)
        target = _safe_absolute_path(decoded.get("target_path"))
        expected_target = managed_directory + f"/wallhaven-{identifier}.{extension}"
        if target != expected_target:
            raise HelperError("invalid-path", "target must be the managed Wallhaven destination", 64)
        if os.path.lexists(target) or os.path.lexists(target + ".wallhaven.json"):
            raise HelperError("conflict", "Wallhaven target or provenance sidecar already exists", 73)
        decoded.update(
            item={
                "id": identifier,
                "path": media_url,
                "short_url": WALLHAVEN_SHORT_ORIGIN + "/" + identifier,
                "file_type": expected_type,
                "file_size": file_size,
                "dimension_x": width,
                "dimension_y": height,
            },
            image_root=image_root,
            managed_directory=managed_directory,
            target_path=target,
        )
    return decoded


def _preview_item(value: Any) -> dict[str, str]:
    if not isinstance(value, dict) or set(value) != {"provider", "id", "url"}:
        raise HelperError("invalid-request", "preview item must be an exact provider/id/url object", 64)
    provider = value.get("provider")
    identifier_value = value.get("id")
    url = value.get("url")
    if provider not in {"wallhaven", "motionbgs"} or not isinstance(identifier_value, str):
        raise HelperError("invalid-request", "preview item provider or ID is invalid", 64)
    identifier = identifier_value.lower()
    if not isinstance(url, str) or len(url.encode("utf-8")) > 2048:
        raise HelperError("invalid-request", "preview URL is invalid", 64)
    if provider == "wallhaven":
        match = PREVIEW_WALLHAVEN_URL_RE.fullmatch(url)
        if (
            PREVIEW_WALLHAVEN_ID_RE.fullmatch(identifier) is None
            or match is None
            or match.group(1) != identifier[:2]
            or match.group(2) != identifier
        ):
            raise HelperError("invalid-request", "Wallhaven preview identity or URL is invalid", 64)
    else:
        match = PREVIEW_MOTIONBGS_URL_RE.fullmatch(url)
        if PREVIEW_MOTIONBGS_ID_RE.fullmatch(identifier) is None or match is None:
            raise HelperError("invalid-request", "MotionBGS preview identity or URL is invalid", 64)
    return {"provider": provider, "id": identifier, "url": url}


def _preview_validate_request(decoded: dict[str, Any], request_path: str) -> dict[str, Any]:
    required = {
        "schema", "request_id", "action", "transport_directory", "guard_path",
        "operation_timeout_ms", "thumbnail_helper", "items",
    }
    if set(decoded) != required:
        raise HelperError("invalid-request", "preview.sync request must be an exact object", 64)
    transport = _existing_directory(decoded.get("transport_directory"))
    if not _backend_direct_child(request_path, transport):
        raise HelperError("invalid-path", "preview request must be a direct transport child", 64)
    if os.path.basename(transport) != "rpc":
        raise HelperError("invalid-path", "preview transport directory must be named rpc", 64)
    cache_directory = _existing_directory(os.path.dirname(transport))
    cache_parent = _existing_directory(os.path.dirname(cache_directory))
    if os.path.basename(cache_directory) != "v1" or os.path.basename(cache_parent) != "provider-previews":
        raise HelperError("invalid-path", "preview transport must be provider-previews/v1/rpc", 64)
    guard = _safe_absolute_path(decoded.get("guard_path"))
    if (
        not _backend_direct_child(guard, transport)
        or BACKEND_GUARD_NAME_RE.fullmatch(os.path.basename(guard)) is None
    ):
        raise HelperError("invalid-path", "preview guard must be a named transport child", 64)
    helper = _safe_absolute_path(decoded.get("thumbnail_helper"))
    if os.path.basename(helper) != "provider-thumbnail":
        raise HelperError("invalid-path", "thumbnail helper must be named provider-thumbnail", 64)
    raw_items = decoded.get("items")
    if not isinstance(raw_items, list) or not 1 <= len(raw_items) <= PREVIEW_MAX_ITEMS:
        raise HelperError("invalid-request", "preview.sync accepts one through thirteen items", 64)
    timeout = _int_field(
        decoded.get("operation_timeout_ms"),
        "operation_timeout_ms",
        BACKEND_MIN_OPERATION_TIMEOUT_MS,
        PREVIEW_MAX_OPERATION_TIMEOUT_MS,
    )
    decoded.update(
        _request_path=request_path,
        _deadline_monotonic=time.monotonic() + timeout / 1000.0,
        transport_directory=transport,
        cache_directory=cache_directory,
        guard_path=guard,
        thumbnail_helper=helper,
        items=[_preview_item(item) for item in raw_items],
    )
    return decoded


def _palettes_config_directory() -> str:
    base = os.environ.get("NOCTALIA_CONFIG_HOME") or os.environ.get("XDG_CONFIG_HOME")
    if not base:
        home = os.environ.get("HOME")
        base = home.rstrip("/") + "/.config" if home else ""
    if not base:
        raise HelperError(
            "configuration",
            "HOME and the Noctalia/XDG config overrides are unavailable",
            72,
        )
    base = _safe_absolute_path(base.rstrip("/"))
    return base + "/noctalia/palettes"


def _palettes_validate_request(decoded: dict[str, Any], request_path: str) -> dict[str, Any]:
    required = {
        "schema", "request_id", "action", "transport_directory", "data_directory",
