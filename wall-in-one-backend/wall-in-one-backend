        "meta": {},
        "items": [],
        "selected": {},
    }


def _wallhaven_jpeg_dimensions(
    path: str, request: dict[str, Any]
) -> tuple[int, int]:
    size = os.lstat(path).st_size
    with open(path, "rb") as stream:
        if stream.read(2) != b"\xff\xd8":
            raise HelperError("content-type", "JPEG signature is invalid", 65)
        stream.seek(-2, os.SEEK_END)
        if stream.read(2) != b"\xff\xd9":
            raise HelperError("content-type", "JPEG is missing its terminal marker", 65)
        position = 2
        dimensions: tuple[int, int] | None = None
        sof_markers = {
            0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7,
            0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF,
        }
        segment_count = 0
        while position < size - 2:
            segment_count += 1
            if segment_count > 4096:
                raise HelperError("content-type", "JPEG contains too many segments", 65)
            if segment_count % 64 == 0:
                _backend_ensure_live(request)
            stream.seek(position)
            if stream.read(1) != b"\xff":
                raise HelperError("content-type", "JPEG segment framing is invalid", 65)
            marker_byte = stream.read(1)
            fill_count = 0
            while marker_byte == b"\xff":
                fill_count += 1
                if fill_count > 64:
                    raise HelperError("content-type", "JPEG marker fill is excessive", 65)
                marker_byte = stream.read(1)
            if not marker_byte:
                break
            marker = marker_byte[0]
            position = stream.tell()
            if marker in {0x01, *range(0xD0, 0xD8)}:
                continue
            if marker in {0x00, 0xD8, 0xD9}:
                raise HelperError("content-type", "JPEG contains an invalid marker", 65)
            raw_length = stream.read(2)
            if len(raw_length) != 2:
                raise HelperError("content-type", "JPEG segment is truncated", 65)
            segment_length = struct.unpack(">H", raw_length)[0]
            segment_end = position + segment_length
            if segment_length < 2 or segment_end > size - 2:
                raise HelperError("content-type", "JPEG segment length is invalid", 65)
            if marker in sof_markers:
                payload = stream.read(min(segment_length - 2, 16))
                if len(payload) < 6:
                    raise HelperError("content-type", "JPEG frame header is truncated", 65)
                height, width = struct.unpack(">HH", payload[1:5])
                components = payload[5]
                if components < 1 or components > 4 or segment_length != 8 + 3 * components:
                    raise HelperError("content-type", "JPEG frame header is invalid", 65)
                if dimensions is not None:
                    raise HelperError("content-type", "JPEG contains multiple frame headers", 65)
                dimensions = (width, height)
            elif marker == 0xDA:
                payload = stream.read(min(segment_length - 2, 16))
                if dimensions is None or len(payload) < 1:
                    raise HelperError("content-type", "JPEG scan precedes its frame header", 65)
                components = payload[0]
                if not 1 <= components <= 4 or segment_length != 6 + 2 * components:
                    raise HelperError("content-type", "JPEG scan header is invalid", 65)
                if segment_end >= size - 2:
                    raise HelperError("content-type", "JPEG has no entropy-coded image data", 65)
                return dimensions
            position = segment_end
    raise HelperError("content-type", "JPEG has no complete image scan", 65)


def _wallhaven_png_dimensions(path: str) -> tuple[int, int]:
    size = os.lstat(path).st_size
    with open(path, "rb") as stream:
        if stream.read(8) != b"\x89PNG\r\n\x1a\n":
            raise HelperError("content-type", "PNG signature is invalid", 65)
        position = 8
        chunk_count = 0
        dimensions: tuple[int, int] | None = None
        saw_idat = False
        saw_iend = False
        while position < size:
            chunk_count += 1
            if chunk_count > 4096:
                raise HelperError("content-type", "PNG contains too many chunks", 65)
            header = stream.read(8)
            if len(header) != 8:
                raise HelperError("content-type", "PNG chunk header is truncated", 65)
            length, chunk_type = struct.unpack(">I4s", header)
            position += 8
            if length > size - position - 4 or re.fullmatch(rb"[A-Za-z]{4}", chunk_type) is None:
                raise HelperError("content-type", "PNG chunk framing is invalid", 65)
            checksum = zlib.crc32(chunk_type)
            remaining = length
            payload_prefix = b""
            while remaining:
                chunk = stream.read(min(64 * 1024, remaining))
                if not chunk:
                    raise HelperError("content-type", "PNG chunk is truncated", 65)
                if len(payload_prefix) < 13:
                    payload_prefix += chunk[: 13 - len(payload_prefix)]
                checksum = zlib.crc32(chunk, checksum)
                remaining -= len(chunk)
            expected_crc = stream.read(4)
            if len(expected_crc) != 4 or struct.unpack(">I", expected_crc)[0] != checksum & 0xFFFFFFFF:
                raise HelperError("content-type", "PNG chunk checksum is invalid", 65)
            position += length + 4
            if chunk_count == 1:
                if chunk_type != b"IHDR" or length != 13:
                    raise HelperError("content-type", "PNG must start with one IHDR chunk", 65)
                width, height, depth, color, compression, filtering, interlace = struct.unpack(
                    ">IIBBBBB", payload_prefix
                )
                allowed_depths = {
                    0: {1, 2, 4, 8, 16},
                    2: {8, 16},
                    3: {1, 2, 4, 8},
                    4: {8, 16},
                    6: {8, 16},
                }
                if (
                    color not in allowed_depths
                    or depth not in allowed_depths[color]
                    or compression != 0
                    or filtering != 0
                    or interlace not in {0, 1}
                ):
                    raise HelperError("content-type", "PNG image header is unsupported", 65)
                dimensions = (width, height)
            elif chunk_type == b"IHDR":
                raise HelperError("content-type", "PNG contains multiple IHDR chunks", 65)
            if chunk_type == b"IDAT":
                if length < 1:
                    raise HelperError("content-type", "PNG image data is empty", 65)
                saw_idat = True
            elif chunk_type == b"IEND":
                if length != 0 or not saw_idat or position != size:
                    raise HelperError("content-type", "PNG terminal chunk is invalid", 65)
                saw_iend = True
                break
        if dimensions is None or not saw_iend:
            raise HelperError("content-type", "PNG image structure is incomplete", 65)
        return dimensions


def _wallhaven_validate_image(
    request: dict[str, Any], path: str, content_type: str
) -> tuple[int, int, int]:
    item = request["item"]
    info = _lstat_regular(path, maximum=WALLHAVEN_MAX_DOWNLOAD_BYTES)
    if info.st_size != item["file_size"]:
        raise HelperError("size-mismatch", "downloaded size does not match Wallhaven metadata", 65)
    expected_type = item["file_type"]
    if content_type != expected_type:
        raise HelperError("content-type", "download MIME type does not match Wallhaven metadata", 65)
    dimensions = (
        _wallhaven_jpeg_dimensions(path, request)
        if expected_type == "image/jpeg"
        else _wallhaven_png_dimensions(path)
    )
    if dimensions != (item["dimension_x"], item["dimension_y"]):
        raise HelperError("dimensions", "downloaded image dimensions do not match Wallhaven metadata", 65)
    _backend_ensure_live(request)
    return info.st_size, dimensions[0], dimensions[1]


def _wallhaven_install(
    request: dict[str, Any], transfer_path: str, sidecar_payload: bytes
) -> tuple[str, str]:
    destination = request["target_path"]
    sidecar_destination = destination + ".wallhaven.json"
    sidecar_temp = _new_temporary(request["managed_directory"], ".wallhaven-metadata.")
    installed_media = False
    installed_sidecar = False
    try:
        descriptor = os.open(
            sidecar_temp,
            os.O_WRONLY | os.O_TRUNC | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
        )
        try:
            _write_all(descriptor, sidecar_payload)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        current_root = _existing_directory(request["image_root"])
        current_directory = _existing_directory(current_root + "/Wall-in-One/Wallhaven")
        if current_directory != request["managed_directory"]:
            raise HelperError("configuration", "managed Wallhaven directory changed during download", 65)
        expected_target = current_directory + "/wallhaven-" + request["item"]["id"] + "." + (
            "jpg" if request["item"]["file_type"] == "image/jpeg" else "png"
        )
        if request["target_path"] != expected_target:
            raise HelperError("configuration", "Wallhaven destination changed during download", 65)
        _wallhaven_validate_marker(request["managed_directory"])
        _backend_ensure_live(request)
        os.link(transfer_path, destination, follow_symlinks=False)
        installed_media = True
        os.link(sidecar_temp, sidecar_destination, follow_symlinks=False)
        installed_sidecar = True
        os.unlink(transfer_path)
        os.unlink(sidecar_temp)
        _forget_temporary(transfer_path)
        _forget_temporary(sidecar_temp)
        return destination, sidecar_destination
    except BaseException as error:
        if installed_sidecar:
            try:
                os.unlink(sidecar_destination)
            except OSError:
                pass
        if installed_media:
            try:
                os.unlink(destination)
            except OSError:
                pass
        if isinstance(error, FileExistsError):
            raise HelperError("conflict", "Wallhaven destination appeared before installation", 73) from error
        if isinstance(error, (HelperError, Cancelled)):
            raise
        if isinstance(error, OSError):
            raise HelperError("local-io", f"could not install Wallhaven download: {error.strerror}", 74) from error
        raise


def _wallhaven_download(
    request: dict[str, Any]
) -> tuple[dict[str, Any], tuple[str, str]]:
    item = request["item"]
    transfer = _wallhaven_curl(
        request,
        item["path"],
        request["managed_directory"],
        item["file_size"],
        WALLHAVEN_MEDIA_TIMEOUT_SECONDS,
        "image/jpeg,image/png;q=0.9",
        item["file_type"],
    )
    try:
        size, width, height = _wallhaven_validate_image(
            request, transfer["path"], transfer["content_type"]
        )
        downloaded_at = dt.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S")
        downloaded_epoch = int(time.time())
        sidecar = {
            "schema": BACKEND_PROTOCOL,
            "plugin": "goober/wall-in-one",
            "provider": "Wallhaven",
            "source": "wallhaven",
            "id": item["id"],
            "url": item["path"],
            "path": request["target_path"],
            "page_url": WALLHAVEN_SITE_ORIGIN + "/w/" + item["id"],
            "source_page": WALLHAVEN_SITE_ORIGIN + "/w/" + item["id"],
            "bytes": size,
            "downloaded_at": downloaded_at,
            "downloaded_at_epoch": downloaded_epoch,
        }
        sidecar_payload = _encode_json(sidecar, BACKEND_MAX_SIDECAR_BYTES)
        installed_path, installed_sidecar = _wallhaven_install(
            request, transfer["path"], sidecar_payload
        )
        try:
            _backend_ensure_live(request)
        except BaseException:
            for installed in (installed_sidecar, installed_path):
                try:
                    os.unlink(installed)
                except OSError:
                    pass
            raise
    except BaseException:
        _remove_temporary(transfer["path"])
        raise
    download = {
        "id": item["id"],
        "url": item["path"],
        "path": installed_path,
        "sidecar": installed_sidecar,
        "bytes": size,
        "dimension_x": width,
        "dimension_y": height,
        "downloaded_at": downloaded_at,
    }
    return (
        {
            "schema": BACKEND_PROTOCOL,
            "request_id": request["request_id"],
            "action": "wallhaven.download",
            "ok": True,
            "kind": "download",
            "download": download,
        },
        (installed_path, installed_sidecar),
    )


def _palettes_color(value: Any) -> str:
    if not isinstance(value, str) or re.fullmatch(r"#[0-9A-Fa-f]{6}", value) is None:
        return ""
    return value.upper()


def _palettes_mode(value: Any, *, custom: bool) -> dict[str, Any]:
    if not isinstance(value, dict):
        return {"surface": "", "accents": []}

    def field(name: str) -> str:
        if custom:
            prefixed = "m" + name[0].upper() + name[1:]
            selected = _palettes_color(value.get(prefixed))
            if selected:
                return selected
        return _palettes_color(value.get(name))

    accents: list[str] = []
    raw_accents = value.get("accents")
    if isinstance(raw_accents, list):
        for candidate in raw_accents[:4]:
            color = _palettes_color(candidate)
            if color:
                accents.append(color)
    else:
        for name in ("primary", "secondary", "tertiary", "error"):
            color = field(name)
            if color:
                accents.append(color)
    return {"surface": field("surface"), "accents": accents}


def _palettes_copy_mode(value: dict[str, Any]) -> dict[str, Any]:
    return {
        "surface": str(value.get("surface", "")),
        "accents": [str(color) for color in value.get("accents", [])],
    }


def _palettes_valid_name(value: Any) -> bool:
    return (
        isinstance(value, str)
        and bool(value)
        and len(value.encode("utf-8")) <= PALETTES_MAX_NAME_BYTES
        and not any(ord(character) < 32 or ord(character) == 127 for character in value)
    )


def _palettes_custom_preview(value: Any) -> dict[str, Any] | None:
    if not isinstance(value, dict):
        return None
    if isinstance(value.get("dark"), dict) or isinstance(value.get("light"), dict):
        dark = _palettes_mode(value.get("dark"), custom=True)
        light = _palettes_mode(value.get("light"), custom=True)
        if not light["accents"] and dark["accents"]:
            light = _palettes_copy_mode(dark)
    else:
        dark = _palettes_mode(value, custom=True)
        light = _palettes_copy_mode(dark)
    if not dark["accents"] and not light["accents"]:
        return None
    return {"dark": dark, "light": light}


def _palettes_community_entry(value: Any) -> dict[str, Any] | None:
    name = value if isinstance(value, str) else value.get("name") if isinstance(value, dict) else None
    if not _palettes_valid_name(name):
        return None
    digest = ""
    preview_root: dict[str, Any] = {}
    if isinstance(value, dict):
        candidate_digest = value.get("md5")
        if isinstance(candidate_digest, str) and re.fullmatch(r"[0-9A-Fa-f]{32}", candidate_digest):
            digest = candidate_digest.lower()
        preview_root = value.get("preview") if isinstance(value.get("preview"), dict) else value
    return {
        "name": name,
        "md5": digest,
        "preview": {
            "dark": _palettes_mode(preview_root.get("dark"), custom=False),
            "light": _palettes_mode(preview_root.get("light"), custom=False),
        },
    }


def _palettes_community_catalog(value: Any) -> list[dict[str, Any]]:
    raw = value.get("palettes") if isinstance(value, dict) else value
    if not isinstance(raw, list) or not raw:
        raise HelperError("response", "community palette catalog contains no palette array", 65)
    result: list[dict[str, Any]] = []
    seen: set[str] = set()
    for candidate in raw[:PALETTES_MAX_CATALOG_SCAN]:
        entry = _palettes_community_entry(candidate)
        if entry is not None and entry["name"] not in seen:
            seen.add(entry["name"])
            result.append(entry)
            if len(result) >= PALETTES_MAX_ENTRIES:
                break
    if not result:
        raise HelperError("response", "community palette catalog contains no valid bounded entries", 65)
    result.sort(key=lambda entry: str(entry["name"]))
    return result


def _palettes_open_custom_directory(directory: str) -> tuple[int, os.stat_result]:
    canonical = _safe_absolute_path(os.path.realpath(directory))
    try:
        before = os.stat(directory, follow_symlinks=True)
    except OSError as error:
        raise HelperError(
            "local-io",
            f"could not inspect custom palette directory: {error.strerror}",
            74,
        ) from error
    flags = (
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_NONBLOCK", 0)
    )
    descriptor = -1
    try:
        descriptor = os.open(canonical, flags)
        opened = os.fstat(descriptor)
        current = os.stat(directory, follow_symlinks=True)
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        raise HelperError(
            "local-io",
            f"could not open custom palette directory: {error.strerror}",
            74,
        ) from error
    identity = (opened.st_dev, opened.st_ino)
    if (
        not stat.S_ISDIR(opened.st_mode)
        or identity != (before.st_dev, before.st_ino)
        or identity != (current.st_dev, current.st_ino)
    ):
        os.close(descriptor)
        raise HelperError(
            "invalid-path",
            "custom palette directory changed while it was opened",
            64,
        )
    return descriptor, opened


def _palettes_read_custom_file(
    directory_descriptor: int,
    filename: str,
    request: dict[str, Any],
) -> bytes:
    if (
        not filename
        or "/" in filename
        or "\\" in filename
        or any(ord(character) < 32 or ord(character) == 127 for character in filename)
    ):
        raise HelperError("invalid-path", "custom palette filename is unsafe", 64)
    flags = (
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NONBLOCK", 0)
    )
    try:
        before = os.stat(
            filename, dir_fd=directory_descriptor, follow_symlinks=True
        )
        descriptor = os.open(filename, flags, dir_fd=directory_descriptor)
        try:
            opened = os.fstat(descriptor)
            identity = (opened.st_dev, opened.st_ino)
            if (
                not stat.S_ISREG(opened.st_mode)
                or opened.st_size < 1
                or opened.st_size > PALETTES_MAX_CUSTOM_FILE_BYTES
                or identity != (before.st_dev, before.st_ino)
                or opened.st_size != before.st_size
            ):
                raise HelperError(
                    "invalid-path",
                    "custom palette is not a stable bounded regular file",
                    64,
                )
            chunks: list[bytes] = []
            remaining = PALETTES_MAX_CUSTOM_FILE_BYTES + 1
            while remaining > 0:
                chunk = os.read(descriptor, min(64 * 1024, remaining))
                if not chunk:
                    break
                chunks.append(chunk)
                remaining -= len(chunk)
                _backend_ensure_live(request)
            after = os.fstat(descriptor)
        finally:
            os.close(descriptor)
        current = os.stat(
            filename, dir_fd=directory_descriptor, follow_symlinks=True
        )
    except HelperError:
        raise
    except OSError as error:
        raise HelperError(
            "local-io",
            f"could not read custom palette: {error.strerror}",
            74,
        ) from error
    payload = b"".join(chunks)
    if (
        (after.st_dev, after.st_ino) != identity
        or (current.st_dev, current.st_ino) != identity
        or after.st_size != opened.st_size
        or current.st_size != opened.st_size
        or len(payload) != opened.st_size
    ):
        raise HelperError(
            "size-limit",
            "custom palette changed while it was read",
            65,
        )
    return payload


def _palettes_scan_custom(request: dict[str, Any]) -> tuple[list[dict[str, Any]], int, str]:
    directory = request["custom_directory"]
    try:
        directory_descriptor, opened_directory = _palettes_open_custom_directory(directory)
    except HelperError as error:
        if not os.path.lexists(directory):
            return [], 0, ""
        return [], 0, _clean_field(error.message, PALETTES_MAX_ERROR_BYTES)
    try:
        try:
            names: list[str] = []
            with os.scandir(directory_descriptor) as entries:
                for index, entry in enumerate(entries):
                    if len(names) <= PALETTES_MAX_CUSTOM_CANDIDATES:
                        names.append(entry.name)
                    if index % 32 == 31:
                        _backend_ensure_live(request)
                    if len(names) > PALETTES_MAX_CUSTOM_CANDIDATES:
                        break
        except OSError as error:
            return [], 0, _clean_field(
                f"Could not enumerate Noctalia custom palettes: {error.strerror}",
                PALETTES_MAX_ERROR_BYTES,
            )
        try:
            current_directory = os.fstat(directory_descriptor)
            current_path = os.stat(directory, follow_symlinks=True)
        except OSError as error:
            return [], 0, _clean_field(
                f"Could not re-check Noctalia custom palettes: {error.strerror}",
                PALETTES_MAX_ERROR_BYTES,
            )
        identity = (opened_directory.st_dev, opened_directory.st_ino)
        if (
            not stat.S_ISDIR(current_directory.st_mode)
            or (current_directory.st_dev, current_directory.st_ino) != identity
            or (current_path.st_dev, current_path.st_ino) != identity
        ):
            return [], 0, "Noctalia's palettes path changed while it was enumerated"
        _backend_ensure_live(request)

        directory_truncated = len(names) > PALETTES_MAX_CUSTOM_CANDIDATES
        names = sorted(names[:PALETTES_MAX_CUSTOM_CANDIDATES])
        result: list[dict[str, Any]] = []
        seen: set[str] = set()
        candidates = 0
        invalid = 0
        for index, filename in enumerate(names):
            if not filename.endswith(".json"):
                continue
            candidates += 1
            stem = filename[:-5]
            preview = None
            if _palettes_valid_name(stem):
                try:
                    raw = _palettes_read_custom_file(
                        directory_descriptor, filename, request
                    )
                    decoded = json.loads(raw.decode("utf-8"))
                    preview = _palettes_custom_preview(decoded)
                except Cancelled:
                    raise
                except HelperError as error:
                    if error.kind == "timeout":
                        raise
                    preview = None
                except (UnicodeDecodeError, json.JSONDecodeError):
                    preview = None
            if preview is not None and stem not in seen and len(result) < PALETTES_MAX_ENTRIES:
                seen.add(stem)
                result.append({"name": stem, "preview": preview})
            else:
                invalid += 1
            if index % 16 == 15:
                _backend_ensure_live(request)
        result.sort(key=lambda entry: str(entry["name"]))
        problems: list[str] = []
        if directory_truncated:
            problems.append("custom palette directory exceeded the bounded scan limit")
        if candidates > PALETTES_MAX_ENTRIES:
            problems.append("custom palette inventory exceeded the 512-entry limit")
        if invalid:
            problems.append(f"{invalid} custom palette file(s) were invalid or outside limits")
        return result, invalid, _clean_field(
            "; ".join(problems), PALETTES_MAX_ERROR_BYTES
        )
    finally:
        os.close(directory_descriptor)


def _palettes_cache_candidate(path: str, now: int) -> tuple[dict[str, Any] | None, str]:
    if not os.path.lexists(path):
        return None, "missing"
    try:
        raw = _read_bounded_file(path, PALETTES_MAX_CACHE_BYTES)
        decoded = json.loads(raw.decode("utf-8"))
        if not isinstance(decoded, dict) or decoded.get("schema") != PALETTES_CACHE_SCHEMA:
            return None, "cache schema is invalid"
        fetched_at = decoded.get("fetched_at")
        if type(fetched_at) is not int or fetched_at <= 0 or fetched_at > now + 300:
            return None, "cache timestamp is invalid"
        entries = _palettes_community_catalog(decoded.get("entries"))
        return {
            "entries": entries,
            "fetched_at": fetched_at,
            "fetched_at_text": _clean_field(decoded.get("fetched_at_text", ""), 80),
            "raw": raw,
        }, ""
    except (HelperError, UnicodeDecodeError, json.JSONDecodeError) as error:
        return None, _clean_field(error, PALETTES_MAX_ERROR_BYTES) or "cache is invalid"


def _palettes_atomic_replace(path: str, payload: bytes) -> None:
    if not payload or len(payload) > PALETTES_MAX_CACHE_BYTES:
        raise HelperError("size-limit", "palette cache exceeds the 2 MiB storage limit", 65)
    parent = _existing_directory(os.path.dirname(path))
    if os.path.lexists(path):
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid():
            raise HelperError("invalid-path", "palette cache destination is unsafe", 65)
    temporary = _new_temporary(parent, ".wall-in-one-palettes-cache.")
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_TRUNC | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
        )
        try:
            _write_all(descriptor, payload)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.replace(temporary, path)
        _forget_temporary(temporary)
    except OSError as error:
        _remove_temporary(temporary)
        raise HelperError("local-io", f"could not install palette cache: {error.strerror}", 74) from error


def _palettes_write_cache(request: dict[str, Any], entries: list[dict[str, Any]], fetched_at: int, fetched_at_text: str) -> None:
    payload = _encode_json(
        {
            "schema": PALETTES_CACHE_SCHEMA,
            "fetched_at": fetched_at,
            "fetched_at_text": fetched_at_text,
            "entries": entries,
        },
        PALETTES_MAX_CACHE_BYTES,
    )
    previous, _error = _palettes_cache_candidate(request["cache_path"], int(time.time()))
    if previous is not None:
        _palettes_atomic_replace(request["cache_path"] + ".bak", previous["raw"])
    _palettes_atomic_replace(request["cache_path"], payload)


def _palettes_fetch_catalog(request: dict[str, Any]) -> list[dict[str, Any]]:
    global _ACTIVE_CHILD
    body = _new_temporary(request["transport_directory"], ".palettes-body.")
    command = [
        "curl", "--disable", "--silent", "--show-error", "--request", "GET",
        "--connect-timeout", "10", "--max-time", str(PALETTES_FETCH_TIMEOUT_SECONDS),
        "--max-filesize", str(PALETTES_MAX_BODY_BYTES), "--speed-limit", "1024", "--speed-time", "15",
        "--proto", "=https", "--proto-redir", "=https", "--max-redirs", "0", "--tlsv1.2",
        "--header", "Accept: application/json", "--user-agent", WALLHAVEN_USER_AGENT,
        "--output", body,
        "--write-out", "%{http_code}\t%{url_effective}\t%{content_type}\t%{size_download}",
        "--url", PALETTES_COMMUNITY_URL,
    ]
    environment = os.environ.copy()
    environment.pop("CURL_HOME", None)
    _backend_ensure_live(request)
    try:
        _ACTIVE_CHILD = subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=environment,
            preexec_fn=_curl_file_limit(PALETTES_MAX_BODY_BYTES),
        )
    except FileNotFoundError as error:
        _remove_temporary(body)
        raise HelperError("missing-curl", "curl is required by wall-in-one-backend", 127) from error
    try:
        stdout, stderr = _ACTIVE_CHILD.communicate(timeout=PALETTES_FETCH_TIMEOUT_SECONDS + 5)
    except subprocess.TimeoutExpired as error:
        _ACTIVE_CHILD.kill()
        _ACTIVE_CHILD.communicate()
        _remove_temporary(body)
        raise HelperError("timeout", "community palette request exceeded its deadline", 69) from error
    finally:
        return_code = _ACTIVE_CHILD.returncode
        _ACTIVE_CHILD = None
    if return_code != 0:
        _remove_temporary(body)
        detail = _clean_field(stderr.decode("utf-8", "replace"), 320)
        kind = "timeout" if return_code == 28 else "size-limit" if return_code in {63, 153} else "transport"
        raise HelperError(kind, detail or f"curl failed with code {return_code}", 69)
    try:
        fields = stdout.decode("ascii").split("\t")
    except UnicodeDecodeError as error:
        _remove_temporary(body)
        raise HelperError("protocol", "curl returned a non-ASCII transfer record", 70) from error
    if len(fields) != 4 or re.fullmatch(r"[0-9]{3}", fields[0]) is None:
        _remove_temporary(body)
        raise HelperError("protocol", "curl returned a malformed transfer record", 70)
    status_code = int(fields[0])
    effective_url = fields[1]
    content_type = fields[2].split(";", 1)[0].strip().lower()
    try:
        reported_bytes = int(float(fields[3]))
    except ValueError as error:
        _remove_temporary(body)
        raise HelperError("protocol", "curl returned an invalid byte count", 70) from error
    try:
        info = _lstat_regular(body, maximum=PALETTES_MAX_BODY_BYTES, minimum=1)
        if effective_url != PALETTES_COMMUNITY_URL:
            raise HelperError("redirects", "curl effective URL differed from the palette catalog URL", 69)
        if status_code < 200 or status_code >= 300:
            raise HelperError("remote", f"community palette endpoint returned HTTP {status_code}", 69)
        if content_type != "application/json":
            raise HelperError("content-type", f"unexpected response type {content_type or 'unknown'}", 65)
        if info.st_size != reported_bytes:
            raise HelperError("size-mismatch", "curl byte count did not match the palette response", 65)
        payload = _read_bounded_file(body, PALETTES_MAX_BODY_BYTES)
        if len(payload) != reported_bytes:
            raise HelperError("size-mismatch", "palette response changed before decoding", 65)
        decoded = json.loads(payload.decode("utf-8"))
        _backend_ensure_live(request)
        return _palettes_community_catalog(decoded)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise HelperError("response", f"community palette endpoint returned invalid JSON: {error}", 65) from error
    finally:
        _remove_temporary(body)


def _palettes_inventory(request: dict[str, Any]) -> dict[str, Any]:
    now = int(time.time())
    now_text = dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    custom, invalid_custom, custom_error = _palettes_scan_custom(request)
    primary, primary_error = _palettes_cache_candidate(request["cache_path"], now)
    selected = primary
    source = "primary" if primary is not None else "none"
    cache_error = ""
    if selected is None:
        backup, backup_error = _palettes_cache_candidate(request["cache_path"] + ".bak", now)
        if backup is not None:
            selected = backup
            source = "backup"
            cache_error = (
                "Primary palette cache is missing; using the last-known-good backup"
                if primary_error == "missing"
                else "Primary palette cache is invalid; using the last-known-good backup"
            )
        elif primary_error != "missing":
            cache_error = "Palette cache is invalid: " + primary_error
        elif backup_error != "missing":
            cache_error = "Palette cache backup is invalid: " + backup_error
    community = list(selected["entries"]) if selected is not None else []
    fetched_at = int(selected["fetched_at"]) if selected is not None else 0
    fetched_at_text = str(selected["fetched_at_text"]) if selected is not None else ""
    fresh = bool(fetched_at > 0 and now >= fetched_at and now - fetched_at < PALETTES_TTL_SECONDS)
    community_error = ""
    event = "cache-fresh" if fresh and not request["force_refresh"] else "refresh-started"
    network_attempted = request["force_refresh"] or not fresh
    if network_attempted:
        try:
            community = _palettes_fetch_catalog(request)
            fetched_at = int(time.time())
            fetched_at_text = dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            fresh = True
            source = "network"
            try:
                _palettes_write_cache(request, community, fetched_at, fetched_at_text)
                source = "primary"
                cache_error = ""
            except HelperError as error:
                cache_error = error.message
            event = "refresh-complete"
        except Cancelled:
            raise
        except HelperError as error:
            community_error = _clean_field(
                f"Community palette request failed ({error.kind}): {error.message}",
                PALETTES_MAX_ERROR_BYTES,
            )
            event = "refresh-failed"
    signature_payload = json.dumps(
        {"community": community, "custom": custom},
        ensure_ascii=True,
        separators=(",", ":"),
        sort_keys=True,
    ).encode("utf-8")
    _backend_ensure_live(request)
    return {
        "schema": BACKEND_PROTOCOL,
        "request_id": request["request_id"],
        "action": "palettes.inventory",
        "ok": True,
        "inventory": {
            "custom_directory": request["custom_directory"],
            "invalid_custom": invalid_custom,
            "custom_error": custom_error,
            "community_error": community_error,
            "cache_error": _clean_field(cache_error, PALETTES_MAX_ERROR_BYTES),
            "cache": {
                "loaded": bool(community),
                "source": source,
                "fetched_at": fetched_at,
                "fetched_at_text": fetched_at_text,
                "fresh": fresh,
                "ttl_seconds": PALETTES_TTL_SECONDS,
            },
            "network_attempted": network_attempted,
            "last_event": event,
            "last_refresh_at": now_text if network_attempted else "",
            "last_success_at": fetched_at_text,
            "custom_refreshed_at": now_text,
            "signature": hashlib.sha256(signature_payload).hexdigest(),
            "community": community,
            "custom": custom,
        },
    }


def _palettes_page_inventory(request: dict[str, Any], result: dict[str, Any]) -> tuple[dict[str, Any], list[str]]:
    inventory = result.get("inventory")
    if result.get("ok") is not True or not isinstance(inventory, dict):
        return result, []
    created: list[str] = []
    sections: dict[str, Any] = {}
    try:
        for section in ("community", "custom"):
            items = inventory.pop(section, None)
            if not isinstance(items, list):
                raise HelperError("internal", f"palette section {section} is invalid", 70)
            total_pages = (len(items) + PALETTES_PAGE_SIZE - 1) // PALETTES_PAGE_SIZE
            descriptors: list[dict[str, Any]] = []
            for page in range(1, total_pages + 1):
                first = (page - 1) * PALETTES_PAGE_SIZE
                payload = _encode_json(
                    {
                        "schema": BACKEND_PROTOCOL,
                        "request_id": request["request_id"],
                        "action": "palettes.page",
                        "section": section,
                        "page": page,
                        "total_pages": total_pages,
                        "items": items[first : first + PALETTES_PAGE_SIZE],
                    },
                    BACKEND_MAX_PAGE_BYTES,
                )
                filename = f".wall-in-one-palettes-{request['request_id']}-{section}-{page}.json"
                path = request["transport_directory"] + "/" + filename
                _backend_ensure_live(request)
                size = _write_no_replace(path, payload, BACKEND_MAX_PAGE_BYTES)
                created.append(path)
                descriptors.append({"page": page, "path": path, "bytes": size, "count": min(PALETTES_PAGE_SIZE, len(items) - first)})
            sections[section] = {"count": len(items), "pages": descriptors}
        inventory["page_size"] = PALETTES_PAGE_SIZE
        inventory["sections"] = sections
        _encode_json(result, BACKEND_MAX_RESPONSE_BYTES)
        return result, created
    except BaseException:
        _backend_remove_pages(created)
        raise


def _backend_library_scan(request: dict[str, Any]) -> dict[str, Any]:
    registry = _backend_load_pair_registry(request["runtime_path"])

    def ensure_live() -> None:
        _backend_ensure_live(request)

    media_candidates: list[dict[str, str]] = []
    seen_media: set[tuple[str, str]] = set()
    if request["image_root"]:
        _backend_append_candidates(media_candidates, request["wallhaven_directory"], "image", "managed-wallhaven", "Wallhaven", seen_media, ensure_live)
        _backend_append_candidates(media_candidates, request["automatic_stills_directory"], "image", "managed-auto", "Wall-in-One", seen_media, ensure_live)
        _backend_append_candidates(media_candidates, request["image_root"], "image", "user", "local", seen_media, ensure_live)
    if request["video_root"]:
        _backend_append_candidates(media_candidates, request["motionbgs_directory"], "video", "managed-motionbgs", "MotionBGS", seen_media, ensure_live)
        _backend_append_candidates(media_candidates, request["video_root"], "video", "user", "local", seen_media, ensure_live)
    media_candidates.sort(key=lambda candidate: candidate["path"])
    stills: list[dict[str, Any]] = []
    videos: list[dict[str, Any]] = []
    provider_installs: dict[str, dict[str, str]] = {"wallhaven": {}, "motionbgs": {}}
    representative_stills: dict[str, dict[str, str]] = {"video": {}, "workshop": {}}
    for index, candidate in enumerate(media_candidates):
        if len(stills) >= BACKEND_MAX_LIBRARY_ITEMS and len(videos) >= BACKEND_MAX_LIBRARY_ITEMS:
            break
        entry = _backend_media_entry(
            candidate,
            request["instance_id"],
            request["image_root"],
            request["video_root"],
            registry,
            provider_installs,
            representative_stills,
        )
        if entry is not None:
            if entry["media_type"] == "image" and len(stills) < BACKEND_MAX_LIBRARY_ITEMS:
                stills.append(entry)
            elif entry["media_type"] == "video" and len(videos) < BACKEND_MAX_LIBRARY_ITEMS:
                videos.append(entry)
        if index % 32 == 31:
            _backend_ensure_live(request)
    workshops: list[dict[str, Any]] = []
    if request["image_root"]:
        workshops, workshop_representatives = _backend_scan_workshops(
            request["workshop_roots"], registry, ensure_live
        )
        representative_stills["workshop"] = workshop_representatives
    stills.sort(key=lambda entry: str(entry["name"]).lower())
    videos.sort(key=lambda entry: str(entry["name"]).lower())
    _backend_ensure_live(request)
    return {
        "schema": BACKEND_PROTOCOL,
        "request_id": request["request_id"],
        "action": "library.scan",
        "ok": True,
        "library": {
            "stills": stills,
            "videos": videos,
            "workshops": workshops,
            "provider_installs": provider_installs,
            "representative_stills": representative_stills,
        },
    }


def _backend_remove_pages(paths: list[str]) -> None:
    for path in paths:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        except OSError:
            pass


def _backend_page_library(
    request: dict[str, Any], result: dict[str, Any]
) -> tuple[dict[str, Any], list[str]]:
    library = result.get("library")
    if result.get("ok") is not True or not isinstance(library, dict):
        return result, []
    created: list[str] = []
    sections: dict[str, Any] = {}
    try:
        for section in ("stills", "videos", "workshops"):
            items = library.get(section)
            if not isinstance(items, list):
                raise HelperError("internal", f"library section {section} is invalid", 70)
            total_pages = (len(items) + BACKEND_LIBRARY_PAGE_SIZE - 1) // BACKEND_LIBRARY_PAGE_SIZE
            descriptors: list[dict[str, Any]] = []
            for page in range(1, total_pages + 1):
                first = (page - 1) * BACKEND_LIBRARY_PAGE_SIZE
                chunk = items[first : first + BACKEND_LIBRARY_PAGE_SIZE]
                page_payload = _encode_json(
                    {
                        "schema": BACKEND_PROTOCOL,
                        "request_id": request["request_id"],
                        "action": "library.page",
                        "section": section,
                        "page": page,
                        "total_pages": total_pages,
                        "items": chunk,
                    },
                    BACKEND_MAX_PAGE_BYTES,
                )
                filename = (
                    ".wall-in-one-library-"
                    + request["request_id"]
                    + "-"
                    + section
                    + "-"
                    + str(page)
                    + ".json"
                )
                page_path = request["transport_directory"] + "/" + filename
                _backend_ensure_live(request)
                size = _write_no_replace(page_path, page_payload, BACKEND_MAX_PAGE_BYTES)
                created.append(page_path)
                descriptors.append(
                    {
                        "page": page,
                        "path": page_path,
                        "bytes": size,
                        "count": len(chunk),
                    }
                )
            sections[section] = {
                "count": len(items),
                "pages": descriptors,
            }
        manifest = {
            "schema": BACKEND_PROTOCOL,
            "request_id": request["request_id"],
            "action": "library.scan",
            "ok": True,
            "library": {
                "schema": BACKEND_PROTOCOL,
                "page_size": BACKEND_LIBRARY_PAGE_SIZE,
                "sections": sections,
            },
        }
        # Fail before installing the main response if path-heavy descriptors
        # would exceed the bridge's single-callback decode ceiling.
        _encode_json(manifest, BACKEND_MAX_RESPONSE_BYTES)
        return manifest, created
    except BaseException:
        _backend_remove_pages(created)
        raise


def _backend_error_response(request: dict[str, Any], error: HelperError) -> dict[str, Any]:
    return {
        "schema": BACKEND_PROTOCOL,
        "request_id": request["request_id"],
        "action": request["action"],
        "ok": False,
        "error": {"kind": error.kind, "message": error.message},
    }


def _backend_rpc(request_path: str, response_path: str, guard_path: str) -> int:
    request = _load_backend_request(request_path)
    response = _safe_absolute_path(response_path)
    if os.path.dirname(response) != request["transport_directory"]:
        raise HelperError("invalid-path", "response must be a direct transport child", 64)
    guard = _safe_absolute_path(guard_path)
    if guard != request["guard_path"]:
        raise HelperError("invalid-path", "command guard does not match the request envelope", 64)
    _backend_require_guard(guard)
    if os.path.lexists(response):
        raise HelperError("conflict", "response path already exists", 73)
    is_wallhaven = str(request["action"]).startswith("wallhaven.")
    lock = _wallhaven_open_lock(request) if is_wallhaven else _backend_open_lock(request)
    page_paths: list[str] = []
    installed: tuple[str, str] | None = None
    response_maximum = (
        BACKEND_MAX_PROVIDER_RESPONSE_BYTES if is_wallhaven else BACKEND_MAX_RESPONSE_BYTES
    )
    try:
        try:
            _backend_ensure_live(request)
            if request["action"] == "library.scan":
                result = _backend_library_scan(request)
                result, page_paths = _backend_page_library(request, result)
            elif request["action"] == "palettes.inventory":
                result = _palettes_inventory(request)
                result, page_paths = _palettes_page_inventory(request, result)
            elif request["action"] == "preview.sync":
                result = _preview_sync(request)
            elif request["action"] == "wallhaven.search":
                result = _wallhaven_search(request)
            elif request["action"] == "wallhaven.detail":
                result = _wallhaven_detail(request)
            elif request["action"] == "wallhaven.download":
                result, installed = _wallhaven_download(request)
            else:
                result = _wallhaven_clear(request)
        except Cancelled:
            raise
        except HelperError as error:
            _backend_remove_pages(page_paths)
            page_paths = []
            result = _backend_error_response(request, error)
        try:
            _backend_ensure_live(request)
            payload = _encode_json(result, response_maximum)
            size = _write_no_replace(response, payload, response_maximum)
            _backend_ensure_live(request)
        except BaseException:
            try:
                os.unlink(response)
            except OSError:
                pass
            _backend_remove_pages(page_paths)
            if installed is not None:
                for installed_path in installed:
                    try:
                        os.unlink(installed_path)
                    except OSError:
                        pass
            raise
    finally:
        credential = request.get("api_key_path", "")
        if credential:
            try:
                os.unlink(credential)
            except OSError:
                pass
        try:
            fcntl.flock(lock, fcntl.LOCK_UN)
        finally:
            os.close(lock)
    _emit_fields(BACKEND_RPC_WIRE, "ok", request["request_id"], response, size)
    return 0


