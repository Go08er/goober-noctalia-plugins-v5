        _deadline_monotonic=time.monotonic() + timeout / 1000.0,
        transport_directory=transport,
        data_directory=data_directory,
        guard_path=guard,
        cache_path=cache_path,
        custom_directory=custom_directory,
        force_refresh=_bool_field(decoded.get("force_refresh"), "force_refresh"),
    )
    return decoded


def _validate_library_request(decoded: dict[str, Any], request_path: str) -> dict[str, Any]:
    required = {
        "schema",
        "request_id",
        "action",
        "transport_directory",
        "data_directory",
        "guard_path",
        "operation_timeout_ms",
        "instance_id",
        "image_root",
        "video_root",
        "workshop_roots",
        "wallhaven_directory",
        "automatic_stills_directory",
        "motionbgs_directory",
        "runtime_path",
    }
    if not isinstance(decoded, dict) or set(decoded) != required or decoded.get("schema") != BACKEND_PROTOCOL:
        raise HelperError("invalid-request", "backend request must be an exact schema-1 object", 64)
    request_id = decoded.get("request_id")
    if not isinstance(request_id, str) or BACKEND_REQUEST_ID_RE.fullmatch(request_id) is None:
        raise HelperError("invalid-request", "request_id has an invalid wire format", 64)
    if decoded.get("action") != "library.scan":
        raise HelperError("invalid-request", "unsupported backend action", 64)
    transport = _existing_directory(decoded.get("transport_directory"))
    if os.path.dirname(request_path) != transport:
        raise HelperError("invalid-path", "request must be a direct child of its transport directory", 64)
    data_directory = _existing_directory(decoded.get("data_directory"), writable=False)
    guard = _safe_absolute_path(decoded.get("guard_path"))
    if os.path.dirname(guard) != transport or BACKEND_GUARD_NAME_RE.fullmatch(os.path.basename(guard)) is None:
        raise HelperError("invalid-path", "backend guard must be a named transport child", 64)
    runtime_path = _safe_absolute_path(decoded.get("runtime_path"))
    if runtime_path != data_directory + "/runtime.json":
        raise HelperError("invalid-path", "runtime_path must name data_directory/runtime.json", 64)
    instance_id = decoded.get("instance_id")
    if not isinstance(instance_id, str) or BACKEND_INSTANCE_ID_RE.fullmatch(instance_id) is None:
        raise HelperError("invalid-request", "instance_id has an invalid wire format", 64)
    timeout = _int_field(
        decoded.get("operation_timeout_ms"),
        "operation_timeout_ms",
        BACKEND_MIN_OPERATION_TIMEOUT_MS,
        BACKEND_LIBRARY_MAX_OPERATION_TIMEOUT_MS,
    )
    image_root = _backend_optional_root(decoded.get("image_root"), "image_root")
    video_root = _backend_optional_root(decoded.get("video_root"), "video_root")
    expected_wallhaven = image_root + "/Wall-in-One/Wallhaven" if image_root else ""
    expected_automatic = image_root + "/Wall-in-One/Automatic Stills" if image_root else ""
    expected_motion = video_root + "/Wall-in-One/MotionBGS" if video_root else ""
    for name, expected in (
        ("wallhaven_directory", expected_wallhaven),
        ("automatic_stills_directory", expected_automatic),
        ("motionbgs_directory", expected_motion),
    ):
        if decoded.get(name) != expected:
            raise HelperError("invalid-path", f"{name} does not match its configured media root", 64)
    raw_workshop_roots = decoded.get("workshop_roots")
    if not isinstance(raw_workshop_roots, list) or len(raw_workshop_roots) > BACKEND_MAX_WORKSHOP_ROOTS:
        raise HelperError("invalid-request", "workshop_roots exceeds its bounded array", 64)
    workshop_roots: list[str] = []
    seen_roots: set[str] = set()
    for raw_root in raw_workshop_roots:
        if not isinstance(raw_root, str):
            raise HelperError("invalid-request", "workshop root must be an absolute path", 64)
        root = _backend_readable_directory(raw_root)
        if root and root not in seen_roots:
            seen_roots.add(root)
            workshop_roots.append(root)
    decoded.update(
        _request_path=request_path,
        _deadline_monotonic=time.monotonic() + timeout / 1000.0,
        transport_directory=transport,
        data_directory=data_directory,
        guard_path=guard,
        runtime_path=runtime_path,
        image_root=image_root,
        video_root=video_root,
        workshop_roots=workshop_roots,
        wallhaven_directory=_backend_readable_directory(expected_wallhaven) if expected_wallhaven else "",
        automatic_stills_directory=_backend_readable_directory(expected_automatic) if expected_automatic else "",
        motionbgs_directory=_backend_readable_directory(expected_motion) if expected_motion else "",
    )
    return decoded


def _load_backend_request(path: str) -> dict[str, Any]:
    request_path = _safe_absolute_path(path)
    raw = _read_bounded_file(request_path, BACKEND_MAX_REQUEST_BYTES)
    try:
        decoded = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise HelperError(
            "invalid-request", f"request is not bounded UTF-8 JSON: {error}", 64
        ) from error
    if not isinstance(decoded, dict) or decoded.get("schema") != BACKEND_PROTOCOL:
        raise HelperError("invalid-request", "backend request must be a schema-1 object", 64)
    request_id = decoded.get("request_id")
    if not isinstance(request_id, str) or BACKEND_REQUEST_ID_RE.fullmatch(request_id) is None:
        raise HelperError("invalid-request", "request_id has an invalid wire format", 64)
    if decoded.get("action") == "library.scan":
        return _validate_library_request(decoded, request_path)
    if decoded.get("action") == "preview.sync":
        return _preview_validate_request(decoded, request_path)
    if decoded.get("action") == "palettes.inventory":
        return _palettes_validate_request(decoded, request_path)
    if decoded.get("action") in {
        "wallhaven.search",
        "wallhaven.detail",
        "wallhaven.download",
        "wallhaven.clear",
    }:
        try:
            return _wallhaven_validate_request(decoded, request_path)
        except BaseException:
            # Once a private header file has passed the same exact validation
            # used by the request loader, it is an ephemeral credential owned
            # by this invocation. Do not strand it when a later filter or
            # destination check rejects the request.
            try:
                transport = _existing_directory(decoded.get("transport_directory"))
                credential = _wallhaven_credential(decoded.get("api_key_path"), transport)
                if credential:
                    os.unlink(credential)
            except (HelperError, OSError):
                pass
            raise
    raise HelperError("invalid-request", "unsupported backend action", 64)


def _backend_require_guard(path: str) -> None:
    try:
        payload = _read_bounded_file(path, len(BACKEND_GUARD_CONTENT), minimum=len(BACKEND_GUARD_CONTENT))
    except HelperError as error:
        raise Cancelled() from error
    if payload != BACKEND_GUARD_CONTENT:
        raise Cancelled()


def _backend_ensure_live(request: dict[str, Any]) -> None:
    _backend_require_guard(request["guard_path"])
    deadline = request.get("_deadline_monotonic")
    if type(deadline) is not float or deadline - time.monotonic() < 0.25:
        raise HelperError("timeout", "backend operation exhausted its deadline", 69)


def _backend_open_lock(request: dict[str, Any]) -> int:
    path = request["transport_directory"] + "/" + BACKEND_LIBRARY_LOCK_NAME
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = -1
    try:
        descriptor = os.open(path, flags, 0o600)
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise HelperError("invalid-path", "backend lock file is unsafe", 65)
        os.fchmod(descriptor, 0o600)
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return descriptor
            except BlockingIOError:
                _backend_ensure_live(request)
                time.sleep(0.05)
    except HelperError:
        if descriptor >= 0:
            os.close(descriptor)
        raise
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        raise HelperError("local-io", f"could not acquire backend lock: {error.strerror}", 74) from error


def _preview_key(item: dict[str, str]) -> str:
    return item["provider"] + ":" + item["id"]


def _preview_owned_filename(value: Any, provider: str = "", identifier: str = "") -> bool:
    if not isinstance(value, str) or PREVIEW_OWNED_FILENAME_RE.fullmatch(value) is None:
        return False
    if provider and identifier and not value.startswith(provider + "-" + identifier + "-"):
        return False
    return True


def _preview_remove_owned(cache_directory: str, filename: Any) -> bool:
    if not _preview_owned_filename(filename):
        return False
    path = cache_directory + "/" + filename
    if not _backend_direct_child(path, cache_directory):
        return False
    try:
        os.unlink(path)
        return True
    except FileNotFoundError:
        return False
    except OSError:
        return False


def _preview_normalize_entry(
    cache_directory: str, key: Any, value: Any
) -> dict[str, Any] | None:
    required = {"provider", "id", "url", "filename", "bytes", "last_used"}
    if not isinstance(key, str) or not isinstance(value, dict) or set(value) != required:
        if isinstance(value, dict):
            _preview_remove_owned(cache_directory, value.get("filename"))
        return None
    try:
        item = _preview_item(
            {"provider": value.get("provider"), "id": value.get("id"), "url": value.get("url")}
        )
    except HelperError:
        _preview_remove_owned(cache_directory, value.get("filename"))
        return None
    filename = value.get("filename")
    byte_count = value.get("bytes")
    last_used = value.get("last_used")
    if (
        key != _preview_key(item)
        or not _preview_owned_filename(filename, item["provider"], item["id"])
        or type(byte_count) is not int
        or not 1 <= byte_count <= PREVIEW_MAX_FILE_BYTES
        or type(last_used) not in (int, float)
        or isinstance(last_used, bool)
        or not math.isfinite(float(last_used))
        or last_used < 0
    ):
        _preview_remove_owned(cache_directory, filename)
        return None
    path = cache_directory + "/" + filename
    try:
        info = os.lstat(path)
    except OSError:
        return None
    if (
        not stat.S_ISREG(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_uid != os.getuid()
        or info.st_size != byte_count
    ):
        _preview_remove_owned(cache_directory, filename)
        return None
    return {
        "provider": item["provider"],
        "id": item["id"],
        "url": item["url"],
        "filename": filename,
        "bytes": byte_count,
        "last_used": math.floor(float(last_used)),
    }


def _preview_load_manifest(request: dict[str, Any]) -> tuple[dict[str, Any], bool]:
    cache_directory = request["cache_directory"]
    path = cache_directory + "/" + PREVIEW_MANIFEST_NAME
    if not os.path.lexists(path):
        return {"schema": PREVIEW_CACHE_SCHEMA, "entries": {}}, True
    try:
        info = os.lstat(path)
    except OSError as error:
        raise HelperError("local-io", f"could not inspect preview manifest: {error.strerror}", 74) from error
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid():
        raise HelperError("invalid-path", "preview manifest must be a current-user regular file", 65)
    if info.st_size < 1 or info.st_size > PREVIEW_MAX_MANIFEST_BYTES:
        return {"schema": PREVIEW_CACHE_SCHEMA, "entries": {}}, True
    try:
        decoded = json.loads(_read_bounded_file(path, PREVIEW_MAX_MANIFEST_BYTES).decode("utf-8"))
    except (HelperError, UnicodeDecodeError, json.JSONDecodeError):
        return {"schema": PREVIEW_CACHE_SCHEMA, "entries": {}}, True
    raw_entries = decoded.get("entries") if isinstance(decoded, dict) else None
    if (
        not isinstance(decoded, dict)
        or decoded.get("schema") != PREVIEW_CACHE_SCHEMA
        or not isinstance(raw_entries, dict)
    ):
        return {"schema": PREVIEW_CACHE_SCHEMA, "entries": {}}, True
    entries: dict[str, dict[str, Any]] = {}
    seen_filenames: set[str] = set()
    changed = False
    for key in sorted(raw_entries):
        entry = _preview_normalize_entry(cache_directory, key, raw_entries[key])
        if entry is None or entry["filename"] in seen_filenames:
            changed = True
            continue
        seen_filenames.add(entry["filename"])
        entries[key] = entry
    return {"schema": PREVIEW_CACHE_SCHEMA, "entries": entries}, changed


def _preview_prune(cache_directory: str, manifest: dict[str, Any]) -> bool:
    entries = manifest["entries"]
    ordered = sorted(
        entries,
        key=lambda key: (entries[key]["last_used"], key),
    )
    total = sum(entry["bytes"] for entry in entries.values())
    changed = False
    while len(ordered) > PREVIEW_MAX_ENTRIES or total > PREVIEW_MAX_CACHE_BYTES:
        key = ordered.pop(0)
        entry = entries.pop(key)
        total -= entry["bytes"]
        _preview_remove_owned(cache_directory, entry["filename"])
        changed = True
    return changed


def _preview_cleanup_orphans(
    request: dict[str, Any], manifest: dict[str, Any]
) -> bool:
    cache_directory = request["cache_directory"]
    referenced = {entry["filename"] for entry in manifest["entries"].values()}
    changed = False
    try:
        with os.scandir(cache_directory) as directory_entries:
            for index, directory_entry in enumerate(directory_entries, start=1):
                if index % 32 == 0:
                    _backend_ensure_live(request)
                name = directory_entry.name
                removable = (
                    (_preview_owned_filename(name) and name not in referenced)
                    or PREVIEW_STAGING_RE.fullmatch(name) is not None
                    or name == "manifest.json.tmp"
                    or re.fullmatch(r"\.preview-manifest\.[A-Za-z0-9_-]+", name) is not None
                )
                if not removable:
                    continue
                path = cache_directory + "/" + name
                if not _backend_direct_child(path, cache_directory):
                    continue
                try:
                    os.unlink(path)
                    changed = True
                except FileNotFoundError:
                    pass
                except IsADirectoryError:
                    pass
                except OSError:
                    pass
    except OSError as error:
        raise HelperError("local-io", f"could not scan preview cache: {error.strerror}", 74) from error
    _backend_ensure_live(request)
    return changed


def _preview_save_manifest(request: dict[str, Any], manifest: dict[str, Any]) -> None:
    cache_directory = request["cache_directory"]
    destination = cache_directory + "/" + PREVIEW_MANIFEST_NAME
    payload = _encode_json(manifest, PREVIEW_MAX_MANIFEST_BYTES)
    if os.path.lexists(destination):
        info = os.lstat(destination)
        if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid():
            raise HelperError("invalid-path", "preview manifest changed to an unsafe file", 65)
    temporary = _new_temporary(cache_directory, ".preview-manifest.")
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_TRUNC | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
        )
        try:
            _write_all(descriptor, payload)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        _backend_ensure_live(request)
        os.replace(temporary, destination)
        _forget_temporary(temporary)
    except HelperError:
        raise
    except OSError as error:
        raise HelperError("local-io", f"could not save preview manifest: {error.strerror}", 74) from error


def _preview_validate_helper(path: str) -> None:
    try:
        info = os.lstat(path)
    except FileNotFoundError as error:
        raise HelperError("missing-helper", "provider-thumbnail is unavailable", 69) from error
    except OSError as error:
        raise HelperError("local-io", f"could not inspect provider-thumbnail: {error.strerror}", 74) from error
    if (
        not stat.S_ISREG(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or not 1 <= info.st_size <= PREVIEW_MAX_HELPER_BYTES
        or not os.access(path, os.R_OK | os.X_OK)
    ):
        raise HelperError("invalid-helper", "provider-thumbnail is not a safe executable file", 65)


def _preview_staging_path(request: dict[str, Any]) -> str:
    milliseconds = int(time.time() * 1000)
    sequence_base = (os.getpid() * 16) % 1_000_000_000_000
    for attempt in range(1, 17):
        name = f".wall-in-one-preview-{milliseconds}-{sequence_base + attempt}.stage"
        path = request["cache_directory"] + "/" + name
        if not os.path.lexists(path):
            return path
    raise HelperError("conflict", "could not allocate a preview staging file", 73)


def _preview_run_helper(
    request: dict[str, Any], item: dict[str, str], staging: str
) -> dict[str, Any]:
    global _ACTIVE_CHILD
    helper = request["thumbnail_helper"]
    _preview_validate_helper(helper)
    command = ["bash", helper, "fetch", item["provider"], item["url"], staging]
    try:
        _ACTIVE_CHILD = subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except OSError as error:
        raise HelperError("helper", f"could not start provider-thumbnail: {error.strerror}", 69) from error
    try:
        while _ACTIVE_CHILD.poll() is None:
            try:
                _backend_ensure_live(request)
            except BaseException:
                _ACTIVE_CHILD.terminate()
                try:
                    _ACTIVE_CHILD.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    _ACTIVE_CHILD.kill()
                    _ACTIVE_CHILD.wait()
                raise
            time.sleep(0.05)
        stdout, stderr = _ACTIVE_CHILD.communicate()
        return_code = _ACTIVE_CHILD.returncode
    finally:
        _ACTIVE_CHILD = None
    lines = [line for line in stdout.decode("utf-8", "replace").splitlines() if line]
    output = lines[-1] if lines else ""
    fields = output.split("\t")
    if return_code != 0 or len(fields) < 2 or fields[:2] != [PREVIEW_PROTOCOL, "ok"]:
        if len(fields) == 5 and fields[:2] == [PREVIEW_PROTOCOL, "error"]:
            raise HelperError(
                _clean_field(fields[2], 80),
                _clean_field(fields[4], 320) or "provider-thumbnail failed",
                69,
            )
        detail = _clean_field(stderr.decode("utf-8", "replace"), 320)
        raise HelperError("helper", detail or "provider-thumbnail returned an invalid result", 69)
    if len(fields) != 8:
        raise HelperError("protocol", "provider-thumbnail returned a malformed result", 70)
    _protocol, _outcome, provider, status, effective_url, content_type, byte_text, path = fields
    try:
        status_code = int(status)
        byte_count = int(byte_text)
    except ValueError as error:
        raise HelperError("protocol", "provider-thumbnail returned invalid numeric metadata", 70) from error
    if (
        provider != item["provider"]
        or not 200 <= status_code < 300
        or effective_url != item["url"]
        or path != staging
        or content_type not in {"image/jpeg", "image/png", "image/webp"}
        or not 1 <= byte_count <= PREVIEW_MAX_FILE_BYTES
    ):
        raise HelperError("protocol", "provider-thumbnail returned mismatched metadata", 70)
    try:
        info = os.lstat(staging)
    except OSError as error:
        raise HelperError("local-io", "provider-thumbnail output is unavailable", 74) from error
    if (
        not stat.S_ISREG(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_uid != os.getuid()
        or info.st_size != byte_count
    ):
        raise HelperError("protocol", "provider-thumbnail output does not match its metadata", 70)
    with open(staging, "rb") as stream:
        prefix = stream.read(16)
        stream.seek(max(0, byte_count - 12))
        suffix = stream.read(12)
    if content_type == "image/jpeg":
        signature_ok = prefix.startswith(b"\xff\xd8\xff") and suffix.endswith(b"\xff\xd9")
        extension = "jpg"
    elif content_type == "image/png":
        signature_ok = prefix.startswith(b"\x89PNG\r\n\x1a\n") and suffix == b"\x00\x00\x00\x00IEND\xaeB`\x82"
        extension = "png"
    else:
        declared = int.from_bytes(prefix[4:8], "little") + 8 if len(prefix) >= 12 else 0
        signature_ok = (
            len(prefix) >= 16
            and prefix[:4] == b"RIFF"
            and prefix[8:12] == b"WEBP"
            and prefix[12:16] in {b"VP8 ", b"VP8L", b"VP8X"}
            and declared == byte_count
        )
        extension = "webp"
    if not signature_ok:
        raise HelperError("content-type", "provider-thumbnail output signature is invalid", 65)
    _backend_ensure_live(request)
    return {"bytes": byte_count, "content_type": content_type, "extension": extension}


def _preview_promote(
    request: dict[str, Any], item: dict[str, str], staging: str, extension: str
) -> str:
    milliseconds = int(time.time() * 1000)
    sequence_base = (os.getpid() * 32) % 1_000_000_000_000
    for attempt in range(1, 33):
        filename = (
            item["provider"] + "-" + item["id"] + "-" + str(milliseconds)
            + "-" + str(sequence_base + attempt) + "." + extension
        )
        destination = request["cache_directory"] + "/" + filename
        if os.path.lexists(destination):
            continue
        _backend_ensure_live(request)
        try:
            os.link(staging, destination, follow_symlinks=False)
        except FileExistsError:
            continue
        except OSError as error:
            raise HelperError("local-io", f"could not install preview: {error.strerror}", 74) from error
        try:
            os.unlink(staging)
            _backend_ensure_live(request)
        except BaseException:
            try:
                os.unlink(destination)
            except OSError:
                pass
            raise
        return filename
    raise HelperError("conflict", "could not allocate a preview cache filename", 73)


def _preview_sync(request: dict[str, Any]) -> dict[str, Any]:
    manifest, changed = _preview_load_manifest(request)
    cache_directory = request["cache_directory"]
    changed = _preview_cleanup_orphans(request, manifest) or changed
    entries: dict[str, dict[str, Any]] = manifest["entries"]
    current_maximum = max(
        (entry["last_used"] for entry in entries.values()), default=0
    )
    touched_at = max(int(time.time()), current_maximum + 1)
    response_items: list[dict[str, Any]] = []
    missing: list[tuple[int, dict[str, str]]] = []
    for index, item in enumerate(request["items"], start=1):
        key = _preview_key(item)
        entry = entries.get(key)
        if isinstance(entry, dict) and entry["url"] == item["url"]:
            if entry["last_used"] != touched_at:
                entry["last_used"] = touched_at
                changed = True
            response_items.append(
                {
                    "index": index,
                    "state": "ready",
                    "filename": entry["filename"],
                    "cached": True,
                }
            )
            continue
        if isinstance(entry, dict):
            _preview_remove_owned(cache_directory, entry["filename"])
            entries.pop(key, None)
            changed = True
        response_items.append({"index": index, "state": "pending"})
        missing.append((index, item))

    installed_filename = ""
    if missing:
        first_index, selected = missing[0]
        selected_key = _preview_key(selected)
        staging = _preview_staging_path(request)
        try:
            transport = _preview_run_helper(request, selected, staging)
            installed_filename = _preview_promote(
                request, selected, staging, transport["extension"]
            )
            entries[selected_key] = {
                "provider": selected["provider"],
                "id": selected["id"],
                "url": selected["url"],
                "filename": installed_filename,
                "bytes": transport["bytes"],
                "last_used": touched_at,
            }
            for position, item in enumerate(request["items"]):
                if _preview_key(item) == selected_key and item["url"] == selected["url"]:
                    response_items[position] = {
                        "index": position + 1,
                        "state": "ready",
                        "filename": installed_filename,
                        "cached": False,
                    }
            changed = True
        except Cancelled:
            try:
                os.unlink(staging)
            except OSError:
                pass
            raise
        except HelperError as error:
            try:
                os.unlink(staging)
            except OSError:
                pass
            for position, item in enumerate(request["items"]):
                if _preview_key(item) == selected_key and item["url"] == selected["url"]:
                    response_items[position] = {
                        "index": position + 1,
                        "state": "error",
                        "kind": error.kind,
                        "error": error.message,
                    }

    changed = _preview_prune(cache_directory, manifest) or changed
    changed = _preview_cleanup_orphans(request, manifest) or changed
    try:
        if changed or not os.path.lexists(cache_directory + "/" + PREVIEW_MANIFEST_NAME):
            _preview_save_manifest(request, manifest)
    except BaseException:
        if installed_filename:
            _preview_remove_owned(cache_directory, installed_filename)
        raise
    live_filenames = {entry["filename"] for entry in entries.values()}
    for position, result in enumerate(response_items):
        if result.get("state") == "ready" and result.get("filename") not in live_filenames:
            response_items[position] = {"index": result["index"], "state": "pending"}
    return {
        "schema": BACKEND_PROTOCOL,
        "request_id": request["request_id"],
        "action": "preview.sync",
        "ok": True,
        "items": response_items,
        "pending_count": sum(item["state"] == "pending" for item in response_items),
    }


def _wallhaven_open_lock(request: dict[str, Any]) -> int:
    path = request["transport_directory"] + "/" + WALLHAVEN_RATE_LOCK
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = -1
    try:
        descriptor = os.open(path, flags, 0o600)
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise HelperError("invalid-path", "Wallhaven lock file is unsafe", 65)
        os.fchmod(descriptor, 0o600)
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return descriptor
            except BlockingIOError:
                _backend_ensure_live(request)
                time.sleep(0.05)
    except HelperError:
        if descriptor >= 0:
            os.close(descriptor)
        raise
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        raise HelperError("local-io", f"could not acquire Wallhaven lock: {error.strerror}", 74) from error


def _wallhaven_rate_timestamp(request: dict[str, Any]) -> float:
    path = request["transport_directory"] + "/" + WALLHAVEN_RATE_PATH
    if not os.path.lexists(path):
        return 0.0
    try:
        info = os.lstat(path)
    except OSError as error:
        raise HelperError("local-io", f"could not inspect Wallhaven rate state: {error.strerror}", 74) from error
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid():
        raise HelperError("invalid-path", "Wallhaven rate state is unsafe", 65)
    try:
        raw = _read_bounded_file(path, 64).decode("ascii").strip()
        value = float(raw)
    except (HelperError, UnicodeDecodeError, ValueError):
        return 0.0
    return value if math.isfinite(value) and value > 0 else 0.0


def _wallhaven_store_rate_timestamp(request: dict[str, Any], value: float) -> None:
    directory = request["transport_directory"]
    destination = directory + "/" + WALLHAVEN_RATE_PATH
    temporary = _new_temporary(directory, ".wall-in-one-wallhaven-rate.")
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_TRUNC | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
        )
        try:
            _write_all(descriptor, (f"{value:.6f}\n").encode("ascii"))
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.replace(temporary, destination)
        _forget_temporary(temporary)
    except OSError as error:
        raise HelperError("local-io", f"could not save Wallhaven rate state: {error.strerror}", 74) from error


def _wallhaven_wait_api_slot(request: dict[str, Any]) -> None:
    previous = _wallhaven_rate_timestamp(request)
    while True:
        now = time.time()
        if previous > now + WALLHAVEN_MIN_API_INTERVAL_SECONDS:
            previous = 0.0
        remaining = WALLHAVEN_MIN_API_INTERVAL_SECONDS - (now - previous)
        if remaining <= 0:
            break
        _backend_ensure_live(request)
        time.sleep(min(0.05, remaining))
    _backend_ensure_live(request)
    _wallhaven_store_rate_timestamp(request, time.time())


def _wallhaven_curl(
    request: dict[str, Any],
    url: str,
    directory: str,
    maximum: int,
    timeout_seconds: int,
    accept: str,
    expected_content_type: str,
) -> dict[str, Any]:
    global _ACTIVE_CHILD
    if not isinstance(url, str) or len(url.encode("utf-8")) > WALLHAVEN_MAX_URL_BYTES:
        raise HelperError("invalid-url", "Wallhaven URL is invalid", 64)
    body = _new_temporary(directory, ".wallhaven-body.")
    command = [
        "curl", "--disable", "--silent", "--show-error", "--request", "GET",
        "--connect-timeout", "10", "--max-time", str(timeout_seconds),
        "--max-filesize", str(maximum), "--speed-limit", "1024", "--speed-time", "15",
        "--proto", "=https", "--proto-redir", "=https", "--max-redirs", "0",
        "--tlsv1.2", "--header", f"Accept: {accept}", "--user-agent", WALLHAVEN_USER_AGENT,
        "--output", body,
        "--write-out", "%{http_code}\t%{url_effective}\t%{content_type}\t%{size_download}",
        "--url", url,
    ]
    credential = request.get("api_key_path", "")
    if credential:
        command[command.index("--user-agent"):command.index("--user-agent")] = [
            "--header", "@" + credential
        ]
    environment = os.environ.copy()
    environment.pop("CURL_HOME", None)
    _backend_ensure_live(request)
    try:
        _ACTIVE_CHILD = subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=environment,
            preexec_fn=_curl_file_limit(maximum),
        )
    except FileNotFoundError as error:
        _remove_temporary(body)
        raise HelperError("missing-curl", "curl is required by wall-in-one-backend", 127) from error
    try:
        stdout, stderr = _ACTIVE_CHILD.communicate(timeout=timeout_seconds + 5)
    except subprocess.TimeoutExpired as error:
        _ACTIVE_CHILD.kill()
        _ACTIVE_CHILD.communicate()
        _remove_temporary(body)
        raise HelperError("timeout", f"request exceeded its {timeout_seconds}s deadline", 69) from error
    finally:
        return_code = _ACTIVE_CHILD.returncode
        _ACTIVE_CHILD = None
    if return_code != 0:
        _remove_temporary(body)
        detail = _clean_field(stderr.decode("utf-8", "replace"), 320)
        if return_code == 28:
            raise HelperError("timeout", detail or "curl request timed out", 69)
        if return_code in {63, 153}:
            raise HelperError("size-limit", "response exceeded its hard byte limit", 65)
        raise HelperError("transport", detail or f"curl failed with code {return_code}", 69)
    try:
        fields = stdout.decode("ascii").split("\t")
    except UnicodeDecodeError as error:
        _remove_temporary(body)
        raise HelperError("protocol", "curl returned a non-ASCII transfer record", 70) from error
    if len(fields) != 4 or re.fullmatch(r"[0-9]{3}", fields[0]) is None:
        _remove_temporary(body)
        raise HelperError("protocol", "curl returned a malformed transfer record", 70)
    status_code = int(fields[0])
    effective_url = fields[1]
    content_type = fields[2].split(";", 1)[0].strip().lower()
    try:
        reported_bytes = int(float(fields[3]))
    except ValueError as error:
        _remove_temporary(body)
        raise HelperError("protocol", "curl returned an invalid byte count", 70) from error
    if effective_url != url:
        _remove_temporary(body)
        raise HelperError("redirects", "curl effective URL differed from the requested URL", 69)
    info = _lstat_regular(body, maximum=maximum, minimum=0)
    if info.st_size != reported_bytes:
        _remove_temporary(body)
        raise HelperError("size-mismatch", "curl byte count did not match the response file", 65)
    if status_code < 200 or status_code >= 300:
        _remove_temporary(body)
        if status_code == 401:
            raise HelperError("authentication", "Wallhaven rejected the API key", 69)
        if status_code == 429:
            raise HelperError("rate_limit", "Wallhaven's API rate limit was reached", 69)
        if status_code >= 500:
            raise HelperError("remote", "Wallhaven is temporarily unavailable", 69)
        raise HelperError("http", f"Wallhaven returned HTTP {status_code}", 69)
    if content_type != expected_content_type:
        _remove_temporary(body)
        raise HelperError("content-type", f"unexpected response type {content_type or 'unknown'}", 65)
    _backend_ensure_live(request)
    return {
        "path": body,
        "bytes": info.st_size,
        "content_type": content_type,
        "effective_url": effective_url,
    }


def _wallhaven_api_json(request: dict[str, Any], url: str) -> Any:
    _wallhaven_wait_api_slot(request)
    transfer = _wallhaven_curl(
        request,
        url,
        request["transport_directory"],
        WALLHAVEN_MAX_BODY_BYTES,
        WALLHAVEN_API_TIMEOUT_SECONDS,
        "application/json",
        "application/json",
    )
    try:
        payload = _read_bounded_file(transfer["path"], WALLHAVEN_MAX_BODY_BYTES)
        if len(payload) != transfer["bytes"]:
            raise HelperError("size-mismatch", "Wallhaven JSON changed before decoding", 65)
        try:
            return json.loads(payload.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise HelperError("response", f"Wallhaven returned invalid JSON: {error}", 65) from error
    finally:
        _remove_temporary(transfer["path"])


def _wallhaven_search(request: dict[str, Any]) -> dict[str, Any]:
    filters = request["filters"]
    source_url = _wallhaven_search_url(filters)
    decoded = _wallhaven_api_json(request, source_url)
    data = decoded.get("data") if isinstance(decoded, dict) else None
    if not isinstance(data, list):
        raise HelperError("response", "Wallhaven search response did not include a result list", 65)
    items: list[dict[str, Any]] = []
    dropped = 0
    for candidate in data:
        if len(items) >= WALLHAVEN_MAX_RESULTS:
            break
        try:
            items.append(_wallhaven_normalize_wallpaper(candidate, False))
        except HelperError:
            dropped += 1
    meta = decoded.get("meta") if isinstance(decoded.get("meta"), dict) else {}
    return {
        "schema": BACKEND_PROTOCOL,
        "request_id": request["request_id"],
        "action": "wallhaven.search",
        "ok": True,
        "kind": "search",
        "source_url": source_url,
        "filters": filters,
        "meta": {
            "current_page": _wallhaven_integer(meta.get("current_page"), filters["page"], 1, 10_000),
            "last_page": _wallhaven_integer(meta.get("last_page"), filters["page"], 1, 9_007_199_254_740_991),
            "per_page": _wallhaven_integer(meta.get("per_page"), WALLHAVEN_MAX_RESULTS, 1, WALLHAVEN_MAX_RESULTS),
            "total": _wallhaven_integer(meta.get("total"), len(items), 0, 9_007_199_254_740_991),
            "seed": _wallhaven_text(meta.get("seed"), 32),
            "dropped": dropped,
        },
        "items": items,
        "selected": {},
    }


def _wallhaven_detail(request: dict[str, Any]) -> dict[str, Any]:
    url = WALLHAVEN_API_ORIGIN + WALLHAVEN_API_PREFIX + "/w/" + request["id"]
    decoded = _wallhaven_api_json(request, url)
    selected = _wallhaven_normalize_wallpaper(
        decoded.get("data") if isinstance(decoded, dict) else None, True
    )
    if selected["id"] != request["id"]:
        raise HelperError("response", "Wallhaven returned details for a different wallpaper", 65)
    return {
        "schema": BACKEND_PROTOCOL,
        "request_id": request["request_id"],
        "action": "wallhaven.detail",
        "ok": True,
        "kind": "detail",
        "source_url": url,
        "selected": selected,
    }


def _wallhaven_clear(request: dict[str, Any]) -> dict[str, Any]:
    _backend_ensure_live(request)
    return {
