PROBE_WIRE = "WIO-MBGS-PROBE1"
RPC_WIRE = "WIO-MBGS-RPC1"
SELF_TEST_WIRE = "WIO-MBGS-SELFTEST1"
CAPABILITIES = "search,details,download,clear"

ORIGIN = "https://motionbgs.com"
