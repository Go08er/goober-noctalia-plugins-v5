USER_AGENT = (
    f"wall-in-one-motionbgs/{VERSION} "
    "(+https://github.com/Go08er/goober-noctalia-plugins-v5)"
)

MAX_REQUEST_BYTES = 8 * 1024
MAX_RESPONSE_BYTES = 128 * 1024
MAX_ERROR_BYTES = 600
MAX_HTML_BYTES = 1024 * 1024
MAX_CACHE_BYTES = 2 * 1024 * 1024
MAX_SIDECAR_BYTES = 64 * 1024
MAX_RESULTS = 48
MAX_SEARCH_CACHE = 8
MAX_DETAIL_CACHE = 48
MAX_QUERY_BYTES = 80
MAX_PAGE = 10_000
MAX_REDIRECTS = 3
MAX_HEADER_BYTES = 64 * 1024
NETWORK_DELAY_SECONDS = 1.0
HTML_TIMEOUT_SECONDS = 20
MIN_DOWNLOAD_BYTES = 16 * 1024 * 1024
MAX_DOWNLOAD_BYTES = 512 * 1024 * 1024
MIN_CACHE_TTL_SECONDS = 5 * 60
MAX_CACHE_TTL_SECONDS = 24 * 60 * 60
MAX_HTML_TAGS = 50_000
MAX_ATTRIBUTES_PER_TAG = 64
MAX_ATTRIBUTE_BYTES = 4096
MIN_OPERATION_TIMEOUT_MS = 5 * 1000
MAX_OPERATION_TIMEOUT_MS = 75 * 1000

CACHE_NAME = "cache-v1.json"
LOCK_NAME = ".wall-in-one-motionbgs.lock"
RATE_NAME = ".wall-in-one-motionbgs-last-request"
MARKER_NAME = ".wall-in-one-motionbgs-managed.json"
GUARD_CONTENT = b"WIO-MBGS-GUARD1\n"
MARKER_CONTENT = (
    b'{"schema":1,"owner":"goober/wall-in-one","provider":"MotionBGS",'
    b'"deletion_authority":"adjacent .motionbgs.json sidecar required"}\n'
)

SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,119}$")
REQUEST_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$")
WALLPAPER_ID_RE = re.compile(r"^[0-9]{1,12}$")
STILL_PATH_RE = re.compile(
    r"^/(?:i/c/([1-9][0-9]{0,3})x([1-9][0-9]{0,3})/)?"
    r"media/([0-9]{1,12})/([A-Za-z0-9][A-Za-z0-9._-]{0,239})$"
)
VIDEO_PATH_RE = re.compile(
    r"^/media/([0-9]{1,12})/([A-Za-z0-9][A-Za-z0-9._-]{0,239}\.mp4)$",
    re.IGNORECASE,
)
DOWNLOAD_PATH_RE = re.compile(r"^/dl/(hd|4k)/([0-9]{1,12})/?$")
SAFE_CACHE_KEY_RE = re.compile(r"^[0-9a-f]{64}$")
GUARD_NAME_RE = re.compile(r"^\.wall-in-one-motionbgs-guard-[A-Za-z0-9._-]{1,160}$")

_TEMP_PATHS: set[str] = set()
_ACTIVE_CHILD: subprocess.Popen[bytes] | None = None


class HelperError(Exception):
    def __init__(self, kind: str, message: str, exit_code: int = 1) -> None:
        super().__init__(message)
        self.kind = _clean_field(kind, 80) or "unknown"
        self.message = _clean_field(message, MAX_ERROR_BYTES) or "request failed"
        self.exit_code = exit_code


class Cancelled(HelperError):
    def __init__(self) -> None:
        super().__init__("cancelled", "MotionBGS request was cancelled", 143)


def _clean_field(value: Any, maximum: int = MAX_ERROR_BYTES) -> str:
    text = str(value if value is not None else "")
    text = "".join(" " if ord(char) < 32 or ord(char) == 127 else char for char in text)
    return " ".join(text.split())[:maximum]


def _emit_fields(*fields: Any) -> None:
    sys.stdout.write(
        "\t".join(_clean_field(field, MAX_ERROR_BYTES) for field in fields) + "\n"
    )
    sys.stdout.flush()


def _emit_rpc_error(error: HelperError) -> None:
    _emit_fields(RPC_WIRE, "error", error.kind, error.message)


def _cleanup_temporaries() -> None:
    for raw_path in tuple(_TEMP_PATHS):
        try:
            os.unlink(raw_path)
        except FileNotFoundError:
            pass
        except OSError:
            pass
        _TEMP_PATHS.discard(raw_path)


def _handle_signal(_signum: int, _frame: Any) -> None:
    global _ACTIVE_CHILD
    child = _ACTIVE_CHILD
    if child is not None and child.poll() is None:
        try:
            child.terminate()
        except OSError:
            pass
    raise Cancelled()


atexit.register(_cleanup_temporaries)
for _signal in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
    signal.signal(_signal, _handle_signal)


def _safe_absolute_path(value: Any) -> str:
    if not isinstance(value, str) or not value.startswith("/") or value == "/":
        raise HelperError("invalid-path", "path must be a non-root absolute path", 64)
    if len(value.encode("utf-8")) > 4096:
        raise HelperError("invalid-path", "path exceeds 4096 bytes", 64)
    if any(ord(char) < 32 or ord(char) == 127 for char in value):
        raise HelperError("invalid-path", "path contains control characters", 64)
    if "\\" in value or "//" in value:
        raise HelperError("invalid-path", "path contains an unsafe separator", 64)
    components = value.split("/")
    if any(component in {".", ".."} for component in components):
        raise HelperError("invalid-path", "path contains a traversal component", 64)
    return value


def _lstat_regular(
    path: str, *, maximum: int | None = None, minimum: int = 1
) -> os.stat_result:
    try:
        info = os.lstat(path)
    except OSError as error:
        raise HelperError(
            "local-io", f"could not inspect {path}: {error.strerror}", 74
        ) from error
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
        raise HelperError("invalid-path", f"{path} is not a regular file", 64)
    if info.st_uid != os.getuid():
        raise HelperError(
            "invalid-path", f"{path} is not owned by the current user", 64
        )
    if info.st_size < minimum or (maximum is not None and info.st_size > maximum):
        raise HelperError("size-limit", f"{path} has an invalid size", 65)
    return info


def _existing_directory(path: Any, *, writable: bool = True) -> str:
    normalized = _safe_absolute_path(path)
    try:
        info = os.lstat(normalized)
    except OSError as error:
        raise HelperError(
            "invalid-path", f"directory is unavailable: {error.strerror}", 72
        ) from error
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        raise HelperError("invalid-path", "configured path is not a real directory", 72)
    if info.st_uid != os.getuid():
        raise HelperError(
            "invalid-path", "configured directory is not owned by the current user", 72
        )
    if writable and not os.access(normalized, os.W_OK | os.X_OK):
        raise HelperError("invalid-path", "configured directory is not writable", 72)
    return normalized.rstrip("/")


def _is_within(path: str, directory: str) -> bool:
    try:
        return os.path.commonpath((path, directory)) == directory and path != directory
    except ValueError:
        return False


def _read_bounded_file(path: str, maximum: int, *, minimum: int = 1) -> bytes:
    expected = _lstat_regular(path, maximum=maximum, minimum=minimum).st_size
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
        try:
            chunks: list[bytes] = []
            remaining = maximum + 1
            while remaining > 0:
                chunk = os.read(descriptor, min(64 * 1024, remaining))
                if not chunk:
                    break
                chunks.append(chunk)
                remaining -= len(chunk)
        finally:
            os.close(descriptor)
    except OSError as error:
        raise HelperError(
            "local-io", f"could not read bounded file: {error.strerror}", 74
        ) from error
    payload = b"".join(chunks)
    if len(payload) != expected or len(payload) < minimum or len(payload) > maximum:
        raise HelperError("size-limit", "bounded file changed while it was read", 65)
    return payload


def _new_temporary(directory: str, prefix: str) -> str:
    try:
        descriptor, path = tempfile.mkstemp(prefix=prefix, dir=directory)
        os.fchmod(descriptor, 0o600)
        os.close(descriptor)
    except OSError as error:
        raise HelperError(
            "local-io",
            f"could not allocate a private temporary file: {error.strerror}",
            73,
        ) from error
    _TEMP_PATHS.add(path)
    return path


def _forget_temporary(path: str) -> None:
    _TEMP_PATHS.discard(path)


def _remove_temporary(path: str) -> None:
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    finally:
        _forget_temporary(path)


def _write_all(descriptor: int, payload: bytes) -> None:
    offset = 0
    while offset < len(payload):
        written = os.write(descriptor, payload[offset:])
        if written <= 0:
            raise OSError(errno.EIO, "short write")
        offset += written


def _write_no_replace(path: str, payload: bytes, maximum: int) -> int:
    if not payload or len(payload) > maximum:
        raise HelperError("size-limit", "response exceeds its bounded wire format", 65)
    output = _safe_absolute_path(path)
    parent = _existing_directory(os.path.dirname(output))
    try:
        os.lstat(output)
    except FileNotFoundError:
        pass
    else:
        raise HelperError("conflict", "response path already exists", 73)

    temporary = _new_temporary(parent, ".wall-in-one-motionbgs-response.")
    flags = (
        os.O_WRONLY
        | os.O_TRUNC
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    try:
        descriptor = os.open(temporary, flags)
        try:
            _write_all(descriptor, payload)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.link(temporary, output, follow_symlinks=False)
        os.unlink(temporary)
        _forget_temporary(temporary)
    except FileExistsError as error:
        raise HelperError(
            "conflict", "response path appeared before installation", 73
        ) from error
    except OSError as error:
        raise HelperError(
            "local-io",
            f"could not install response without replacement: {error.strerror}",
            74,
        ) from error
    return len(payload)


def _encode_json(value: Any, maximum: int) -> bytes:
    try:
        payload = (
            json.dumps(
                value, ensure_ascii=True, separators=(",", ":"), sort_keys=True
            ).encode("utf-8")
            + b"\n"
        )
    except (TypeError, ValueError) as error:
        raise HelperError(
            "protocol", f"could not encode bounded JSON: {error}", 70
        ) from error
    if len(payload) > maximum:
        raise HelperError("size-limit", "encoded JSON exceeds its protocol limit", 65)
    return payload


def _int_field(value: Any, name: str, minimum: int, maximum: int) -> int:
    if type(value) is not int or value < minimum or value > maximum:
        raise HelperError(
            "invalid-request",
            f"{name} must be an integer from {minimum} through {maximum}",
            64,
        )
    return value


def _bool_field(value: Any, name: str) -> bool:
    if type(value) is not bool:
        raise HelperError("invalid-request", f"{name} must be a boolean", 64)
    return value


def _normalized_query(value: Any) -> str:
    if not isinstance(value, str) or any(
        ord(char) < 32 or ord(char) == 127 for char in value
    ):
        raise HelperError(
            "invalid-browse", "search query contains invalid characters", 64
        )
    normalized = " ".join(value.split())
    if not normalized or len(normalized.encode("utf-8")) > MAX_QUERY_BYTES:
        raise HelperError(
            "invalid-browse", "search query must contain 1-80 UTF-8 bytes", 64
        )
    return normalized


def _slug(value: Any, *, label: str = "slug") -> str:
    if not isinstance(value, str) or SLUG_RE.fullmatch(value) is None:
        raise HelperError(
            "invalid-slug", f"{label} is not a lowercase MotionBGS slug", 64
        )
    return value


def _normalize_provider_url(value: str, *, base: str | None = None) -> str:
    if not isinstance(value, str) or not value or len(value) > 2048:
        raise HelperError("invalid-url", "provider URL is empty or too long", 64)
    if any(ord(char) < 32 or ord(char) == 127 for char in value) or "\\" in value:
        raise HelperError("invalid-url", "provider URL contains unsafe characters", 64)
    candidate = urljoin(base or ORIGIN + "/", value)
    parsed = urlsplit(candidate)
    try:
        port = parsed.port
    except ValueError as error:
        raise HelperError(
            "invalid-url", "provider URL contains an invalid port", 64
        ) from error
    if (
        parsed.scheme.lower() != "https"
        or (parsed.hostname or "").lower() != HOST
        or port not in (None, 443)
        or parsed.username is not None
        or parsed.password is not None
        or parsed.fragment
    ):
        raise HelperError(
            "invalid-url", "only the exact MotionBGS HTTPS origin is accepted", 64
        )
    if not parsed.path.startswith("/") or "//" in parsed.path:
        raise HelperError("invalid-url", "provider URL path is malformed", 64)
    decoded_path = re.sub("%2f", "/", parsed.path, flags=re.IGNORECASE)
    decoded_path = re.sub("%5c", lambda _match: "\\", decoded_path, flags=re.IGNORECASE)
    decoded_path = re.sub("%2e", ".", decoded_path, flags=re.IGNORECASE)
    if "\\" in decoded_path or any(
        part in {".", ".."} for part in decoded_path.split("/")
    ):
        raise HelperError("invalid-url", "provider URL contains a traversal path", 64)
    # Port 443 is the default HTTPS origin, so canonicalize it away. This keeps
    # helper output byte-for-byte compatible with the bridge's fixed BASE_URL.
    return urlunsplit(("https", HOST, parsed.path, parsed.query, ""))


def _site_path(value: str) -> str:
    path = urlsplit(_normalize_provider_url(value)).path.rstrip("/")
    return path or "/"


def _still_url(value: Any) -> str:
    if not isinstance(value, str) or not value:
        return ""
    try:
        normalized = _normalize_provider_url(value)
    except HelperError:
        return ""
    parsed = urlsplit(normalized)
    if parsed.query:
        return ""
    match = STILL_PATH_RE.fullmatch(parsed.path)
    if match is None:
        return ""
    width, height, _media_id, filename = match.groups()
    if width is not None and (int(width) > 4096 or int(height) > 4096):
        return ""
    if not filename.lower().endswith((".jpg", ".jpeg", ".png", ".webp")):
        return ""
    return normalized


def _video_url(value: Any) -> str:
    if not isinstance(value, str) or not value:
        return ""
    try:
        normalized = _normalize_provider_url(value)
    except HelperError:
        return ""
    parsed = urlsplit(normalized)
    return (
        normalized
        if not parsed.query and VIDEO_PATH_RE.fullmatch(parsed.path) is not None
        else ""
    )


def _bounded_text(value: Any, maximum: int) -> str:
    return _clean_field(html.unescape(str(value if value is not None else "")), maximum)


def _browse_request(request: dict[str, Any]) -> tuple[str, str, str, int]:
    mode = request.get("mode")
    if mode not in {"search", "latest", "genre", "4k", "hd"}:
        raise HelperError(
            "invalid-browse", "browse mode must be search, latest, genre, 4k, or hd", 64
        )
    page = _int_field(request.get("page"), "page", 1, MAX_PAGE)
    query = ""
    genre = ""
    if mode == "search":
        query = _normalized_query(request.get("query"))
        if request.get("query") != query:
            raise HelperError(
                "invalid-browse",
                "search query must already be whitespace-normalized",
                64,
            )
        if page != 1:
            raise HelperError(
                "invalid-browse", "MotionBGS text search does not expose pagination", 64
            )
    elif request.get("query", "") not in (None, ""):
        raise HelperError("invalid-browse", "query is valid only in search mode", 64)
    if mode == "genre":
        genre = _slug(request.get("genre"), label="genre")
    elif request.get("genre", "") not in (None, ""):
        raise HelperError("invalid-browse", "genre is valid only in genre mode", 64)
    if mode == "hd" and page != 1:
        raise HelperError(
            "invalid-browse",
            "MotionBGS HD browsing is intentionally first-page-only",
            64,
        )
    return mode, query, genre, page


def _browse_url(mode: str, query: str, genre: str, page: int) -> str:
    if mode == "search":
        return f"{ORIGIN}/search?q={quote_plus(query)}"
    if mode == "latest":
        return ORIGIN + "/" + ("" if page == 1 else f"{page}/")
    if mode == "genre":
        return f"{ORIGIN}/tag:{genre}/" + ("" if page == 1 else f"{page}/")
    if mode == "4k":
        return f"{ORIGIN}/4k/" + ("" if page == 1 else f"{page}/")
    return f"{ORIGIN}/hd/"


def _canonical_search_slug(query: str) -> str | None:
    candidate = query.lower().replace(" ", "-")
    return candidate if SLUG_RE.fullmatch(candidate) is not None else None


def _listing_route_matches(
    mode: str, query: str, genre: str, page: int, value: str
) -> bool:
    normalized = _normalize_provider_url(value)
    parsed = urlsplit(normalized)
    actual = parsed.path.rstrip("/") or "/"
    if mode == "search":
        canonical = _canonical_search_slug(query)
        return normalized == _browse_url(mode, query, genre, page) or (
            parsed.query == ""
            and canonical is not None
            and actual == f"/tag:{canonical}"
        )
    return parsed.query == "" and actual == _site_path(
        _browse_url(mode, query, genre, page)
    )


def _validate_request_keys(request: dict[str, Any], action: str) -> None:
    # The bridge emits cache_ttl_seconds in its common envelope, including a
    # clear request where the value is informational and no cache read occurs.
    common = {
        "schema",
        "request_id",
        "action",
        "cache_directory",
        "cache_ttl_seconds",
        "guard_path",
        "operation_timeout_ms",
    }
    action_keys = {
        "search": {"mode", "query", "genre", "page", "limit", "force"},
        "details": {"slug", "force"},
        "download": {
            "slug",
            "quality",
            "download_directory",
            "managed_marker_path",
            "max_download_bytes",
            "download_timeout_seconds",
            "force",
        },
        "clear": set(),
    }
    extras = set(request) - common - action_keys[action]
    if extras:
        raise HelperError(
            "invalid-request",
            f"request contains unsupported field: {sorted(extras)[0]}",
            64,
        )


def _load_request(path: str) -> dict[str, Any]:
    request_path = _safe_absolute_path(path)
    raw = _read_bounded_file(request_path, MAX_REQUEST_BYTES)
    try:
        decoded = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise HelperError(
            "invalid-request", f"request is not bounded UTF-8 JSON: {error}", 64
        ) from error
    if not isinstance(decoded, dict) or decoded.get("schema") != PROTOCOL:
        raise HelperError(
            "invalid-request", "request must be a schema-1 JSON object", 64
        )
    request_id = decoded.get("request_id")
    if not isinstance(request_id, str) or REQUEST_ID_RE.fullmatch(request_id) is None:
        raise HelperError(
            "invalid-request", "request_id has an invalid wire format", 64
        )
    action = decoded.get("action")
    if action not in {"search", "details", "download", "clear"}:
        raise HelperError(
            "invalid-request", "action must be search, details, download, or clear", 64
        )
    _validate_request_keys(decoded, action)
    cache_directory = _existing_directory(decoded.get("cache_directory"))
    if not _is_within(request_path, cache_directory):
        raise HelperError(
            "invalid-path", "request file must be inside its cache directory", 64
        )
    decoded["cache_directory"] = cache_directory
    guard_path = _safe_absolute_path(decoded.get("guard_path"))
    if (
        not _is_within(guard_path, cache_directory)
        or GUARD_NAME_RE.fullmatch(os.path.basename(guard_path)) is None
    ):
        raise HelperError(
            "invalid-path",
            "cancellation guard must be a named file inside the cache directory",
            64,
        )
    decoded["guard_path"] = guard_path
    decoded["operation_timeout_ms"] = _int_field(
        decoded.get("operation_timeout_ms"),
        "operation_timeout_ms",
        MIN_OPERATION_TIMEOUT_MS,
        MAX_OPERATION_TIMEOUT_MS,
    )
    decoded["_deadline_monotonic"] = (
        time.monotonic() + decoded["operation_timeout_ms"] / 1000.0
    )
    decoded["force"] = _bool_field(decoded.get("force", False), "force")
    decoded["cache_ttl_seconds"] = _int_field(
        decoded.get("cache_ttl_seconds"),
        "cache_ttl_seconds",
        MIN_CACHE_TTL_SECONDS,
        MAX_CACHE_TTL_SECONDS,
    )
    if action == "search":
        mode, query, genre, page = _browse_request(decoded)
        decoded.update(mode=mode, query=query, genre=genre, page=page)
        decoded["limit"] = _int_field(decoded.get("limit"), "limit", 1, MAX_RESULTS)
    elif action in {"details", "download"}:
        decoded["slug"] = _slug(decoded.get("slug"))
    if action == "download":
        quality = decoded.get("quality")
        if quality not in {"hd", "4k"}:
            raise HelperError("invalid-quality", "quality must be hd or 4k", 64)
        decoded["quality"] = quality
        download_directory = _existing_directory(decoded.get("download_directory"))
        marker_path = _safe_absolute_path(decoded.get("managed_marker_path"))
        expected_marker = download_directory + "/" + MARKER_NAME
        if marker_path != expected_marker:
            raise HelperError(
                "invalid-marker",
                "managed marker path does not match the download directory",
                64,
            )
        marker = _read_bounded_file(marker_path, len(MARKER_CONTENT))
        if marker != MARKER_CONTENT:
            raise HelperError(
                "invalid-marker", "managed MotionBGS directory marker is invalid", 65
            )
        decoded["download_directory"] = download_directory
        decoded["managed_marker_path"] = marker_path
        decoded["max_download_bytes"] = _int_field(
            decoded.get("max_download_bytes"),
            "max_download_bytes",
            MIN_DOWNLOAD_BYTES,
            MAX_DOWNLOAD_BYTES,
        )
        decoded["download_timeout_seconds"] = _int_field(
            decoded.get("download_timeout_seconds"), "download_timeout_seconds", 10, 50
        )
    return decoded


def _empty_cache() -> dict[str, Any]:
    return {
        "schema": 1,
        "searches": {},
        "search_order": [],
        "details": {},
        "detail_order": [],
    }


def _cache_path(directory: str) -> str:
    return directory + "/" + CACHE_NAME


def _load_cache(directory: str) -> dict[str, Any]:
    path = _cache_path(directory)
    try:
        raw = _read_bounded_file(path, MAX_CACHE_BYTES)
    except HelperError as error:
        if not os.path.lexists(path) or error.kind in {"size-limit", "invalid-path"}:
            return _empty_cache()
        raise
    try:
        candidate = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return _empty_cache()
    if not isinstance(candidate, dict) or candidate.get("schema") != 1:
        return _empty_cache()
    searches = candidate.get("searches")
    search_order = candidate.get("search_order")
    details = candidate.get("details")
    detail_order = candidate.get("detail_order")
    if not all(
        isinstance(value, expected)
        for value, expected in (
            (searches, dict),
            (search_order, list),
            (details, dict),
            (detail_order, list),
        )
    ):
        return _empty_cache()
    normalized = _empty_cache()
    seen: set[str] = set()
    for key in search_order[-MAX_SEARCH_CACHE:]:
        if (
            isinstance(key, str)
            and SAFE_CACHE_KEY_RE.fullmatch(key)
            and key not in seen
            and isinstance(searches.get(key), dict)
        ):
            normalized["searches"][key] = searches[key]
            normalized["search_order"].append(key)
            seen.add(key)
    seen.clear()
    for key in detail_order[-MAX_DETAIL_CACHE:]:
        if (
            isinstance(key, str)
            and SLUG_RE.fullmatch(key)
            and key not in seen
            and isinstance(details.get(key), dict)
        ):
            normalized["details"][key] = details[key]
            normalized["detail_order"].append(key)
            seen.add(key)
    return normalized


def _save_cache(directory: str, cache: dict[str, Any]) -> None:
    payload = _encode_json(cache, MAX_CACHE_BYTES)
    target = _cache_path(directory)
    if os.path.lexists(target):
        try:
            info = os.lstat(target)
        except OSError as error:
            raise HelperError(
                "cache", f"could not inspect the MotionBGS cache: {error.strerror}", 74
            ) from error
        if (
            not stat.S_ISREG(info.st_mode)
            or stat.S_ISLNK(info.st_mode)
            or info.st_uid != os.getuid()
        ):
            raise HelperError("cache", "existing MotionBGS cache path is unsafe", 65)
        if info.st_size > MAX_CACHE_BYTES:
            # A bounded reader intentionally refuses this file. It is still
            # safe to discard only after lstat proves it is our regular file;
            # otherwise one oversized cache would make every future save fail.
            try:
                os.unlink(target)
            except OSError as error:
                raise HelperError(
                    "cache",
                    f"could not discard an oversized MotionBGS cache: {error.strerror}",
                    74,
                ) from error
    temporary = _new_temporary(directory, ".wall-in-one-motionbgs-cache.")
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY
            | os.O_TRUNC
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
        try:
            _write_all(descriptor, payload)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.replace(temporary, target)
        _forget_temporary(temporary)
    except OSError as error:
        raise HelperError(
            "cache", f"could not persist the MotionBGS cache: {error.strerror}", 74
        ) from error


def _touch_order(cache: dict[str, Any], domain: str, key: str, maximum: int) -> None:
    order_name = "search_order" if domain == "searches" else "detail_order"
    order = [item for item in cache[order_name] if item != key]
    order.append(key)
    while len(order) > maximum:
        cache[domain].pop(order.pop(0), None)
    cache[order_name] = order


def _cache_key(request: dict[str, Any]) -> str:
    canonical = {
        "mode": request["mode"],
        "query": request["query"].lower(),
        "genre": request["genre"],
        "page": request["page"],
        "limit": request["limit"],
    }
    return hashlib.sha256(_encode_json(canonical, 1024)).hexdigest()


def _fresh(timestamp: Any, ttl: int) -> bool:
    if type(timestamp) not in (int, float):
        return False
    age = time.time() - float(timestamp)
    return 0 <= age <= ttl


def _require_guard(path: str) -> None:
    try:
        payload = _read_bounded_file(
            path, len(GUARD_CONTENT), minimum=len(GUARD_CONTENT)
        )
    except HelperError as error:
        raise Cancelled() from error
    if payload != GUARD_CONTENT:
        raise Cancelled()


def _remaining_seconds(
    request: dict[str, Any], maximum: int, *, reserve: float = 0.25
) -> int:
    deadline = request.get("_deadline_monotonic")
    if type(deadline) is not float:
        raise HelperError(
            "invalid-request", "operation deadline was not initialized", 64
        )
    remaining = deadline - time.monotonic() - reserve
    if remaining < 1.0:
        raise HelperError(
            "timeout", "MotionBGS operation exhausted its end-to-end deadline", 69
        )
    return max(1, min(maximum, int(remaining)))


def _ensure_live(request: dict[str, Any]) -> None:
    _require_guard(request["guard_path"])
    _remaining_seconds(request, MAX_OPERATION_TIMEOUT_MS // 1000)


def _open_lock(directory: str, request: dict[str, Any]) -> int:
    path = directory + "/" + LOCK_NAME
    flags = (
        os.O_RDWR
        | os.O_CREAT
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    descriptor = -1
    try:
        descriptor = os.open(path, flags, 0o600)
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise HelperError("invalid-path", "MotionBGS lock file is unsafe", 65)
        os.fchmod(descriptor, 0o600)
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                _ensure_live(request)
                time.sleep(0.05)
        return descriptor
    except HelperError:
        if descriptor >= 0:
            os.close(descriptor)
        raise
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        raise HelperError(
            "local-io",
            f"could not acquire the MotionBGS operation lock: {error.strerror}",
            74,
        ) from error


def _wait_for_network_slot(request: dict[str, Any]) -> None:
    _ensure_live(request)
    directory = request["cache_directory"]
    path = directory + "/" + RATE_NAME
    previous = 0.0
    if os.path.lexists(path):
        try:
            raw = _read_bounded_file(path, 64).decode("ascii").strip()
            previous = float(raw)
        except HelperError as error:
            if error.kind != "size-limit":
                raise
            # Recover from an oversized/truncated rate file only after proving
            # that it is our regular file. Never turn a symlink or foreign
            # path into a replace target merely because the bounded read
            # rejected it.
            try:
                info = os.lstat(path)
            except OSError as inspect_error:
                raise HelperError(
                    "local-io",
                    f"could not inspect request spacing: {inspect_error.strerror}",
                    74,
                ) from inspect_error
            if (
                not stat.S_ISREG(info.st_mode)
                or stat.S_ISLNK(info.st_mode)
                or info.st_uid != os.getuid()
            ):
                raise HelperError("invalid-path", "request-spacing path is unsafe", 65)
            try:
                os.unlink(path)
            except OSError as unlink_error:
                raise HelperError(
                    "local-io",
                    f"could not discard invalid request spacing: {unlink_error.strerror}",
                    74,
                ) from unlink_error
        except (UnicodeDecodeError, ValueError):
            previous = 0.0
    delay = NETWORK_DELAY_SECONDS - (time.time() - previous)
    if delay > 0:
        bounded_delay = min(delay, NETWORK_DELAY_SECONDS)
        remaining = request["_deadline_monotonic"] - time.monotonic()
        if remaining <= bounded_delay + 0.5:
            raise HelperError(
                "timeout", "request spacing would exceed the operation deadline", 69
            )
        time.sleep(bounded_delay)
    _ensure_live(request)
    payload = f"{time.time():.6f}\n".encode("ascii")
    temporary = _new_temporary(directory, ".wall-in-one-motionbgs-rate.")
    try:
        with open(temporary, "wb", buffering=0) as stream:
            stream.write(payload)
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        _forget_temporary(temporary)
    except OSError as error:
        raise HelperError(
            "local-io", f"could not persist request spacing: {error.strerror}", 74
        ) from error
    _ensure_live(request)


def _header_value(path: str, wanted: str) -> str:
    try:
        payload = _read_bounded_file(path, MAX_HEADER_BYTES, minimum=0)
    except HelperError as error:
        if error.kind == "size-limit":
            raise HelperError(
                "headers", "response headers exceeded 64 KiB", 65
            ) from error
        raise
    found = ""
    for raw_line in payload.splitlines():
        if b":" not in raw_line:
            continue
        raw_key, raw_value = raw_line.split(b":", 1)
        if raw_key.decode("ascii", "ignore").strip().lower() == wanted.lower():
            found = raw_value.decode("latin-1", "replace").strip()
    return found


def _curl_file_limit(maximum: int) -> Any:
    def set_limit() -> None:
        current_soft, current_hard = resource.getrlimit(resource.RLIMIT_FSIZE)
        hard = (
            maximum
            if current_hard == resource.RLIM_INFINITY
            else min(current_hard, maximum)
        )
        soft = min(maximum, hard)
        resource.setrlimit(resource.RLIMIT_FSIZE, (soft, hard))

    return set_limit


def _curl_once(
    url: str,
    directory: str,
    maximum: int,
    timeout_seconds: int,
    accept: str,
) -> dict[str, Any]:
    global _ACTIVE_CHILD
    requested = _normalize_provider_url(url)
    body = _new_temporary(directory, ".motionbgs-body.")
    headers = _new_temporary(directory, ".motionbgs-headers.")
    command = [
        "curl",
        "--disable",
        "--silent",
        "--show-error",
        "--request",
        "GET",
        "--connect-timeout",
        "10",
        "--max-time",
        str(timeout_seconds),
        "--max-filesize",
        str(maximum),
        "--speed-limit",
        "1024",
        "--speed-time",
        "15",
        "--proto",
        "=https",
        "--proto-redir",
        "=https",
        "--max-redirs",
        "0",
        "--tlsv1.2",
        "--header",
        "Accept-Language: en-US,en;q=0.8",
        "--header",
        f"Accept: {accept}",
        "--user-agent",
        USER_AGENT,
        "--dump-header",
        headers,
        "--output",
        body,
        "--write-out",
        "%{http_code}\t%{url_effective}\t%{content_type}\t%{size_download}",
        "--url",
        requested,
    ]
    environment = os.environ.copy()
    environment.pop("CURL_HOME", None)
    try:
        _ACTIVE_CHILD = subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=environment,
            preexec_fn=_curl_file_limit(max(maximum, MAX_HEADER_BYTES)),
        )
    except FileNotFoundError as error:
        _remove_temporary(body)
        _remove_temporary(headers)
        raise HelperError(
            "missing-curl", "curl is required by wall-in-one-motionbgs", 127
        ) from error
    try:
        stdout, stderr = _ACTIVE_CHILD.communicate(timeout=timeout_seconds + 5)
    except subprocess.TimeoutExpired as error:
        _ACTIVE_CHILD.kill()
        _ACTIVE_CHILD.communicate()
        raise HelperError(
            "timeout", f"request exceeded its {timeout_seconds}s deadline", 69
        ) from error
    finally:
        return_code = _ACTIVE_CHILD.returncode
        _ACTIVE_CHILD = None
    if return_code != 0:
        _remove_temporary(body)
        _remove_temporary(headers)
        detail = _clean_field(stderr.decode("utf-8", "replace"), 320)
        if return_code == 28:
            raise HelperError("timeout", detail or "curl request timed out", 69)
        if return_code in {63, 153}:
            raise HelperError("size-limit", "response exceeded its hard byte limit", 65)
        raise HelperError(
            "transport", detail or f"curl failed with code {return_code}", 69
        )
    try:
        fields = stdout.decode("ascii").split("\t")
    except UnicodeDecodeError as error:
        _remove_temporary(body)
        _remove_temporary(headers)
        raise HelperError(
            "protocol", "curl returned a non-ASCII transfer record", 70
        ) from error
    if len(fields) != 4 or re.fullmatch(r"[0-9]{3}", fields[0]) is None:
        _remove_temporary(body)
        _remove_temporary(headers)
        raise HelperError("protocol", "curl returned a malformed transfer record", 70)
    status_code = int(fields[0])
    effective = fields[1]
    content_type = fields[2].split(";", 1)[0].strip().lower()
    try:
        reported_bytes = int(float(fields[3]))
    except ValueError as error:
        _remove_temporary(body)
        _remove_temporary(headers)
        raise HelperError(
            "protocol", "curl returned an invalid byte count", 70
        ) from error
    if effective != requested:
        _remove_temporary(body)
        _remove_temporary(headers)
        raise HelperError(
            "redirects", "curl effective URL differed from the requested URL", 69
        )
    info = _lstat_regular(body, maximum=maximum, minimum=0)
    if info.st_size != reported_bytes:
        _remove_temporary(body)
        _remove_temporary(headers)
        raise HelperError(
            "size-mismatch", "curl byte count did not match the response file", 65
        )
    result = {
        "status": status_code,
        "effective_url": effective,
        "content_type": content_type,
        "bytes": info.st_size,
        "path": body,
        "headers": headers,
    }
    return result


def _fetch(
    request: dict[str, Any],
    start_url: str,
    directory: str,
    maximum: int,
    timeout_seconds: int,
    accept: str,
    purpose: str,
) -> dict[str, Any]:
    url = _normalize_provider_url(start_url)
    for redirect_count in range(MAX_REDIRECTS + 1):
        _ensure_live(request)
        _wait_for_network_slot(request)
        transfer = _curl_once(
            url,
            directory,
            maximum,
            _remaining_seconds(request, timeout_seconds),
            accept,
        )
        try:
            _ensure_live(request)
        except BaseException:
            _remove_temporary(transfer["path"])
            _remove_temporary(transfer["headers"])
            raise
        status_code = transfer["status"]
        if status_code in {301, 302, 303, 307, 308}:
            if redirect_count >= MAX_REDIRECTS:
                _remove_temporary(transfer["path"])
                _remove_temporary(transfer["headers"])
                raise HelperError(
                    "redirects", "MotionBGS returned too many redirects", 69
                )
            location = _header_value(transfer["headers"], "location")
            _remove_temporary(transfer["path"])
            _remove_temporary(transfer["headers"])
            if not location:
                raise HelperError(
                    "redirects", "redirect did not include a Location header", 69
                )
            url = _normalize_provider_url(location, base=url)
            _ensure_live(request)
            continue
        _remove_temporary(transfer["headers"])
        transfer.pop("headers", None)
        if status_code in {403, 429}:
            _remove_temporary(transfer["path"])
            raise HelperError(
                "challenge",
                f"MotionBGS refused the public request (HTTP {status_code}); no bypass was attempted",
                77,
            )
        if status_code < 200 or status_code >= 300:
            _remove_temporary(transfer["path"])
            raise HelperError(
                "http", f"MotionBGS returned HTTP {status_code} for {purpose}", 69
            )
        transfer["effective_url"] = url
        return transfer
    raise HelperError("redirects", "redirect processing did not terminate", 69)


def _validate_html_transfer(transfer: dict[str, Any]) -> bytes:
    if transfer["content_type"] not in {"text/html", "application/xhtml+xml"}:
        _remove_temporary(transfer["path"])
        raise HelperError(
            "content-type",
            f"expected HTML but received {transfer['content_type'] or 'unknown'}",
            65,
        )
    payload = _read_bounded_file(transfer["path"], MAX_HTML_BYTES)
    signature = payload[:4096].lstrip(b"\xef\xbb\xbf\x00\t\r\n ").lower()
    if not (
        signature.startswith(b"<!doctype html")
        or signature.startswith(b"<html")
        or signature.startswith(b"<?xml")
    ):
        _remove_temporary(transfer["path"])
        raise HelperError(
            "content-type", "HTML MIME type did not match the response signature", 65
        )
    if b"\x00" in payload:
        _remove_temporary(transfer["path"])
        raise HelperError("content-type", "HTML response contains NUL bytes", 65)
    _remove_temporary(transfer["path"])
    return payload


def _decode_html(payload: bytes) -> str:
    return payload.decode("utf-8", "replace")


class _BoundedParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.tags_seen = 0

    def _attributes(self, attributes: list[tuple[str, str | None]]) -> dict[str, str]:
        self.tags_seen += 1
        if self.tags_seen > MAX_HTML_TAGS:
            raise HelperError(
                "site-markup", "MotionBGS page exceeded the bounded tag limit", 65
            )
        if len(attributes) > MAX_ATTRIBUTES_PER_TAG:
            raise HelperError(
                "site-markup", "MotionBGS tag exceeded the bounded attribute limit", 65
            )
        normalized: dict[str, str] = {}
        for key, value in attributes:
            lower = key.lower()
            text = value or ""
            if len(text.encode("utf-8", "replace")) > MAX_ATTRIBUTE_BYTES:
                continue
            if lower not in normalized:
                normalized[lower] = text
        return normalized


class _ListingParser(_BoundedParser):
    def __init__(self) -> None:
        super().__init__()
        self.anchor: dict[str, Any] | None = None
        self.anchor_depth = 0
        self.span_class = ""
        self.title_depth = 0
        self.title_parts: list[str] = []
        self.links: list[dict[str, str]] = []
        self.cards: list[dict[str, Any]] = []

    def handle_starttag(
        self, tag: str, attributes: list[tuple[str, str | None]]
    ) -> None:
        attrs = self._attributes(attributes)
        tag = tag.lower()
        if tag == "title":
            self.title_depth += 1
        if tag == "link" and len(self.links) < 64:
            self.links.append(attrs)
        if tag == "a":
            if self.anchor is None:
                self.anchor = {
                    "attrs": attrs,
                    "ttl": [],
                    "frm": [],
                    "text": [],
                    "image": "",
                }
                self.anchor_depth = 1
            else:
                self.anchor_depth += 1
            return
        if self.anchor is None:
            return
        if tag == "span":
            classes = set(attrs.get("class", "").split())
            if "ttl" in classes:
                self.span_class = "ttl"
            elif "frm" in classes:
                self.span_class = "frm"
        elif tag == "img" and not self.anchor["image"]:
            for key in ("data-src", "data-lazy-src", "data-original", "src"):
                candidate = _still_url(attrs.get(key, ""))
                if candidate:
                    self.anchor["image"] = candidate
                    break
        elif tag == "source" and not self.anchor["image"]:
            for key in ("data-srcset", "srcset", "data-src", "src"):
                value = attrs.get(key, "")
                for candidate_text in value.split(","):
                    candidate = _still_url(candidate_text.strip().split(" ", 1)[0])
                    if candidate:
                        self.anchor["image"] = candidate
                        break
                if self.anchor["image"]:
                    break

    def handle_endtag(self, tag: str) -> None:
        tag = tag.lower()
        if tag == "title" and self.title_depth:
            self.title_depth -= 1
        if self.anchor is None:
            return
        if tag == "span":
            self.span_class = ""
        elif tag == "a":
            self.anchor_depth -= 1
            if self.anchor_depth <= 0:
                self.cards.append(self.anchor)
                self.anchor = None
                self.anchor_depth = 0
                self.span_class = ""

    def handle_data(self, data: str) -> None:
        if self.title_depth:
            self.title_parts.append(data)
        if self.anchor is None:
            return
        self.anchor["text"].append(data)
        if self.span_class:
            self.anchor[self.span_class].append(data)


class _DetailParser(_BoundedParser):
    def __init__(self) -> None:
        super().__init__()
        self.metas: dict[str, str] = {}
        self.sources: list[dict[str, str]] = []
        self.anchors: list[dict[str, Any]] = []
        self.anchor: dict[str, Any] | None = None
        self.anchor_depth = 0
        self.title_depth = 0
        self.title_parts: list[str] = []

    def handle_starttag(
        self, tag: str, attributes: list[tuple[str, str | None]]
    ) -> None:
        attrs = self._attributes(attributes)
        tag = tag.lower()
        if tag == "title":
            self.title_depth += 1
        elif tag == "meta":
            key = (attrs.get("property") or attrs.get("name") or "").lower()
            if key and key not in self.metas:
                self.metas[key] = attrs.get("content", "")
        elif tag == "source" and len(self.sources) < 64:
            self.sources.append(attrs)
        elif tag == "a":
            if self.anchor is None:
                self.anchor = {"attrs": attrs, "text": []}
                self.anchor_depth = 1
            else:
                self.anchor_depth += 1

    def handle_endtag(self, tag: str) -> None:
        tag = tag.lower()
        if tag == "title" and self.title_depth:
            self.title_depth -= 1
        if self.anchor is not None and tag == "a":
            self.anchor_depth -= 1
            if self.anchor_depth <= 0:
                self.anchors.append(self.anchor)
                self.anchor = None
                self.anchor_depth = 0

    def handle_data(self, data: str) -> None:
        if self.title_depth:
            self.title_parts.append(data)
        if self.anchor is not None:
            self.anchor["text"].append(data)


def _challenge_page(markup: str) -> bool:
    prefix = markup[:16_384].lower()
    return any(
        marker in prefix
        for marker in (
            "<title>just a moment",
            "challenge-error-text",
            "checking your browser",
        )
    )


def _parse_listing(
    markup: str, request: dict[str, Any], source_url: str
) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    if _challenge_page(markup):
        raise HelperError(
            "challenge",
            "MotionBGS returned an anti-bot challenge; no bypass was attempted",
            77,
        )
    parser = _ListingParser()
    try:
        parser.feed(markup)
        parser.close()
    except HelperError:
        raise
    except Exception as error:
        raise HelperError(
            "site-markup", f"could not parse bounded MotionBGS listing: {error}", 65
        ) from error
    items: list[dict[str, Any]] = []
    seen: set[str] = set()
    for card in parser.cards:
        attrs = card["attrs"]
        href = attrs.get("href", "")
        title_attr = attrs.get("title", "")
        title = _bounded_text(" ".join(card["ttl"]), 240)
        if not title and "live wallpaper" not in title_attr.lower():
            continue
        try:
            normalized_href = _normalize_provider_url(href)
        except HelperError:
            continue
        path = urlsplit(normalized_href).path
        match = re.fullmatch(r"/([a-z0-9][a-z0-9-]{0,119})/?", path)
        if match is None or match.group(1) in seen:
            continue
        slug = match.group(1)
        if not title:
            title = _bounded_text(
                re.sub(r"live\s+wallpaper", "", title_attr, flags=re.IGNORECASE), 240
            )
        quality = _bounded_text(" ".join(card["frm"]), 20).upper()
        if not quality:
            quality_match = re.search(r"\b(4K|HD)\b", title_attr, flags=re.IGNORECASE)
            quality = quality_match.group(1).upper() if quality_match else ""
        thumbnail = card["image"]
        identifier_match = re.search(r"/media/([0-9]{1,12})/", thumbnail)
        items.append(
            {
                "slug": slug,
                "id": identifier_match.group(1) if identifier_match else "",
                "title": title or slug,
                "quality": quality,
                "source_url": f"{ORIGIN}/{slug}",
                "thumbnail_url": thumbnail,
                "provider": "MotionBGS",
            }
        )
        seen.add(slug)
        if len(items) >= request["limit"]:
            break
    if not items:
        prefix = markup[:16_384].lower()
        if not any(
            marker in prefix
            for marker in ("no wallpapers", "nothing found", "no results")
        ):
            raise HelperError(
                "site-markup",
                "MotionBGS returned no recognizable wallpaper cards; its public markup may have changed",
                65,
            )

    mode, query, genre, page = (
        request[key] for key in ("mode", "query", "genre", "page")
    )
    if not _listing_route_matches(mode, query, genre, page, source_url):
        raise HelperError(
            "redirects", "MotionBGS redirected into a different catalog route", 69
        )
    pageable = mode in {"latest", "genre", "4k"}
    has_previous = False
    has_next = False
    if pageable:
        for attrs in parser.links[:32]:
            relations = {token.lower() for token in attrs.get("rel", "").split()}
            href = attrs.get("href", "")
            try:
                candidate = _normalize_provider_url(href)
            except HelperError:
                continue
            if (
                "prev" in relations
                and page > 1
                and _listing_route_matches(mode, query, genre, page - 1, candidate)
            ):
                has_previous = True
            if (
                "next" in relations
                and page < MAX_PAGE
                and _listing_route_matches(mode, query, genre, page + 1, candidate)
            ):
                has_next = True
    title = _bounded_text(" ".join(parser.title_parts), 300)
    total_match = re.match(r"^([0-9,]+)\+", title)
    total_hint = (
        min(int(total_match.group(1).replace(",", "")), 9_007_199_254_740_991)
        if total_match
        else 0
    )
    meta = {
        "current_page": page,
        "has_previous": has_previous,
        "has_next": has_next,
        "pageable": pageable,
        "total_hint": total_hint,
        "count": len(items),
    }
    return items, meta


def _parse_details(markup: str, slug: str) -> dict[str, Any]:
    if _challenge_page(markup):
        raise HelperError(
            "challenge",
            "MotionBGS returned an anti-bot challenge; no bypass was attempted",
            77,
        )
    parser = _DetailParser()
    try:
        parser.feed(markup)
        parser.close()
    except HelperError:
        raise
    except Exception as error:
        raise HelperError(
            "site-markup", f"could not parse bounded MotionBGS details: {error}", 65
        ) from error
    title = _bounded_text(
        parser.metas.get("og:title") or " ".join(parser.title_parts), 240
    )
    title = re.sub(r"\s+live\s+wallpaper\s*$", "", title, flags=re.IGNORECASE)
    poster = _still_url(parser.metas.get("og:image", ""))
    preview = _video_url(parser.metas.get("og:video", ""))
    if not preview:
        for attrs in parser.sources:
            media_type = attrs.get("type", "").split(";", 1)[0].lower()
            candidate = _video_url(attrs.get("src", ""))
            if candidate and (media_type in {"", "video/mp4"}):
                preview = candidate
                break
    downloads: dict[str, Any] = {}
    wallpaper_id = ""
    for anchor in parser.anchors:
        href = anchor["attrs"].get("href", "")
        try:
            normalized = _normalize_provider_url(href)
        except HelperError:
            continue
        match = DOWNLOAD_PATH_RE.fullmatch(urlsplit(normalized).path)
        if match is None:
            continue
        quality, identifier = match.groups()
        body = _bounded_text(" ".join(anchor["text"]), 240)
        resolution = ""
        resolution_match = re.search(r"([0-9]{2,5})\s*[xX]\s*([0-9]{2,5})", body)
        if resolution_match:
            resolution = f"{resolution_match.group(1)}x{resolution_match.group(2)}"
        size_match = re.search(
            r"\(([0-9]+(?:\.[0-9]+)?)\s*MB\)", body, flags=re.IGNORECASE
        )
        downloads[quality] = {
            "id": identifier,
            "quality": quality,
            "label": quality.upper(),
            "resolution": resolution,
            "advertised_size_mb": float(size_match.group(1)) if size_match else 0,
            "url": f"{ORIGIN}/dl/{quality}/{identifier}/",
        }
        wallpaper_id = wallpaper_id or identifier
    if not downloads or not wallpaper_id:
        raise HelperError(
            "site-markup",
            "MotionBGS did not expose recognizable HD/4K download links; its public markup may have changed",
            65,
        )
    duration_match = re.search(r'"duration"\s*:\s*"(PT[^"\\]{1,40})"', markup)
    return {
        "slug": slug,
        "id": wallpaper_id,
        "title": title or slug,
        "source_url": f"{ORIGIN}/{slug}",
        "preview_url": preview,
        "poster_url": poster,
        "duration": duration_match.group(1) if duration_match else "",
        "downloads": downloads,
        "fetched_at": int(time.time()),
        "provider": "MotionBGS",
    }


def _valid_item(item: Any) -> bool:
    if not isinstance(item, dict):
        return False
    try:
        slug = _slug(item.get("slug"))
    except HelperError:
        return False
    if (
        item.get("provider") != "MotionBGS"
        or item.get("source_url") != f"{ORIGIN}/{slug}"
    ):
        return False
    if (
        not isinstance(item.get("title"), str)
        or len(item["title"].encode("utf-8")) > 240
    ):
        return False
    identifier = item.get("id", "")
    quality = item.get("quality", "")
    if not isinstance(identifier, str) or (
        identifier and WALLPAPER_ID_RE.fullmatch(identifier) is None
    ):
        return False
    if not isinstance(quality, str) or len(quality.encode("utf-8")) > 20:
        return False
    thumbnail = item.get("thumbnail_url", "")
    return thumbnail == "" or _still_url(thumbnail) == thumbnail


def _valid_detail(detail: Any, expected_slug: str) -> bool:
    if not isinstance(detail, dict) or detail.get("slug") != expected_slug:
        return False
    if (
        detail.get("provider") != "MotionBGS"
        or detail.get("source_url") != f"{ORIGIN}/{expected_slug}"
    ):
        return False
    if not WALLPAPER_ID_RE.fullmatch(str(detail.get("id", ""))):
        return False
    if (
        not isinstance(detail.get("title"), str)
        or len(detail["title"].encode("utf-8")) > 240
    ):
        return False
    poster = detail.get("poster_url", "")
    preview = detail.get("preview_url", "")
    if (poster and _still_url(poster) != poster) or (
        preview and _video_url(preview) != preview
    ):
        return False
    downloads = detail.get("downloads")
    if not isinstance(downloads, dict) or not downloads:
        return False
    valid = False
    for quality, value in downloads.items():
        if quality not in {"hd", "4k"} or not isinstance(value, dict):
            return False
        identifier = str(value.get("id", ""))
        if not WALLPAPER_ID_RE.fullmatch(identifier) or value.get("quality") != quality:
            return False
        if value.get("url") != f"{ORIGIN}/dl/{quality}/{identifier}/":
            return False
        valid = True
    return valid and type(detail.get("fetched_at")) in (int, float)


def _cached_search(
    cache: dict[str, Any], request: dict[str, Any]
) -> dict[str, Any] | None:
    key = _cache_key(request)
    record = cache["searches"].get(key)
    if not isinstance(record, dict) or not _fresh(
        record.get("fetched_at"), request["cache_ttl_seconds"]
    ):
        return None
    for field in ("mode", "query", "genre", "page", "limit"):
        if record.get(field) != request[field]:
            return None
    items = record.get("items")
    meta = record.get("meta")
    source_url = record.get("source_url")
    unique_slugs = (
        {
            item.get("slug")
            for item in items
            if isinstance(item, dict) and isinstance(item.get("slug"), str)
        }
        if isinstance(items, list)
        else set()
    )
    if (
        not isinstance(items, list)
        or len(items) > request["limit"]
        or not all(_valid_item(item) for item in items)
        or len(unique_slugs) != len(items)
        or not isinstance(meta, dict)
        or not isinstance(source_url, str)
        or not _listing_route_matches(
            request["mode"],
            request["query"],
            request["genre"],
            request["page"],
            source_url,
        )
    ):
        return None
    if (
        meta.get("current_page") != request["page"]
        or type(meta.get("has_previous")) is not bool
        or type(meta.get("has_next")) is not bool
        or type(meta.get("pageable")) is not bool
        or type(meta.get("total_hint")) is not int
        or meta["total_hint"] < 0
        or meta.get("count") != len(items)
    ):
        return None
    return record


def _cached_detail(
    cache: dict[str, Any], request: dict[str, Any]
) -> dict[str, Any] | None:
    detail = cache["details"].get(request["slug"])
    if not _valid_detail(detail, request["slug"]):
        return None
    return (
        detail
        if _fresh(detail.get("fetched_at"), request["cache_ttl_seconds"])
        else None
    )


def _search(request: dict[str, Any], cache: dict[str, Any]) -> dict[str, Any]:
    cached = None if request["force"] else _cached_search(cache, request)
    if cached is not None:
        record = cached
        was_cached = True
    else:
        requested_url = _browse_url(
            request["mode"], request["query"], request["genre"], request["page"]
        )
        transfer = _fetch(
            request,
            requested_url,
            request["cache_directory"],
            MAX_HTML_BYTES,
            HTML_TIMEOUT_SECONDS,
            "text/html,application/xhtml+xml;q=0.9",
            "listing",
        )
        payload = _validate_html_transfer(transfer)
        _ensure_live(request)
        source_url = transfer["effective_url"]
        items, meta = _parse_listing(_decode_html(payload), request, source_url)
        _ensure_live(request)
        record = {
            "mode": request["mode"],
            "query": request["query"],
            "genre": request["genre"],
            "page": request["page"],
            "limit": request["limit"],
            "source_url": source_url,
            "fetched_at": int(time.time()),
            "items": items,
            "meta": meta,
        }
        key = _cache_key(request)
        cache["searches"][key] = record
        _touch_order(cache, "searches", key, MAX_SEARCH_CACHE)
        _save_cache(request["cache_directory"], cache)
        _ensure_live(request)
        was_cached = False
    return {
        "schema": 1,
        "ok": True,
        "action": "search",
        "request_id": request["request_id"],
        "cached": was_cached,
        "source_url": record["source_url"],
        "fetched_at": record["fetched_at"],
        "mode": record["mode"],
        "query": record["query"],
        "genre": record["genre"],
        "page": record["page"],
        "items": record["items"],
        "meta": record["meta"],
    }


def _fetch_detail(
    request: dict[str, Any], cache: dict[str, Any]
) -> tuple[dict[str, Any], bool]:
    detail = None if request["force"] else _cached_detail(cache, request)
    if detail is not None:
        return detail, True
    source_url = f"{ORIGIN}/{request['slug']}"
    transfer = _fetch(
        request,
        source_url,
        request["cache_directory"],
        MAX_HTML_BYTES,
        HTML_TIMEOUT_SECONDS,
        "text/html,application/xhtml+xml;q=0.9",
        "details",
    )
    if _site_path(transfer["effective_url"]) != _site_path(source_url):
        _remove_temporary(transfer["path"])
        raise HelperError("redirects", "detail request redirected to another page", 69)
    detail = _parse_details(
        _decode_html(_validate_html_transfer(transfer)), request["slug"]
    )
    _ensure_live(request)
    cache["details"][request["slug"]] = detail
    _touch_order(cache, "details", request["slug"], MAX_DETAIL_CACHE)
    _save_cache(request["cache_directory"], cache)
    _ensure_live(request)
    return detail, False


def _details(request: dict[str, Any], cache: dict[str, Any]) -> dict[str, Any]:
    detail, cached = _fetch_detail(request, cache)
    return {
        "schema": 1,
        "ok": True,
        "action": "details",
        "request_id": request["request_id"],
        "cached": cached,
        "source_url": detail["source_url"],
        "fetched_at": detail["fetched_at"],
        "selected": detail,
    }


def _sha256(path: str, request: dict[str, Any]) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as stream:
        while True:
            chunk = stream.read(1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            _ensure_live(request)
    return digest.hexdigest()


def _validate_mp4(
    path: str,
    content_type: str,
    maximum: int,
    request: dict[str, Any],
) -> tuple[int, str]:
    if content_type not in {"video/mp4", "application/octet-stream"}:
        raise HelperError(
            "content-type", f"expected MP4 but received {content_type or 'unknown'}", 65
        )
    info = _lstat_regular(path, maximum=maximum)
    with open(path, "rb") as stream:
        prefix = stream.read(64)
    if len(prefix) < 12 or prefix[4:8] != b"ftyp":
        raise HelperError(
            "content-type",
            "download MIME type did not match an ISO-BMFF ftyp signature",
            65,
        )
    box_size = int.from_bytes(prefix[:4], "big")
    if box_size != 0 and (box_size < 12 or box_size > info.st_size):
        raise HelperError(
            "content-type", "MP4 ftyp box has an invalid declared size", 65
        )
    return info.st_size, _sha256(path, request)


def _validate_download_route(value: str, quality: str, identifier: str) -> str:
    """Bind a successful transfer to the detail record that authorized it."""
    normalized = _normalize_provider_url(value)
    parsed = urlsplit(normalized)
    if parsed.query:
        raise HelperError(
            "redirects", "download resolved to a URL with unexpected query data", 69
        )
    download_match = DOWNLOAD_PATH_RE.fullmatch(parsed.path)
    if download_match is not None:
        if download_match.groups() == (quality, identifier):
            return normalized
        raise HelperError(
            "redirects", "download resolved to a different MotionBGS media id", 69
        )
    video_match = VIDEO_PATH_RE.fullmatch(parsed.path)
    if video_match is not None and video_match.group(1) == identifier:
        return normalized
    raise HelperError(
        "redirects",
        "download resolved outside the authorized MotionBGS media route",
        69,
    )


def _download_destination(directory: str, slug: str, quality: str) -> str:
    stem = f"{slug}.{quality}"
    for suffix in range(0, 10_000):
        name = f"{stem}.mp4" if suffix == 0 else f"{stem}-{suffix}.mp4"
        candidate = f"{directory}/{name}"
        if not os.path.lexists(candidate) and not os.path.lexists(
            candidate + ".motionbgs.json"
        ):
            return candidate
    raise HelperError(
        "conflict", "could not allocate a unique MotionBGS download name", 73
    )


def _install_download(
    transfer_path: str,
    destination: str,
    sidecar_payload: bytes,
) -> tuple[str, str]:
    directory = os.path.dirname(destination)
    sidecar_destination = destination + ".motionbgs.json"
    sidecar_temp = _new_temporary(directory, ".motionbgs-metadata.")
    installed_media = False
    installed_sidecar = False
    try:
        descriptor = os.open(
            sidecar_temp,
            os.O_WRONLY
            | os.O_TRUNC
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
        try:
            _write_all(descriptor, sidecar_payload)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.link(transfer_path, destination, follow_symlinks=False)
        installed_media = True
        os.link(sidecar_temp, sidecar_destination, follow_symlinks=False)
        installed_sidecar = True
        os.unlink(transfer_path)
        os.unlink(sidecar_temp)
        _forget_temporary(transfer_path)
        _forget_temporary(sidecar_temp)
        return destination, sidecar_destination
    except BaseException as error:
        if installed_sidecar:
            try:
                os.unlink(sidecar_destination)
            except OSError:
                pass
        if installed_media:
            try:
                os.unlink(destination)
            except OSError:
                pass
        if isinstance(error, FileExistsError):
            raise HelperError(
                "conflict",
                "download destination appeared before no-replace installation",
                73,
            ) from error
        if isinstance(error, HelperError):
            raise
        if isinstance(error, OSError):
            raise HelperError(
                "local-io",
                f"could not install download and sidecar: {error.strerror}",
                74,
            ) from error
        raise


def _download(
    request: dict[str, Any], cache: dict[str, Any]
) -> tuple[dict[str, Any], tuple[str, str]]:
    detail, cached = _fetch_detail(request, cache)
    choice = detail["downloads"].get(request["quality"])
    if not isinstance(choice, dict) or not WALLPAPER_ID_RE.fullmatch(
        str(choice.get("id", ""))
    ):
        raise HelperError("quality", "selected MotionBGS quality is not available", 65)
    identifier = str(choice["id"])
    endpoint = f"{ORIGIN}/dl/{request['quality']}/{identifier}/"
    transfer = _fetch(
        request,
        endpoint,
        request["download_directory"],
        request["max_download_bytes"],
        request["download_timeout_seconds"],
        "video/mp4,application/octet-stream;q=0.8",
        "download",
    )
    try:
        transfer["effective_url"] = _validate_download_route(
            transfer["effective_url"], request["quality"], identifier
        )
        size, digest = _validate_mp4(
            transfer["path"],
            transfer["content_type"],
            request["max_download_bytes"],
            request,
        )
        if size != transfer["bytes"]:
            raise HelperError(
                "size-mismatch",
                "validated MP4 size did not match the transfer record",
                65,
            )
        destination = _download_destination(
            request["download_directory"], request["slug"], request["quality"]
        )
        downloaded_at = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        sidecar = {
            "schema": 1,
            "plugin": "goober/wall-in-one",
            "provider": "MotionBGS",
            "path": destination,
            "title": detail["title"],
            "source_page": detail["source_url"],
            "download_url": transfer["effective_url"],
            "quality": request["quality"],
            "content_type": transfer["content_type"],
            "bytes": size,
            "sha256": digest,
            "downloaded_at": downloaded_at,
        }
        sidecar_payload = _encode_json(sidecar, MAX_SIDECAR_BYTES)
        # The guard is the caller's revocable authority to install. Check it at
        # the last safe point before the first no-replace link is created.
        _ensure_live(request)
        installed_path, installed_sidecar = _install_download(
            transfer["path"], destination, sidecar_payload
        )
        try:
            _ensure_live(request)
        except BaseException:
            for installed_path_part in (installed_sidecar, installed_path):
                try:
                    os.unlink(installed_path_part)
                except OSError:
                    pass
            raise
    except BaseException:
        _remove_temporary(transfer["path"])
        raise
    response = {
        "schema": 1,
        "ok": True,
        "action": "download",
        "request_id": request["request_id"],
        "cached": cached,
        "source_url": detail["source_url"],
        "fetched_at": detail["fetched_at"],
        "selected": detail,
        "download": {
            "path": installed_path,
            "sidecar": installed_sidecar,
            "slug": request["slug"],
            "title": detail["title"],
            "quality": request["quality"],
            "bytes": size,
            "source_url": detail["source_url"],
            "download_url": transfer["effective_url"],
            "content_type": transfer["content_type"],
            "sha256": digest,
            "downloaded_at": downloaded_at,
        },
    }
    return response, (installed_path, installed_sidecar)


def _clear(request: dict[str, Any]) -> dict[str, Any]:
    _ensure_live(request)
    _save_cache(request["cache_directory"], _empty_cache())
    _ensure_live(request)
    return {
        "schema": 1,
        "ok": True,
        "action": "clear",
        "request_id": request["request_id"],
        "cleared": True,
    }


def _error_response(request: dict[str, Any], error: HelperError) -> dict[str, Any]:
    return {
        "schema": 1,
        "ok": False,
        "action": request["action"],
        "request_id": request["request_id"],
        "error": {"kind": error.kind, "message": error.message},
    }


def _rpc(request_path: str, response_path: str, guard_path: str) -> int:
    request = _load_request(request_path)
    response = _safe_absolute_path(response_path)
    _existing_directory(os.path.dirname(response))
    if not _is_within(response, request["cache_directory"]):
        raise HelperError(
            "invalid-path", "response must be inside the request cache directory", 64
        )
    guard = _safe_absolute_path(guard_path)
    if guard != request["guard_path"]:
        raise HelperError(
            "invalid-path", "command guard does not match the request envelope", 64
        )
    _require_guard(guard)
    if os.path.lexists(response):
        raise HelperError("conflict", "response path already exists", 73)
    installed: tuple[str, str] | None = None
    lock = _open_lock(request["cache_directory"], request)
    try:
        try:
            _ensure_live(request)
            try:
                if request["action"] == "clear":
                    result = _clear(request)
                else:
                    cache = _load_cache(request["cache_directory"])
                    if request["action"] == "search":
                        result = _search(request, cache)
                    elif request["action"] == "details":
                        result = _details(request, cache)
                    else:
                        result, installed = _download(request, cache)
            except Cancelled:
                raise
            except HelperError as error:
                result = _error_response(request, error)
            _ensure_live(request)
            payload = _encode_json(result, MAX_RESPONSE_BYTES)
            size = _write_no_replace(response, payload, MAX_RESPONSE_BYTES)
            try:
                _ensure_live(request)
            except BaseException:
                try:
                    os.unlink(response)
                except OSError:
                    pass
                raise
        except BaseException:
            try:
                os.unlink(response)
            except OSError:
                pass
            if installed is not None:
                for path in installed:
                    try:
                        os.unlink(path)
                    except OSError:
                        pass
            raise
    finally:
        try:
            fcntl.flock(lock, fcntl.LOCK_UN)
        finally:
            os.close(lock)
    _emit_fields(RPC_WIRE, "ok", request["request_id"], response, size)
    return 0


def _self_test() -> None:
    assert _normalize_provider_url("/search?q=space") == f"{ORIGIN}/search?q=space"
    assert (
        _normalize_provider_url("https://motionbgs.com:443/search?q=space")
        == f"{ORIGIN}/search?q=space"
    )
    try:
        _normalize_provider_url("https://motionbgs.com.evil.invalid/file")
    except HelperError:
        pass
    else:
        raise AssertionError("cross-origin URL accepted")
    assert _still_url("/i/c/364x205/media/42/fixture.jpg.webp").startswith(ORIGIN)
    assert _still_url("https://evil.invalid/media/42/fixture.jpg") == ""
    listing = """<!doctype html><html><head><title>1+ Fixture</title></head><body>
    <a href="/fixture-motion" title="Fixture Motion Live Wallpaper">
      <span class="ttl">Fixture Motion</span><span class="frm">HD</span>
      <img data-src="/i/c/364x205/media/42/fixture.jpg">
    </a></body></html>"""
    request = {
        "mode": "search",
        "query": "fixture motion",
        "genre": "",
        "page": 1,
        "limit": 48,
    }
    items, meta = _parse_listing(listing, request, f"{ORIGIN}/search?q=fixture+motion")
    assert (
        len(items) == 1 and items[0]["slug"] == "fixture-motion" and meta["count"] == 1
    )
    details = """<!doctype html><html><head>
      <meta property="og:title" content="Fixture Motion Live Wallpaper">
      <meta property="og:image" content="/media/42/poster.jpg">
    </head><body><a href="/dl/hd/42/">1920x1080 (3.0 MB)</a></body></html>"""
    selected = _parse_details(details, "fixture-motion")
    assert selected["downloads"]["hd"]["id"] == "42"


def _usage_error(wire: str, message: str) -> int:
    _emit_fields(wire, "error", "usage", message)
    return 64


def main(arguments: list[str]) -> int:
    if arguments == ["probe", "--protocol", "1"]:
        _emit_fields(PROBE_WIRE, "ok", PROTOCOL, VERSION, CAPABILITIES)
        return 0
    if arguments == ["self-test"]:
        try:
            _self_test()
        except Exception as error:
            _emit_fields(SELF_TEST_WIRE, "error", "self-test", _clean_field(error))
            return 1
        _emit_fields(SELF_TEST_WIRE, "ok", VERSION)
        return 0
    if arguments and arguments[0] == "rpc":
        if (
            len(arguments) != 9
            or arguments[1:3] != ["--protocol", "1"]
            or arguments[3] != "--request"
            or arguments[5] != "--response"
            or arguments[7] != "--guard"
        ):
            return _usage_error(
                RPC_WIRE,
                "rpc expects --protocol 1 --request ABS --response ABS --guard ABS",
            )
        try:
            return _rpc(arguments[4], arguments[6], arguments[8])
        except HelperError as error:
            _emit_rpc_error(error)
            return error.exit_code
        except Exception as error:
            failure = HelperError("internal", f"unexpected helper failure: {error}", 70)
            _emit_rpc_error(failure)
            return failure.exit_code
    wire = PROBE_WIRE if arguments and arguments[0] == "probe" else SELF_TEST_WIRE
    return _usage_error(wire, "expected probe --protocol 1, rpc ..., or self-test")


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except BrokenPipeError:
        raise SystemExit(74)
