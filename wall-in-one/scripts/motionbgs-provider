#!/usr/bin/env bash
set -uo pipefail

# Bounded launcher and protocol gate for either the separately installed
# wall-in-one-backend program's MotionBGS compatibility interface or the
# retired standalone MotionBGS program. This script performs no provider
# network work and parses no provider markup. Its only jobs are to validate the
# selected executable mode and transport paths, apply a file-size backstop, and
# pass through one exact bounded probe or RPC completion record.

readonly probe_wire='WIO-MBGS-PROBE1'
readonly rpc_wire='WIO-MBGS-RPC1'
readonly legacy_self_test_wire='WIO-MBG1'
readonly guard_wire='WIO-MBGS-GUARD1'
readonly max_request_bytes=$((8 * 1024))
readonly max_response_bytes=$((128 * 1024))
readonly max_protocol_bytes=4096
readonly max_rpc_file_kib=$((512 * 1024 + 128))

stdout_file=''
stderr_file=''
child_pid=''

clean_field() {
  local value=${1:-}
  value=${value//$'\t'/ }
  value=${value//$'\r'/ }
  value=${value//$'\n'/ }
  printf '%s' "${value:0:600}"
}

emit_error() {
  local wire=$1
  local kind=$2
  local detail=$3
  printf '%s\terror\t%s\t%s\n' \
    "$wire" "$(clean_field "$kind")" "$(clean_field "$detail")"
}

cleanup() {
  [[ -z $stdout_file ]] || rm -f -- "$stdout_file"
  [[ -z $stderr_file ]] || rm -f -- "$stderr_file"
  stdout_file=''
  stderr_file=''
}

cancelled() {
  if [[ -n $child_pid ]]; then
    kill -TERM -- "$child_pid" 2>/dev/null || true
    wait "$child_pid" 2>/dev/null || true
  fi
  child_pid=''
  cleanup
  exit 143
}

trap cleanup EXIT
trap cancelled HUP INT TERM

has_controls() {
  [[ ${1:-} == *[[:cntrl:]]* ]]
}

valid_absolute_path() {
  local value=${1:-}
  [[ $value == /* && $value != / && ${#value} -le 4096 ]] || return 1
  has_controls "$value" && return 1
  [[ $value != *\\* && $value != *'//'*
    && $value != *'/./'* && $value != */.
    && $value != *'/../'* && $value != */.. ]]
}

owned_regular_file() {
  local path=$1
  local minimum=$2
  local maximum=$3
  local owner size
  [[ -f $path && ! -L $path ]] || return 1
  owner=$(stat -c '%u' -- "$path" 2>/dev/null) || return 1
  size=$(stat -c '%s' -- "$path" 2>/dev/null) || return 1
  [[ $owner == "$(id -u)" && $size =~ ^[0-9]+$ ]] || return 1
  (( size >= minimum && size <= maximum ))
}

owned_writable_directory() {
  local path=$1
  local owner
  [[ -d $path && ! -L $path && -w $path && -x $path ]] || return 1
  owner=$(stat -c '%u' -- "$path" 2>/dev/null) || return 1
  [[ $owner == "$(id -u)" ]]
}

guard_ready() {
  local path=$1
  local bytes lines value
  owned_regular_file "$path" $(( ${#guard_wire} + 1 )) $(( ${#guard_wire} + 1 )) || return 1
  bytes=$(stat -c '%s' -- "$path" 2>/dev/null) || return 1
  [[ $bytes == $(( ${#guard_wire} + 1 )) ]] || return 1
  lines=$(wc -l <"$path") || return 1
  (( lines == 1 )) || return 1
  IFS= read -r value <"$path" || return 1
  [[ $value == "$guard_wire" ]]
}

resolve_binary() {
  local configured=$1
  local candidate=''
  has_controls "$configured" && return 1
  if [[ $configured == /* ]]; then
    valid_absolute_path "$configured" || return 1
    candidate=$configured
  elif [[ $configured == wall-in-one-backend ]]; then
    candidate=$(command -v wall-in-one-backend 2>/dev/null) || return 1
    [[ $candidate == /* ]] || return 1
    valid_absolute_path "$candidate" || return 1
  else
    return 1
  fi
  [[ -f $candidate && ! -L $candidate && -x $candidate ]] || return 1
  printf '%s' "$candidate"
}

binary_subcommand() {
  local mode=$1
  local operation=$2
  case "$mode:$operation" in
    unified:probe)
      printf '%s' 'motionbgs-probe'
      ;;
    unified:rpc)
      printf '%s' 'motionbgs-rpc'
      ;;
    legacy:probe)
      printf '%s' 'probe'
      ;;
    legacy:rpc)
      printf '%s' 'rpc'
      ;;
    *)
      return 1
      ;;
  esac
}

allocate_transport_files() {
  local directory=$1
  stdout_file=$(mktemp -- "$directory/.wall-in-one-motionbgs-stdout.XXXXXX") || return 1
  stderr_file=$(mktemp -- "$directory/.wall-in-one-motionbgs-stderr.XXXXXX") || {
    rm -f -- "$stdout_file"
    stdout_file=''
    return 1
  }
  chmod 0600 -- "$stdout_file" "$stderr_file" || return 1
}

run_bounded() {
  local file_limit_kib=$1
  shift
  (
    umask 077
    ulimit -f "$file_limit_kib" 2>/dev/null || exit 70
    exec env -u PYTHONHOME -u PYTHONPATH \
      PYTHONNOUSERSITE=1 PYTHONSAFEPATH=1 \
      "$@"
  ) >"$stdout_file" 2>"$stderr_file" &
  child_pid=$!
  local result=0
  wait "$child_pid" || result=$?
  child_pid=''
  return "$result"
}

protocol_line() {
  local bytes lines
  bytes=$(stat -c '%s' -- "$stdout_file" 2>/dev/null) || return 1
  [[ $bytes =~ ^[0-9]+$ ]] || return 1
  (( bytes >= 2 && bytes <= max_protocol_bytes )) || return 1
  lines=$(wc -l <"$stdout_file") || return 1
  (( lines == 1 )) || return 1
  IFS= read -r protocol_value <"$stdout_file" || return 1
  [[ -n $protocol_value ]] || return 1
  printf '%s' "$protocol_value"
}

bounded_failure_detail() {
  local detail=''
  if [[ -n $stderr_file && -f $stderr_file ]]; then
    detail=$(LC_ALL=C head -c 600 -- "$stderr_file" 2>/dev/null || true)
  fi
  if [[ -z $detail && -n $stdout_file && -f $stdout_file ]]; then
    detail=$(LC_ALL=C head -c 600 -- "$stdout_file" 2>/dev/null || true)
  fi
  clean_field "${detail:-external MotionBGS program returned no valid protocol record}"
}

valid_error_line() {
  local expected_wire=$1
  local line=$2
  local wire outcome kind detail extra
  IFS=$'\t' read -r wire outcome kind detail extra <<<"$line"
  [[ $wire == "$expected_wire" && $outcome == error && -n $kind && -n $detail && -z ${extra:-} ]]
}

probe_binary() {
  local mode=$1
  local configured=$2
  local binary subcommand
  subcommand=$(binary_subcommand "$mode" probe) || {
    emit_error "$probe_wire" usage 'mode must be unified or legacy'
    return 64
  }
  binary=$(resolve_binary "$configured") || {
    emit_error "$probe_wire" missing-binary 'configured MotionBGS program is absent or not executable'
    return 127
  }
  allocate_transport_files /tmp || {
    emit_error "$probe_wire" local-io 'could not allocate bounded probe transport files'
    return 73
  }
  local result=0 line=''
  run_bounded 8 "$binary" "$subcommand" --protocol 1 || result=$?
  line=$(protocol_line 2>/dev/null || true)
  if (( result != 0 )); then
    if valid_error_line "$probe_wire" "$line"; then
      printf '%s\n' "$line"
    else
      emit_error "$probe_wire" probe-failed "$(bounded_failure_detail)"
    fi
    return "$result"
  fi
  local wire outcome schema version capabilities extra
  IFS=$'\t' read -r wire outcome schema version capabilities extra <<<"$line"
  if [[ $wire != "$probe_wire" || $outcome != ok || $schema != 1
    || ! $version =~ ^[0-9]+\.[0-9]+\.[0-9]+([+-][A-Za-z0-9._-]+)?$
    || $capabilities != 'search,details,download,clear' || -n ${extra:-} ]]; then
    emit_error "$probe_wire" incompatible 'external program returned an incompatible capability probe'
    return 70
  fi
  printf '%s\n' "$line"
}

discard_invalid_response() {
  local response=$1
  if [[ -f $response && ! -L $response ]]; then
    local owner
    owner=$(stat -c '%u' -- "$response" 2>/dev/null || true)
    if [[ $owner == "$(id -u)" ]]; then
      rm -f -- "$response"
    fi
  fi
}

rpc_binary() {
  local mode=$1
  local configured=$2
  local request=$3
  local response=$4
  local guard=$5
  local binary response_directory subcommand
  subcommand=$(binary_subcommand "$mode" rpc) || {
    emit_error "$rpc_wire" usage 'mode must be unified or legacy'
    return 64
  }
  binary=$(resolve_binary "$configured") || {
    emit_error "$rpc_wire" missing-binary 'configured MotionBGS program is absent or not executable'
    return 127
  }
  if ! valid_absolute_path "$request" || ! owned_regular_file "$request" 1 "$max_request_bytes"; then
    emit_error "$rpc_wire" invalid-request 'request must be a current-user regular file of at most 8 KiB'
    return 64
  fi
  if ! valid_absolute_path "$response"; then
    emit_error "$rpc_wire" invalid-path 'response path must be a safe absolute path'
    return 64
  fi
  response_directory=${response%/*}
  if ! owned_writable_directory "$response_directory"; then
    emit_error "$rpc_wire" invalid-path 'response parent must be a current-user writable directory'
    return 72
  fi
  if [[ -e $response || -L $response ]]; then
    emit_error "$rpc_wire" conflict 'response path already exists'
    return 73
  fi
  if ! valid_absolute_path "$guard" \
    || [[ ${guard%/*} != "$response_directory" ]] \
    || [[ ! ${guard##*/} =~ ^\.wall-in-one-motionbgs-guard-[A-Za-z0-9._-]{1,160}$ ]] \
    || ! guard_ready "$guard"; then
    emit_error "$rpc_wire" cancelled 'RPC cancellation guard is absent or invalid'
    return 75
  fi
  allocate_transport_files "$response_directory" || {
    emit_error "$rpc_wire" local-io 'could not allocate bounded RPC transport files'
    return 73
  }

  local result=0 line=''
  run_bounded "$max_rpc_file_kib" \
    "$binary" "$subcommand" --protocol 1 --request "$request" --response "$response" --guard "$guard" || result=$?
  line=$(protocol_line 2>/dev/null || true)
  if (( result != 0 )); then
    discard_invalid_response "$response"
    if valid_error_line "$rpc_wire" "$line"; then
      printf '%s\n' "$line"
    else
      emit_error "$rpc_wire" launch-failed "$(bounded_failure_detail)"
    fi
    return "$result"
  fi

  if ! guard_ready "$guard"; then
    discard_invalid_response "$response"
    emit_error "$rpc_wire" cancelled 'RPC cancellation guard was removed before completion'
    return 75
  fi

  local wire outcome request_id installed reported_bytes extra actual_bytes
  IFS=$'\t' read -r wire outcome request_id installed reported_bytes extra <<<"$line"
  if [[ $wire != "$rpc_wire" || $outcome != ok
    || ! $request_id =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$
    || $installed != "$response" || ! $reported_bytes =~ ^[0-9]+$
    || -n ${extra:-} ]]; then
    discard_invalid_response "$response"
    emit_error "$rpc_wire" protocol 'external program returned a malformed RPC completion record'
    return 70
  fi
  if ! owned_regular_file "$response" 2 "$max_response_bytes"; then
    discard_invalid_response "$response"
    emit_error "$rpc_wire" protocol 'external program did not install a bounded regular response'
    return 70
  fi
  actual_bytes=$(stat -c '%s' -- "$response" 2>/dev/null || printf 0)
  if [[ $actual_bytes != "$reported_bytes" ]]; then
    discard_invalid_response "$response"
    emit_error "$rpc_wire" protocol 'RPC response size did not match its completion record'
    return 70
  fi
  if [[ $(LC_ALL=C head -c 1 -- "$response" 2>/dev/null) != '{' ]]; then
    discard_invalid_response "$response"
    emit_error "$rpc_wire" protocol 'RPC response did not contain a JSON object'
    return 70
  fi
  printf '%s\n' "$line"
}

self_test() {
  local command=''
  valid_absolute_path '/tmp/wall-in-one-motionbgs/request-1.json' || return 1
  ! valid_absolute_path '/tmp/wall-in-one-motionbgs/../escape' || return 1
  ! valid_absolute_path $'/tmp/wall-in-one-motionbgs/bad\npath' || return 1
  resolve_binary '/definitely/missing/wall-in-one-backend' >/dev/null 2>&1 && return 1
  command=$(binary_subcommand unified probe) || return 1
  [[ $command == motionbgs-probe ]] || return 1
  command=$(binary_subcommand unified rpc) || return 1
  [[ $command == motionbgs-rpc ]] || return 1
  command=$(binary_subcommand legacy probe) || return 1
  [[ $command == probe ]] || return 1
  command=$(binary_subcommand legacy rpc) || return 1
  [[ $command == rpc ]] || return 1
  binary_subcommand invalid probe >/dev/null 2>&1 && return 1
  binary_subcommand unified invalid >/dev/null 2>&1 && return 1
  valid_error_line "$rpc_wire" $'WIO-MBGS-RPC1\terror\tfixture\tbounded failure' || return 1
  ! valid_error_line "$rpc_wire" $'WIO-MBGS-PROBE1\terror\tfixture\twrong wire' || return 1
  [[ $(( ${#guard_wire} + 1 )) == 16 ]] || return 1
  printf '%s\tok\tself-test\n' "$legacy_self_test_wire"
}

case ${1:-} in
  probe)
    if (( $# == 2 )); then
      # Compatibility for callers predating the explicit mode argument. The
      # implicit form can select only the unified backend, never legacy mode.
      probe_binary unified "$2"
    elif (( $# == 3 )); then
      probe_binary "$2" "$3"
    else
      emit_error "$probe_wire" usage 'probe expects [MODE] BINARY; MODE is unified or legacy'
      exit 64
    fi
    ;;
  rpc)
    if (( $# == 5 )); then
      # As above, the legacy-free historical form remains unified-only.
      rpc_binary unified "$2" "$3" "$4" "$5"
    elif (( $# == 6 )); then
      rpc_binary "$2" "$3" "$4" "$5" "$6"
    else
      emit_error "$rpc_wire" usage \
        'rpc expects [MODE] BINARY REQUEST RESPONSE GUARD; MODE is unified or legacy'
      exit 64
    fi
    ;;
  self-test)
    (( $# == 1 )) || {
      emit_error "$rpc_wire" usage 'self-test accepts no arguments'
      exit 64
    }
    self_test || {
      emit_error "$rpc_wire" self-test 'motionbgs-provider launcher self-test failed'
      exit 1
    }
    ;;
  *)
    emit_error "$rpc_wire" usage \
      'expected probe [MODE] BINARY, rpc [MODE] BINARY REQUEST RESPONSE GUARD, or self-test; MODE is unified or legacy'
    exit 64
    ;;
esac
