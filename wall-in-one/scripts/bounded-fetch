#!/usr/bin/env bash
set -uo pipefail

# Bounded HTTPS transport for Wall-in-One's small first-party integrations.
#
# The Luau services choose one of the profiles below and supply a unique
# response path plus a short-lived cancellation guard.  This process owns all
# ingress: curl writes only to a mode-0600 temporary file under RLIMIT_FSIZE,
# and a successful response is installed with a no-replace hard link.  API
# credentials, when present, are read by curl from a private header file and
# never appear in either process' argv.

readonly protocol='WIO-FETCH1'
readonly user_agent='Wall-in-One/0.5 (+https://github.com/Go08er/goober-noctalia-plugins-v5)'

body=''
credential_cleanup=''
guard_cleanup=''

clean_field() {
  local value=${1:-}
  value=${value//$'\t'/ }
  value=${value//$'\r'/ }
  value=${value//$'\n'/ }
  printf '%s' "${value:0:600}"
}

emit_error() {
  printf '%s\terror\t%s\t%s\t%s\n' \
    "$protocol" "$(clean_field "${1:-unknown}")" \
    "$(clean_field "${2:-0}")" "$(clean_field "${3:-request failed}")"
}

emit_ok() {
  printf '%s\tok\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$protocol" "$(clean_field "$1")" "$(clean_field "$2")" \
    "$(clean_field "$3")" "$(clean_field "$4")" \
    "$(clean_field "$5")" "$(clean_field "$6")"
}

cleanup() {
  [[ -z $body ]] || rm -f -- "$body"
  [[ -z $credential_cleanup ]] || rm -f -- "$credential_cleanup"
  [[ -z $guard_cleanup ]] || rm -f -- "$guard_cleanup"
}

cancelled() {
  cleanup
  body=''
  credential_cleanup=''
  guard_cleanup=''
  exit 143
}

die() {
  emit_error "$1" "$2" "$3"
  exit "${4:-1}"
}

has_controls() {
  [[ ${1:-} == *$'\t'* || ${1:-} == *$'\r'* || ${1:-} == *$'\n'* ]]
}

valid_absolute_path() {
  local value=${1:-}
  [[ $value == /* && $value != / && ${#value} -le 4096 ]] || return 1
  has_controls "$value" && return 1
  [[ $value != *\\* && $value != *'//'*
    && $value != *'/./'* && $value != */.
    && $value != *'/../'* && $value != */.. ]]
}

valid_url() {
  local profile=$1
  local url=$2
  local api_search_re='^https://wallhaven\.cc/api/v1/search\?[-A-Za-z0-9._~%=&,]+$'
  local api_detail_re='^https://wallhaven\.cc/api/v1/w/[a-z0-9]{6}$'
  local wallhaven_media_re='^https://w\.wallhaven\.cc/full/[a-z0-9]{2}/wallhaven-[a-z0-9]{6}\.(jpg|png)$'
  [[ ${#url} -le 2048 ]] || return 1
  has_controls "$url" && return 1
  [[ $url != *\\* && $url != *'#'* ]] || return 1

  case $profile in
    wallhaven-api)
      [[ $url =~ $api_search_re || $url =~ $api_detail_re ]]
      ;;
    palette-catalog)
      [[ $url == 'https://api.noctalia.dev/palettes' ]]
      ;;
    wallhaven-media)
      [[ $url =~ $wallhaven_media_re ]]
      ;;
    *)
      return 1
      ;;
  esac
}

guard_ready() {
  local guard=$1
  [[ -f $guard && ! -L $guard ]] || return 1
  [[ $(stat -c '%u' -- "$guard" 2>/dev/null) == "$(id -u)" ]] || return 1
  [[ $(stat -c '%s' -- "$guard" 2>/dev/null) == 11 ]] || return 1
  [[ $(LC_ALL=C head -c 11 -- "$guard" 2>/dev/null) == "$protocol" ]]
}

validate_credential() {
  local credential=$1
  local output_dir=$2
  [[ $credential != - ]] || return 0
  valid_absolute_path "$credential" || return 1
  [[ ${credential%/*} == "$output_dir" ]] || return 1
  [[ ${credential##*/} =~ ^\.wall-in-one-secret-[A-Za-z0-9._-]{1,160}$ ]] || return 1
  [[ -f $credential && ! -L $credential ]] || return 1
  [[ $(stat -c '%u' -- "$credential" 2>/dev/null) == "$(id -u)" ]] || return 1
  local bytes line
  bytes=$(stat -c '%s' -- "$credential" 2>/dev/null) || return 1
  [[ $bytes =~ ^[0-9]+$ ]] && (( bytes >= 12 && bytes <= 280 )) || return 1
  IFS= read -r line <"$credential" || return 1
  if IFS= read -r _ < <(tail -n +2 -- "$credential"); then
    return 1
  fi
  [[ $line =~ ^X-API-Key:\ [A-Za-z0-9_-]{1,256}$ ]] || return 1
  chmod 0600 -- "$credential" || return 1
}

profile_settings() {
  case $1 in
    wallhaven-api)
      max_bytes=$((512 * 1024))
      max_seconds=30
      accept='application/json'
      ;;
    palette-catalog)
      max_bytes=$((2 * 1024 * 1024))
      max_seconds=30
      accept='application/json'
      ;;
    wallhaven-media)
      [[ ${2:-} =~ ^[0-9]+$ ]] || return 1
      max_bytes=$2
      (( max_bytes >= 1 && max_bytes <= 64 * 1024 * 1024 )) || return 1
      max_seconds=120
      accept='image/jpeg,image/png;q=0.9'
      ;;
    *)
      return 1
      ;;
  esac
}

content_type_allowed() {
  local profile=$1
  local url=$2
  local content_type=${3,,}
  content_type=${content_type%%;*}
  content_type=${content_type//[[:space:]]/}
  case $profile in
    wallhaven-api|palette-catalog)
      [[ $content_type == application/json ]]
      ;;
    wallhaven-media)
      if [[ $url == *.jpg ]]; then
        [[ $content_type == image/jpeg ]]
      else
        [[ $content_type == image/png ]]
      fi
      ;;
  esac
}

image_signature_allowed() {
  local url=$1
  local path=$2
  local signature
  if [[ $url == *.jpg ]]; then
    signature=$(LC_ALL=C od -An -tx1 -N3 -- "$path" 2>/dev/null | tr -d ' \n')
    [[ $signature == ffd8ff ]]
  else
    signature=$(LC_ALL=C od -An -tx1 -N8 -- "$path" 2>/dev/null | tr -d ' \n')
    [[ $signature == 89504e470d0a1a0a ]]
  fi
}

self_test() {
  valid_url wallhaven-api 'https://wallhaven.cc/api/v1/search?q=night&page=1' || return 1
  valid_url wallhaven-api 'https://wallhaven.cc/api/v1/w/abc123' || return 1
  valid_url palette-catalog 'https://api.noctalia.dev/palettes' || return 1
  valid_url wallhaven-media 'https://w.wallhaven.cc/full/ab/wallhaven-abc123.jpg' || return 1
  ! valid_url wallhaven-api 'http://wallhaven.cc/api/v1/search?q=x' || return 1
  ! valid_url wallhaven-api 'https://wallhaven.cc.evil.invalid/api/v1/search?q=x' || return 1
  ! valid_url palette-catalog 'https://api.noctalia.dev/palettes/extra' || return 1
  ! valid_url wallhaven-media 'https://w.wallhaven.cc/full/ab/../wallhaven-abc123.jpg' || return 1
  printf '%s\tok\tself-test\n' "$protocol"
}

if [[ ${1:-} == self-test ]]; then
  self_test || {
    emit_error self-test 0 'bounded-fetch self-test failed'
    exit 1
  }
  exit 0
fi

if (( $# != 6 )); then
  die usage 0 'usage: bounded-fetch PROFILE URL OUTPUT GUARD HEADER-FILE|- EXPECTED-BYTES' 64
fi

readonly profile=$1
readonly url=$2
readonly output=$3
readonly guard=$4
readonly credential=$5
readonly expected_bytes=$6

valid_url "$profile" "$url" || die invalid-url 0 'URL is outside the selected HTTPS profile' 64
valid_absolute_path "$output" || die invalid-path 0 'response path must be a safe absolute path' 64
valid_absolute_path "$guard" || die invalid-path 0 'guard path must be a safe absolute path' 64

readonly output_dir=${output%/*}
[[ -d $output_dir && -w $output_dir ]] || die invalid-path 0 'response parent must already exist and be writable' 72
[[ ${guard%/*} == "$output_dir" ]] || die invalid-path 0 'guard and response must share a parent directory' 64
[[ ${guard##*/} =~ ^\.wall-in-one-guard-[A-Za-z0-9._-]{1,160}$ ]] \
  || die invalid-path 0 'guard filename is invalid' 64
[[ ! -e $output && ! -L $output ]] || die conflict 0 'response path already exists' 73
guard_ready "$guard" || die cancelled 0 'request guard is absent or invalid' 75

guard_cleanup=$guard
trap cleanup EXIT
trap cancelled HUP INT TERM

if [[ $profile == wallhaven-api ]]; then
  if [[ $credential != - ]]; then
    if ! { valid_absolute_path "$credential" \
      && [[ ${credential%/*} == "$output_dir" ]] \
      && [[ ${credential##*/} =~ ^\.wall-in-one-secret-[A-Za-z0-9._-]{1,160}$ ]] \
      && [[ -f $credential && ! -L $credential ]] \
      && [[ $(stat -c '%u' -- "$credential" 2>/dev/null) == "$(id -u)" ]]; }; then
      die credential 0 'private Wallhaven header path is unsafe' 65
    fi
    credential_cleanup=$credential
  fi
  validate_credential "$credential" "$output_dir" \
    || die credential 0 'private Wallhaven header file is invalid' 65
elif [[ $credential != - ]]; then
  die credential 0 'this profile does not accept a credential file' 64
fi

max_bytes=0
max_seconds=0
accept=''
profile_settings "$profile" "$expected_bytes" || die invalid-limit 0 'profile size limit is invalid' 64
command -v curl >/dev/null 2>&1 || die missing-curl 0 'curl is required for bounded HTTPS transport' 127
command -v stat >/dev/null 2>&1 || die missing-tool 0 'stat is required for bounded HTTPS transport' 127
command -v mktemp >/dev/null 2>&1 || die missing-tool 0 'mktemp is required for bounded HTTPS transport' 127

umask 077
body=$(mktemp -- "$output_dir/.wall-in-one-fetch-body.XXXXXX") \
  || die local-io 0 'could not allocate a bounded response file' 73

curl_arguments=(
  --disable
  --silent --show-error
  --request GET
  --connect-timeout 10
  --max-time "$max_seconds"
  --max-filesize "$max_bytes"
  --speed-limit 1024
  --speed-time 15
  --proto '=https'
  --proto-redir '=https'
  --max-redirs 0
  --tlsv1.2
  --header "Accept: $accept"
  --user-agent "$user_agent"
  --output "$body"
  --write-out $'%{http_code}\t%{url_effective}\t%{content_type}\t%{size_download}'
  --url "$url"
)
if [[ $credential != - ]]; then
  curl_arguments+=(--header "@$credential")
fi

transfer=$(
  (
    ulimit -f "$(((max_bytes + 1023) / 1024))" 2>/dev/null || exit 70
    exec curl "${curl_arguments[@]}"
  )
)
curl_rc=$?
if (( curl_rc != 0 )); then
  case $curl_rc in
    28) die timeout 0 "request exceeded its ${max_seconds}s deadline" 69 ;;
    63|153) die size-limit 0 'response exceeded its hard byte limit' 65 ;;
    *) die transport 0 "curl failed (code $curl_rc)" 69 ;;
  esac
fi

IFS=$'\t' read -r status effective_url content_type reported_bytes <<<"$transfer"
[[ $status =~ ^[0-9]{3}$ ]] || die protocol 0 'curl returned an invalid HTTP status' 70
[[ $effective_url == "$url" ]] || die redirects "$status" 'redirects and effective-URL changes are forbidden' 69
[[ $reported_bytes =~ ^[0-9]+([.][0-9]+)?$ ]] || die protocol "$status" 'curl returned an invalid byte count' 70

if [[ $status != 2?? ]]; then
  die http "$status" "remote endpoint returned HTTP $status" 69
fi
content_type_allowed "$profile" "$url" "$content_type" \
  || die content-type "$status" "unexpected response type ${content_type:-unknown}" 65

bytes=$(stat -c '%s' -- "$body" 2>/dev/null) || die local-io "$status" 'could not inspect response file' 74
[[ $bytes =~ ^[0-9]+$ ]] || die local-io "$status" 'response size is invalid' 74
(( bytes >= 1 && bytes <= max_bytes )) || die size-limit "$status" 'response was empty or exceeded its byte limit' 65
if [[ $profile == wallhaven-media ]]; then
  (( bytes == expected_bytes )) || die size-mismatch "$status" 'media size did not match Wallhaven metadata' 65
  image_signature_allowed "$url" "$body" || die content-type "$status" 'media signature did not match its URL' 65
fi

guard_ready "$guard" || die cancelled "$status" 'request was cancelled before response installation' 75
ln -- "$body" "$output" 2>/dev/null || die conflict "$status" 'could not install response without replacement' 73
rm -f -- "$body"
body=''
[[ -z $credential_cleanup ]] || rm -f -- "$credential_cleanup"
credential_cleanup=''
rm -f -- "$guard"
guard_cleanup=''
trap - EXIT HUP INT TERM

normalized_type=${content_type%%;*}
normalized_type=${normalized_type,,}
normalized_type=${normalized_type//[[:space:]]/}
emit_ok "$profile" "$status" "$effective_url" "$normalized_type" "$bytes" "$output"
