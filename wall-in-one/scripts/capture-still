#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'usage: capture-still <video|image|copy> <source> <destination> [value]\n' >&2
  exit 64
}

[[ $# -ge 3 && $# -le 4 ]] || usage

mode=$1
source=$2
destination=$3
value=${4:-}

case "$destination" in
  /*) ;;
  *)
    printf 'capture-still: destination must be absolute\n' >&2
    exit 64
    ;;
esac

destination_dir=${destination%/*}
destination_name=${destination##*/}
[[ -n "$destination_dir" && -n "$destination_name" ]] || usage
mkdir -p -- "$destination_dir"

stem=${destination_name%.*}
temporary=$(mktemp --tmpdir="$destination_dir" ".${stem}.XXXXXXXX.part")
cleanup() {
  rm -f -- "$temporary"
}
trap cleanup EXIT HUP INT TERM

validate_image_signature() {
  local prefix suffix
  prefix=$(od -An -tx1 -N 16 -- "$temporary" | tr -d '[:space:]')
  suffix=$(tail -c 12 -- "$temporary" | od -An -tx1 | tr -d '[:space:]')
  case "$prefix" in
    89504e470d0a1a0a*) [[ "$suffix" == 0000000049454e44ae426082 ]] ;;
    ffd8ff*) [[ "$suffix" == *ffd9 ]] ;;
    474946383761* | 474946383961*) [[ "$suffix" == *3b ]] ;;
    52494646????????57454250*) validate_webp_structure ;;
    # AVIF's ISO-BMFF box graph cannot be established from a short magic
    # prefix. Without FFmpeg, fail closed instead of promoting header bytes.
    ????????6674797061766966* | ????????6674797061766973*) return 1 ;;
    *) return 1 ;;
  esac
}

validate_webp_structure() {
  local file_size declared offset chunk chunk_size next image_chunk=0
  local b0 b1 b2 b3
  file_size=$(stat -c '%s' -- "$temporary") || return 1
  ((file_size >= 20)) || return 1
  read -r b0 b1 b2 b3 < <(od -An -tu1 -j 4 -N 4 -- "$temporary") || return 1
  declared=$((b0 + b1 * 256 + b2 * 65536 + b3 * 16777216))
  ((declared + 8 == file_size)) || return 1

  offset=12
  while ((offset + 8 <= file_size)); do
    chunk=$(od -An -tx1 -j "$offset" -N 4 -- "$temporary" | tr -d '[:space:]') || return 1
    read -r b0 b1 b2 b3 < <(od -An -tu1 -j $((offset + 4)) -N 4 -- "$temporary") || return 1
    chunk_size=$((b0 + b1 * 256 + b2 * 65536 + b3 * 16777216))
    next=$((offset + 8 + chunk_size + chunk_size % 2))
    ((next > offset && next <= file_size)) || return 1
    case "$chunk" in
      56503820 | 5650384c) image_chunk=1 ;;
    esac
    offset=$next
  done
  ((offset == file_size && image_chunk == 1))
}

case "$mode" in
  video)
    command -v ffmpeg >/dev/null 2>&1 || {
      printf 'capture-still: ffmpeg is required for video extraction\n' >&2
      exit 69
    }
    [[ -f "$source" ]] || {
      printf 'capture-still: video source does not exist\n' >&2
      exit 66
    }
    second=${value:-1}
    [[ "$second" =~ ^[0-9]+$ ]] || usage
    ffmpeg -nostdin -y -loglevel error -ss "$second" -i "$source" \
      -frames:v 1 -c:v png -f image2 "$temporary"
    ;;
  image)
    command -v ffmpeg >/dev/null 2>&1 || {
      printf 'capture-still: ffmpeg is required to decode an animated preview\n' >&2
      exit 69
    }
    [[ -f "$source" ]] || {
      printf 'capture-still: image source does not exist\n' >&2
      exit 66
    }
    ffmpeg -nostdin -y -loglevel error -i "$source" \
      -frames:v 1 -c:v png -f image2 "$temporary"
    ;;
  copy)
    [[ -f "$source" ]] || {
      printf 'capture-still: image source does not exist\n' >&2
      exit 66
    }
    cp -- "$source" "$temporary"
    ;;
  *) usage ;;
esac

[[ -s "$temporary" ]] || {
  printf 'capture-still: extractor produced no image\n' >&2
  exit 65
}

if command -v ffmpeg >/dev/null 2>&1; then
  ffmpeg -nostdin -v error -i "$temporary" -frames:v 1 -f null - >/dev/null
elif ! validate_image_signature; then
  printf 'capture-still: copied source is not a recognized complete image\n' >&2
  exit 65
fi

mv -f -- "$temporary" "$destination"
trap - EXIT HUP INT TERM
printf '%s\n' "$destination"
