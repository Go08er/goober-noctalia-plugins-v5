#!/usr/bin/env bash
set -uo pipefail

# Bounded launcher and protocol gate for the separately installed
# wall-in-one-backend program. The launcher performs no library scan or
# provider parsing; it validates the process and file boundary and applies a
# kernel file-size backstop.

readonly probe_wire='WIO-BACKEND-PROBE1'
readonly rpc_wire='WIO-BACKEND-RPC1'
readonly self_test_wire='WIO-BACKEND-SELFTEST1'
readonly guard_wire='WIO-BACKEND-GUARD1'
readonly max_request_bytes=$((64 * 1024))
readonly max_response_bytes=$((128 * 1024))
readonly max_protocol_bytes=4096
# The generic surface includes a 64 MiB Wallhaven payload.  Bash's `ulimit -f`
# is expressed in KiB on the supported hosts, so leave 128 KiB of headroom for
# that single file while the backend's action-specific limits remain tighter
# (128 KiB metadata, 2 MiB palette/preview data, or 64 MiB media).  This outer
# ceiling is inherited by child curl processes and therefore must not be lower
# than any live action's declared maximum.
readonly max_rpc_file_kib=$((64 * 1024 + 128))

stdout_file=''
stderr_file=''
child_pid=''

clean_field() {
  local value=${1:-}
  value=${value//$'\t'/ }
  value=${value//$'\r'/ }
  value=${value//$'\n'/ }
  printf '%s' "${value:0:600}"
}

emit_error() {
  local wire=$1
  local kind=$2
  local detail=$3
  printf '%s\terror\t%s\t%s\n' \
    "$wire" "$(clean_field "$kind")" "$(clean_field "$detail")"
}

cleanup() {
  [[ -z $stdout_file ]] || rm -f -- "$stdout_file"
  [[ -z $stderr_file ]] || rm -f -- "$stderr_file"
  stdout_file=''
  stderr_file=''
}

cancelled() {
  if [[ -n $child_pid ]]; then
    kill -TERM -- "$child_pid" 2>/dev/null || true
    wait "$child_pid" 2>/dev/null || true
  fi
  child_pid=''
  cleanup
  exit 143
}

trap cleanup EXIT
trap cancelled HUP INT TERM

has_controls() {
  [[ ${1:-} == *[[:cntrl:]]* ]]
}

valid_absolute_path() {
  local value=${1:-}
  [[ $value == /* && $value != / && ${#value} -le 4096 ]] || return 1
  has_controls "$value" && return 1
  [[ $value != *\\* && $value != *'//'* \
    && $value != *'/./'* && $value != */. \
    && $value != *'/../'* && $value != */.. ]]
}

owned_regular_file() {
  local path=$1
  local minimum=$2
  local maximum=$3
  local owner size
  [[ -f $path && ! -L $path ]] || return 1
  owner=$(stat -c '%u' -- "$path" 2>/dev/null) || return 1
  size=$(stat -c '%s' -- "$path" 2>/dev/null) || return 1
  [[ $owner == "$(id -u)" && $size =~ ^[0-9]+$ ]] || return 1
  (( size >= minimum && size <= maximum ))
}

owned_writable_directory() {
  local path=$1
  local owner
  [[ -d $path && ! -L $path && -w $path && -x $path ]] || return 1
  owner=$(stat -c '%u' -- "$path" 2>/dev/null) || return 1
  [[ $owner == "$(id -u)" ]]
}

same_parent() {
  local first=$1
  local second=$2
  [[ ${first%/*} == "${second%/*}" ]]
}

guard_ready() {
  local path=$1
  local expected_bytes=$(( ${#guard_wire} + 1 ))
  local lines value
  owned_regular_file "$path" "$expected_bytes" "$expected_bytes" || return 1
  lines=$(wc -l <"$path") || return 1
  (( lines == 1 )) || return 1
  IFS= read -r value <"$path" || return 1
  [[ $value == "$guard_wire" ]]
}

resolve_binary() {
  local configured=$1
  local candidate=''
  has_controls "$configured" && return 1
  if [[ $configured == /* ]]; then
    valid_absolute_path "$configured" || return 1
    candidate=$configured
  elif [[ $configured == wall-in-one-backend ]]; then
    candidate=$(command -v wall-in-one-backend 2>/dev/null) || return 1
    [[ $candidate == /* ]] || return 1
    valid_absolute_path "$candidate" || return 1
  else
    return 1
  fi
  [[ -f $candidate && ! -L $candidate && -x $candidate ]] || return 1
  printf '%s' "$candidate"
}

allocate_transport_files() {
  local directory=$1
  stdout_file=$(mktemp -- "$directory/.wall-in-one-backend-stdout.XXXXXX") || return 1
  stderr_file=$(mktemp -- "$directory/.wall-in-one-backend-stderr.XXXXXX") || {
    rm -f -- "$stdout_file"
    stdout_file=''
    return 1
  }
  chmod 0600 -- "$stdout_file" "$stderr_file" || return 1
}

run_bounded() {
  local file_limit_kib=$1
  shift
  (
    umask 077
    ulimit -f "$file_limit_kib" 2>/dev/null || exit 70
    exec env -u PYTHONHOME -u PYTHONPATH \
      PYTHONNOUSERSITE=1 PYTHONSAFEPATH=1 \
      "$@"
  ) >"$stdout_file" 2>"$stderr_file" &
  child_pid=$!
  local result=0
  wait "$child_pid" || result=$?
  child_pid=''
  return "$result"
}

protocol_line() {
  local bytes lines value
  bytes=$(stat -c '%s' -- "$stdout_file" 2>/dev/null) || return 1
  [[ $bytes =~ ^[0-9]+$ ]] || return 1
  (( bytes >= 2 && bytes <= max_protocol_bytes )) || return 1
  lines=$(wc -l <"$stdout_file") || return 1
  (( lines == 1 )) || return 1
  IFS= read -r value <"$stdout_file" || return 1
  [[ -n $value ]] || return 1
  printf '%s' "$value"
}

bounded_failure_detail() {
  local detail=''
  if [[ -n $stderr_file && -f $stderr_file ]]; then
    detail=$(LC_ALL=C head -c 600 -- "$stderr_file" 2>/dev/null || true)
  fi
  if [[ -z $detail && -n $stdout_file && -f $stdout_file ]]; then
    detail=$(LC_ALL=C head -c 600 -- "$stdout_file" 2>/dev/null || true)
  fi
  clean_field "${detail:-external Wall-in-One backend returned no valid protocol record}"
}

valid_error_line() {
  local expected_wire=$1
  local line=$2
  local wire outcome kind detail extra
  IFS=$'\t' read -r wire outcome kind detail extra <<<"$line"
  [[ $wire == "$expected_wire" && $outcome == error && -n $kind && -n $detail && -z ${extra:-} ]]
}

probe_binary() {
  local configured=$1
  local binary
  binary=$(resolve_binary "$configured") || {
    emit_error "$probe_wire" missing-binary 'configured Wall-in-One backend is absent or not executable'
    return 127
  }
  allocate_transport_files /tmp || {
    emit_error "$probe_wire" local-io 'could not allocate bounded probe transport files'
    return 73
  }
  local result=0 line=''
  run_bounded 8 "$binary" probe --protocol 1 || result=$?
  line=$(protocol_line 2>/dev/null || true)
  if (( result != 0 )); then
    if valid_error_line "$probe_wire" "$line"; then
      printf '%s\n' "$line"
    else
      emit_error "$probe_wire" probe-failed "$(bounded_failure_detail)"
    fi
    return "$result"
  fi
  local wire outcome schema version capabilities extra
  IFS=$'\t' read -r wire outcome schema version capabilities extra <<<"$line"
  if [[ $wire != "$probe_wire" || $outcome != ok || $schema != 1 \
    || ! $version =~ ^[0-9]+\.[0-9]+\.[0-9]+([+-][A-Za-z0-9._-]+)?$ \
    || ! $capabilities =~ ^[a-z][a-z0-9.-]*(,[a-z][a-z0-9.-]*)*$ \
    || ,$capabilities, != *,library.scan,* || -n ${extra:-} ]]; then
    emit_error "$probe_wire" incompatible 'external program returned an incompatible capability probe'
    return 70
  fi
  printf '%s\n' "$line"
}

discard_invalid_response() {
  local response=$1
  if [[ -f $response && ! -L $response ]]; then
    local owner
    owner=$(stat -c '%u' -- "$response" 2>/dev/null || true)
    if [[ $owner == "$(id -u)" ]]; then
      rm -f -- "$response"
    fi
  fi
}

rpc_binary() {
  local configured=$1
  local request=$2
  local response=$3
  local guard=$4
  local binary transport
  binary=$(resolve_binary "$configured") || {
    emit_error "$rpc_wire" missing-binary 'configured Wall-in-One backend is absent or not executable'
    return 127
  }
  if ! valid_absolute_path "$request" || ! owned_regular_file "$request" 2 "$max_request_bytes"; then
    emit_error "$rpc_wire" invalid-request 'request must be a current-user regular file of at most 64 KiB'
    return 64
  fi
  transport=${request%/*}
  if ! owned_writable_directory "$transport" \
    || ! valid_absolute_path "$response" \
    || ! valid_absolute_path "$guard" \
    || ! same_parent "$request" "$response" \
    || ! same_parent "$request" "$guard"; then
    emit_error "$rpc_wire" invalid-path 'request, response, and guard must share one owned writable transport directory'
    return 72
  fi
  if [[ ${request##*/} != request-*.json \
    || ${response##*/} != response-*.json \
    || ! ${guard##*/} =~ ^\.wall-in-one-backend-guard-[A-Za-z0-9._-]{1,160}$ ]]; then
    emit_error "$rpc_wire" invalid-path 'transport filenames do not match the backend protocol'
    return 64
  fi
  if [[ -e $response || -L $response ]]; then
    emit_error "$rpc_wire" conflict 'response path already exists'
    return 73
  fi
  if ! guard_ready "$guard"; then
    emit_error "$rpc_wire" cancelled 'RPC cancellation guard is absent or invalid'
    return 75
  fi
  allocate_transport_files "$transport" || {
    emit_error "$rpc_wire" local-io 'could not allocate bounded RPC transport files'
    return 73
  }

  local result=0 line=''
  run_bounded "$max_rpc_file_kib" \
    "$binary" rpc --protocol 1 --request "$request" --response "$response" --guard "$guard" || result=$?
  line=$(protocol_line 2>/dev/null || true)
  if (( result != 0 )); then
    discard_invalid_response "$response"
    if valid_error_line "$rpc_wire" "$line"; then
      printf '%s\n' "$line"
    else
      emit_error "$rpc_wire" launch-failed "$(bounded_failure_detail)"
    fi
    return "$result"
  fi
  if ! guard_ready "$guard"; then
    discard_invalid_response "$response"
    emit_error "$rpc_wire" cancelled 'RPC cancellation guard was removed before completion'
    return 75
  fi

  local wire outcome request_id installed reported_bytes extra actual_bytes
  IFS=$'\t' read -r wire outcome request_id installed reported_bytes extra <<<"$line"
  if [[ $wire != "$rpc_wire" || $outcome != ok \
    || ! $request_id =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$ \
    || $installed != "$response" || ! $reported_bytes =~ ^[0-9]+$ \
    || -n ${extra:-} ]]; then
    discard_invalid_response "$response"
    emit_error "$rpc_wire" protocol 'external program returned a malformed RPC completion record'
    return 70
  fi
  if ! owned_regular_file "$response" 2 "$max_response_bytes"; then
    discard_invalid_response "$response"
    emit_error "$rpc_wire" protocol 'external program did not install a bounded regular response'
    return 70
  fi
  actual_bytes=$(stat -c '%s' -- "$response" 2>/dev/null || printf 0)
  if [[ $actual_bytes != "$reported_bytes" ]]; then
    discard_invalid_response "$response"
    emit_error "$rpc_wire" protocol 'RPC response size did not match its completion record'
    return 70
  fi
  if [[ $(LC_ALL=C head -c 1 -- "$response" 2>/dev/null) != '{' ]]; then
    discard_invalid_response "$response"
    emit_error "$rpc_wire" protocol 'RPC response did not contain a JSON object'
    return 70
  fi
  printf '%s\n' "$line"
}

self_test() {
  valid_absolute_path '/tmp/wall-in-one-backend/request-1.json' || return 1
  ! valid_absolute_path '/tmp/wall-in-one-backend/../escape' || return 1
  ! valid_absolute_path $'/tmp/wall-in-one-backend/bad\npath' || return 1
  resolve_binary '/definitely/missing/wall-in-one-backend' >/dev/null 2>&1 && return 1
  valid_error_line "$rpc_wire" $'WIO-BACKEND-RPC1\terror\tfixture\tbounded failure' || return 1
  ! valid_error_line "$rpc_wire" $'WIO-BACKEND-PROBE1\terror\tfixture\twrong wire' || return 1
  [[ $(( ${#guard_wire} + 1 )) == 19 ]] || return 1
  printf '%s\tok\tself-test\n' "$self_test_wire"
}

case ${1:-} in
  probe)
    (( $# == 2 )) || {
      emit_error "$probe_wire" usage 'probe expects BINARY'
      exit 64
    }
    probe_binary "$2"
    ;;
  rpc)
    (( $# == 5 )) || {
      emit_error "$rpc_wire" usage 'rpc expects BINARY REQUEST RESPONSE GUARD'
      exit 64
    }
    rpc_binary "$2" "$3" "$4" "$5"
    ;;
  self-test)
    (( $# == 1 )) || {
      emit_error "$rpc_wire" usage 'self-test accepts no arguments'
      exit 64
    }
    self_test || {
      emit_error "$rpc_wire" self-test 'backend-provider launcher self-test failed'
      exit 1
    }
    ;;
  *)
    emit_error "$rpc_wire" usage 'expected probe BINARY, rpc BINARY REQUEST RESPONSE GUARD, or self-test'
    exit 64
    ;;
esac
