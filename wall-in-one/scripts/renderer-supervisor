#!/usr/bin/env bash
set -uo pipefail

# Wall-in-One renderer supervisor.
#
# This process stays in the runStream process group. Renderers are ordinary
# children: no setsid, systemd scope, self-daemonization, or name-based process
# matching is used. Noctalia can therefore tear the entire owned tree down on a
# service reload, disable, or shutdown.

if (( $# != 1 )); then
  printf 'renderer-supervisor: expected one FIFO path\n' >&2
  exit 64
fi

fifo_path=$1
case $fifo_path in
  /*) ;;
  *)
    printf 'renderer-supervisor: FIFO path must be absolute\n' >&2
    exit 64
    ;;
esac
if [[ $fifo_path == *$'\n'* || $fifo_path == *$'\r'* || $fifo_path == *$'\t'* ]]; then
  printf 'renderer-supervisor: FIFO path contains control characters\n' >&2
  exit 64
fi

runtime_dir=${fifo_path%/*}
fifo_name=${fifo_path##*/}
instance_name=${fifo_name%.fifo}

umask 077
if ! mkdir -p -- "$runtime_dir"; then
  printf 'renderer-supervisor: could not create runtime directory\n' >&2
  exit 73
fi
if ! rm -f -- "$fifo_path" || ! mkfifo -m 600 -- "$fifo_path"; then
  printf 'renderer-supervisor: could not create command FIFO\n' >&2
  exit 73
fi
if ! exec 3<>"$fifo_path"; then
  printf 'renderer-supervisor: could not open command FIFO\n' >&2
  rm -f -- "$fifo_path"
  exit 74
fi

declare -A child_pid=()
declare -A child_backend=()
declare -A child_paused=()
declare -A child_pause_mode=()
declare -A child_socket=()
declare -A child_nonce=()
declare -A child_muted=()
declare -A child_controls=()
declare -A child_artifact=()
declare -A child_artifact_nonce=()
declare -A child_artifact_size=()
declare -A child_artifact_stable=()
declare -A child_artifact_deadline=()
declare -a created_logs=()

last_nonce=0
cleaning_up=0
readonly LOG_LIMIT_BYTES=$((1024 * 1024))

command_help=''

command_supports_option() {
  local executable=$1
  local option=$2
  command_help=$("$executable" --help 2>&1 || true)
  [[ $command_help == *"$option"* ]]
}

clean_detail() {
  local detail=${1:-}
  detail=${detail//$'\t'/ }
  detail=${detail//$'\r'/ }
  detail=${detail//$'\n'/ }
  printf '%s' "${detail:0:240}"
}

emit() {
  local nonce=${1:-0}
  local event=${2:-error}
  local output=${3:--}
  local backend=${4:-supervisor}
  local code=${5:-1}
  local detail
  detail=$(clean_detail "${6:-}")
  if ! printf 'WIO1\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$nonce" "$event" "$output" "$backend" "$code" "$detail"; then
    exit 0
  fi
}

valid_output() {
  [[ ${1:-} =~ ^[[:alnum:]_.:-]+$ ]]
}

valid_bool() {
  [[ ${1:-} == 0 || ${1:-} == 1 ]]
}

valid_w_engine_source() {
  local source=${1:-}
  if [[ $source =~ ^[0-9]+$ && ${#source} -le 24 ]]; then
    return 0
  fi
  if [[ $source != /* || ${#source} -gt 2048 || $source == *$'\n'* || $source == *$'\r'* || $source == *$'\t'* ]]; then
    return 1
  fi
  # Project directories are selected locally and passed as one quoted argv
  # value. Reject traversal spelling as well as absent/empty manifests before
  # linux-wallpaperengine sees the path.
  case "/${source#/}/" in
    */../*) return 1 ;;
  esac
  [[ -d $source && -f $source/project.json && -s $source/project.json ]]
}

safe_output_name() {
  local value=${1:-output}
  # `%` is outside valid_output's accepted alphabet, so this encoding remains
  # injective when real output names contain both colons and underscores.
  value=${value//:/%3A}
  printf '%s' "$value"
}

artifact_open_by_child() {
  local pid=$1
  local artifact=$2
  local descriptor
  [[ -d /proc/$pid/fd ]] || return 1
  for descriptor in /proc/"$pid"/fd/*; do
    [[ ! $descriptor -ef $artifact ]] || return 0
  done
  return 1
}

forget_output() {
  local output=$1
  local preserve_artifact=${2:-0}
  local socket=${child_socket[$output]:-}
  local artifact=${child_artifact[$output]:-}
  [[ -z $socket ]] || rm -f -- "$socket"
  if [[ -n $artifact && $preserve_artifact != 1 ]]; then
    rm -f -- "$artifact"
  fi
  unset "child_pid[$output]"
  unset "child_backend[$output]"
  unset "child_paused[$output]"
  unset "child_pause_mode[$output]"
  unset "child_socket[$output]"
  unset "child_nonce[$output]"
  unset "child_muted[$output]"
  unset "child_controls[$output]"
  unset "child_artifact[$output]"
  unset "child_artifact_nonce[$output]"
  unset "child_artifact_size[$output]"
  unset "child_artifact_stable[$output]"
  unset "child_artifact_deadline[$output]"
}

remember_log() {
  local candidate=$1
  local known
  for known in "${created_logs[@]}"; do
    [[ $known != "$candidate" ]] || return
  done
  created_logs+=("$candidate")
}

truncate_large_logs() {
  local log_path size
  for log_path in "${created_logs[@]}"; do
    [[ -f $log_path ]] || continue
    size=$(stat -c %s -- "$log_path" 2>/dev/null) || continue
    if (( size > LOG_LIMIT_BYTES )); then
      # Keep the writer on the same inode: replacing the path would leave the
      # child appending to an unlinked, unbounded file.
      : >"$log_path"
    fi
  done
}

stop_output() {
  local output=$1
  local nonce=$2
  local report=${3:-1}
  local pid=${child_pid[$output]:-}
  local backend=${child_backend[$output]:-none}
  local artifact=${child_artifact[$output]:-}
  local artifact_nonce=${child_artifact_nonce[$output]:-}

  if [[ -z $pid ]]; then
    if (( report == 1 )); then
      emit "$nonce" stopped "$output" "$backend" 0 'not running'
    fi
    return 0
  fi

  if [[ -n $artifact && -n $artifact_nonce ]]; then
    emit "$artifact_nonce" cancelled "$output" w-engine 125 'owned Wallpaper Engine screenshot was interrupted'
  fi

  kill -CONT "$pid" 2>/dev/null || true
  kill -TERM "$pid" 2>/dev/null || true
  for _ in {1..10}; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.05
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL "$pid" 2>/dev/null || true
  fi
  wait "$pid" 2>/dev/null || true
  forget_output "$output"
  if (( report == 1 )); then
    emit "$nonce" stopped "$output" "$backend" 0 'owned renderer stopped'
  fi
}

stop_all() {
  local nonce=$1
  local report=${2:-1}
  local outputs=()
  local output
  for output in "${!child_pid[@]}"; do
    outputs+=("$output")
  done
  for output in "${outputs[@]}"; do
    stop_output "$output" "$nonce" 0
  done
  if (( report == 1 )); then
    emit "$nonce" stopped-all - supervisor 0 'all owned renderers stopped'
  fi
}

cleanup() {
  if (( cleaning_up == 1 )); then
    return
  fi
  cleaning_up=1
  stop_all "$last_nonce" 0
  exec 3>&- 3<&- || true
  rm -f -- "$fifo_path"
  local log_path
  for log_path in "${created_logs[@]}"; do
    rm -f -- "$log_path"
  done
}

trap 'exit 0' TERM INT HUP
trap cleanup EXIT

start_child() {
  local nonce=$1
  local output=$2
  local backend=$3
  local socket=$4
  local muted=$5
  local controls=$6
  shift 6
  local safe_output
  safe_output=$(safe_output_name "$output")
  local log_path="$runtime_dir/$instance_name-$safe_output-$backend.log"

  stop_output "$output" "$nonce" 0
  remember_log "$log_path"
  : >"$log_path"
  "$@" >>"$log_path" 2>&1 &
  local pid=$!
  child_pid[$output]=$pid
  child_backend[$output]=$backend
  child_paused[$output]=0
  child_pause_mode[$output]=none
  child_socket[$output]=$socket
  child_nonce[$output]=$nonce
  child_muted[$output]=$muted
  child_controls[$output]=$controls

  sleep 0.05
  if kill -0 "$pid" 2>/dev/null; then
    emit "$nonce" started "$output" "$backend" 0 "owned renderer started; controls=$controls; log=$log_path"
    return 0
  fi

  local rc=1
  wait "$pid" 2>/dev/null || rc=$?
  forget_output "$output"
  emit "$nonce" start-error "$output" "$backend" "$rc" "renderer failed to start; log=$log_path"
  return 1
}

start_w_engine() {
  local nonce=$1
  local output=$2
  shift 2
  local id=${1:-}
  local fps=${2:-}
  local volume=${3:-}
  local scaling=${4:-}
  local clamp=${5:-}
  local layer=${6:-}
  local silent=${7:-}
  local noautomute=${8:-}
  local no_audio_processing=${9:-}
  local disable_particles=${10:-}
  local disable_mouse=${11:-}
  local disable_parallax=${12:-}
  local no_fullscreen_pause=${13:-}
  local fullscreen_pause_only_active=${14:-}
  local screenshot_path=${15:-}
  local screenshot_delay=${16:-}

  if ! command -v linux-wallpaperengine >/dev/null 2>&1; then
    emit "$nonce" error "$output" w-engine 127 'linux-wallpaperengine is unavailable'
    return
  fi
  if ! valid_w_engine_source "$id" || [[ ! $fps =~ ^[0-9]+$ || ! $volume =~ ^[0-9]+$ ]]; then
    emit "$nonce" error "$output" w-engine 64 'invalid Workshop source or numeric option'
    return
  fi
  if (( fps < 5 || fps > 144 || volume < 0 || volume > 100 )); then
    emit "$nonce" error "$output" w-engine 64 'numeric option is out of range'
    return
  fi
  case $scaling in default|stretch|fit|fill) ;; *) emit "$nonce" error "$output" w-engine 64 'invalid scaling'; return ;; esac
  case $clamp in clamp|border|repeat) ;; *) emit "$nonce" error "$output" w-engine 64 'invalid clamp'; return ;; esac
  case $layer in background|bottom) ;; *) emit "$nonce" error "$output" w-engine 64 'invalid layer'; return ;; esac
  local flag
  for flag in "$silent" "$noautomute" "$no_audio_processing" "$disable_particles" \
    "$disable_mouse" "$disable_parallax" "$no_fullscreen_pause" "$fullscreen_pause_only_active"; do
    if ! valid_bool "$flag"; then
      emit "$nonce" error "$output" w-engine 64 'invalid boolean option'
      return
    fi
  done
  if [[ $no_fullscreen_pause == 1 && $fullscreen_pause_only_active == 1 ]]; then
    emit "$nonce" error "$output" w-engine 64 'fullscreen pause flags conflict'
    return
  fi
  if [[ -n $screenshot_path ]]; then
    if [[ $screenshot_path != /* || $screenshot_path != *.png || $screenshot_path == *$'\n'* || $screenshot_path == *$'\r'* || $screenshot_path == *$'\t'* || ${#screenshot_path} -gt 2048 ]]; then
      emit "$nonce" error "$output" w-engine 64 'invalid screenshot path'
      return
    fi
    if [[ ! $screenshot_delay =~ ^[0-9]+$ ]] || (( screenshot_delay < 1 || screenshot_delay > 5 )); then
      emit "$nonce" error "$output" w-engine 64 'invalid screenshot delay'
      return
    fi
    if [[ ! -d ${screenshot_path%/*} ]]; then
      emit "$nonce" error "$output" w-engine 73 'screenshot directory is unavailable'
      return
    fi
    rm -f -- "$screenshot_path"
  elif [[ -n $screenshot_delay ]]; then
    emit "$nonce" error "$output" w-engine 64 'screenshot delay requires a path'
    return
  fi

  local -a args=(
    linux-wallpaperengine
    --screen-root "$output"
    --bg "$id"
    --scaling "$scaling"
    --clamp "$clamp"
    --fps "$fps"
  )
  if command_supports_option linux-wallpaperengine --layer; then
    args+=(--layer "$layer")
  elif [[ $layer != bottom ]]; then
    emit "$nonce" error "$output" w-engine 69 'installed linux-wallpaperengine supports only the bottom layer'
    return
  fi
  if [[ $silent == 1 ]]; then
    args+=(--silent)
  else
    args+=(--volume "$volume")
  fi
  [[ $noautomute == 0 ]] || args+=(--noautomute)
  [[ $no_audio_processing == 0 ]] || args+=(--no-audio-processing)
  [[ $disable_particles == 0 ]] || args+=(--disable-particles)
  [[ $disable_mouse == 0 ]] || args+=(--disable-mouse)
  [[ $disable_parallax == 0 ]] || args+=(--disable-parallax)
  [[ $no_fullscreen_pause == 0 ]] || args+=(--no-fullscreen-pause)
  [[ $fullscreen_pause_only_active == 0 ]] || args+=(--fullscreen-pause-only-active)

  if [[ -n $screenshot_path ]]; then
    args+=(--screenshot "$screenshot_path" --screenshot-delay "$screenshot_delay")
  fi

  local controls=signals
  [[ -z $screenshot_path ]] || controls=stop-only
  if start_child "$nonce" "$output" w-engine '' "$silent" "$controls" "${args[@]}" && [[ -n $screenshot_path ]]; then
    child_artifact[$output]=$screenshot_path
    child_artifact_nonce[$output]=$nonce
    child_artifact_size[$output]=0
    child_artifact_stable[$output]=0
    child_artifact_deadline[$output]=$((SECONDS + 30))
    emit "$nonce" capture-started "$output" w-engine 0 'owned Wallpaper Engine screenshot started'
  fi
}

start_mpvpaper() {
  local nonce=$1
  local output=$2
  local video=${3:-}
  local layer=${4:-}
  local mute=${5:-}
  local volume=${6:-}
  local hardware_decode=${7:-}
  local auto_pause=${8:-}
  local auto_pause_mode=${9:-}
  local encoded_options=${10:-}
  local extra_options

  if ! command -v mpvpaper >/dev/null 2>&1; then
    emit "$nonce" error "$output" mpvpaper 127 'mpvpaper is unavailable'
    return
  fi
  if [[ $video != /* || ! -f $video || $video == *$'\n'* || $video == *$'\r'* || $video == *$'\t'* ]]; then
    emit "$nonce" error "$output" mpvpaper 66 'video path is invalid'
    return
  fi
  if ! valid_bool "$mute" || ! valid_bool "$hardware_decode" || ! valid_bool "$auto_pause"; then
    emit "$nonce" error "$output" mpvpaper 64 'invalid boolean option'
    return
  fi
  if [[ ! $volume =~ ^[0-9]+$ ]] || (( volume < 0 || volume > 100 )); then
    emit "$nonce" error "$output" mpvpaper 64 'volume is out of range'
    return
  fi
  case $layer in background|bottom) ;; *) emit "$nonce" error "$output" mpvpaper 64 'invalid layer'; return ;; esac
  if [[ $auto_pause_mode != FULL && $auto_pause_mode != MAX && $auto_pause_mode != ACTIVE ]]; then
    emit "$nonce" error "$output" mpvpaper 64 'auto-pause mode must be FULL, MAX, or ACTIVE'
    return
  fi
  case $encoded_options in
    E) extra_options='' ;;
    V*) extra_options=${encoded_options:1} ;;
    *)
      emit "$nonce" error "$output" mpvpaper 64 'additional mpv options sentinel is invalid'
      return
      ;;
  esac
  if [[ $extra_options == *$'\n'* || $extra_options == *$'\r'* || $extra_options == *$'\t'* || ${#extra_options} -gt 1024 ]]; then
    emit "$nonce" error "$output" mpvpaper 64 'additional mpv options are invalid'
    return
  fi
  local option_token option_key
  local -a option_tokens=()
  read -r -a option_tokens <<<"$extra_options"
  for option_token in "${option_tokens[@]}"; do
    option_key=${option_token%%=*}
    option_key=${option_key#--}
    option_key=${option_key,,}
    case $option_key in
      input-ipc-server|no-input-ipc-server|audio|no-audio|aid|mute|volume)
        emit "$nonce" error "$output" mpvpaper 64 'additional mpv options override owned IPC or audio state'
        return
        ;;
    esac
  done

  local safe_output
  safe_output=$(safe_output_name "$output")
  local socket="$runtime_dir/$instance_name-$safe_output.mpv.sock"
  local socket_option=''
  rm -f -- "$socket"
  # AF_UNIX paths are normally limited to roughly 108 bytes. Exact PID signals
  # remain the control path if the private owner socket cannot fit safely.
  if (( ${#socket} < 100 )); then
    socket_option=" input-ipc-server=$socket"
  else
    socket=''
  fi

  local options="loop-file=inf panscan=1.0 terminal=no volume=$volume"
  if [[ $mute == 1 ]]; then
    # Keep the audio track alive so the private mpv IPC socket can unmute it
    # later. `no-audio` permanently discards that runtime control surface.
    options+=' mute=yes'
  else
    options+=' mute=no'
  fi
  if [[ $hardware_decode == 1 ]]; then
    options+=' hwdec=auto'
  else
    options+=' hwdec=no'
  fi
  options+=$socket_option
  if [[ -n $extra_options ]]; then
    options+=" $extra_options"
  fi

  local -a args=(mpvpaper --layer "$layer")
  if [[ $auto_pause == 1 ]]; then
    args+=(--auto-pause)
    if command_supports_option mpvpaper --auto-mode; then
      args+=(--auto-mode "$auto_pause_mode")
    elif [[ $auto_pause_mode == ACTIVE ]]; then
      emit "$nonce" error "$output" mpvpaper 69 'installed mpvpaper does not support ACTIVE auto-pause mode'
      return
    fi
  fi
  args+=(-o "$options" "$output" "$video")
  local controls=pause-only
  if [[ -n $socket ]] && socket_client_available; then
    controls=mpv-ipc
  fi
  start_child "$nonce" "$output" mpvpaper "$socket" "$mute" "$controls" "${args[@]}"
}

socket_client_available() {
  if command -v socat >/dev/null 2>&1; then
    return 0
  fi
  if command -v nc >/dev/null 2>&1; then
    local help
    help=$(nc -h 2>&1 || true)
    [[ $help == *-U* && ( ( $help == *-N* && $help == *-w* ) || $help == *-q* || $help == *--send-only* ) ]]
    return
  fi
  return 1
}

mpv_response_success() {
  [[ ${1:-} =~ \"error\"[[:space:]]*:[[:space:]]*\"success\" ]]
}

socket_command() {
  local socket=$1
  local command_text=$2
  local response=''
  local rc=0
  [[ -n $socket && -S $socket ]] || return 66

  if command -v socat >/dev/null 2>&1; then
    response=$(printf '%s\n' "$command_text" | socat -T 1 - "UNIX-CONNECT:$socket" 2>/dev/null) || rc=$?
    mpv_response_success "$response" && return 0
    (( rc != 0 )) && return "$rc"
    return 74
  fi
  if command -v nc >/dev/null 2>&1; then
    local help
    help=$(nc -h 2>&1 || true)
    if [[ $help == *-U* && $help == *-N* && $help == *-w* ]]; then
      response=$(printf '%s\n' "$command_text" | nc -U -N -w 1 "$socket" 2>/dev/null) || rc=$?
      mpv_response_success "$response" && return 0
      (( rc != 0 )) && return "$rc"
      return 74
    elif [[ $help == *-U* && $help == *-q* ]]; then
      response=$(printf '%s\n' "$command_text" | nc -U -q 1 "$socket" 2>/dev/null) || rc=$?
      mpv_response_success "$response" && return 0
      (( rc != 0 )) && return "$rc"
      return 74
    elif [[ $help == *-U* && $help == *--send-only* ]]; then
      printf '%s\n' "$command_text" | nc -U --send-only "$socket" >/dev/null 2>&1
      return
    fi
  fi
  return 69
}

playback_output() {
  local nonce=$1
  local action=$2
  local output=$3
  local pid=${child_pid[$output]:-}
  local backend=${child_backend[$output]:-none}
  if [[ -z $pid ]] || ! kill -0 "$pid" 2>/dev/null; then
    [[ -z $pid ]] || forget_output "$output"
    emit "$nonce" not-running "$output" "$backend" 3 'no owned renderer is running'
    return
  fi

  if [[ $action == toggle ]]; then
    action=resume
    [[ ${child_paused[$output]:-0} == 1 ]] || action=pause
  fi

  if [[ $action == pause ]]; then
    if [[ ${child_paused[$output]:-0} == 1 ]]; then
      emit "$nonce" paused "$output" "$backend" 0 "already paused; mode=${child_pause_mode[$output]:-signal}"
      return
    fi
    if [[ $backend == mpvpaper ]] && socket_command "${child_socket[$output]:-}" 'set pause yes'; then
      child_pause_mode[$output]=ipc
    else
      # Exact-PID SIGSTOP is the playback-only compatibility fallback. It is
      # never used to pretend that mute or volume control succeeded.
      if ! kill -STOP "$pid" 2>/dev/null; then
        emit "$nonce" control-error "$output" "$backend" 75 'could not pause the owned renderer'
        return
      fi
      child_pause_mode[$output]=signal
    fi
    child_paused[$output]=1
    emit "$nonce" paused "$output" "$backend" 0 "owned renderer paused; mode=${child_pause_mode[$output]}"
    return
  fi

  if [[ ${child_paused[$output]:-0} != 1 ]]; then
    emit "$nonce" resumed "$output" "$backend" 0 'already running'
    return
  fi
  if [[ ${child_pause_mode[$output]:-signal} == ipc ]]; then
    if ! socket_command "${child_socket[$output]:-}" 'set pause no'; then
      emit "$nonce" control-error "$output" "$backend" 74 'mpv IPC could not resume playback'
      return
    fi
  elif ! kill -CONT "$pid" 2>/dev/null; then
    emit "$nonce" control-error "$output" "$backend" 75 'could not resume the owned renderer'
    return
  fi
  child_paused[$output]=0
  child_pause_mode[$output]=none
  emit "$nonce" resumed "$output" "$backend" 0 'owned renderer resumed'
}

audio_output() {
  local nonce=$1
  local action=$2
  local output=$3
  local requested_volume=${4:-}
  local pid=${child_pid[$output]:-}
  local backend=${child_backend[$output]:-none}
  if [[ -z $pid ]] || ! kill -0 "$pid" 2>/dev/null; then
    [[ -z $pid ]] || forget_output "$output"
    emit "$nonce" not-running "$output" "$backend" 3 'no owned renderer is running'
    return
  fi
  if [[ $backend != mpvpaper ]]; then
    emit "$nonce" unsupported "$output" "$backend" 95 'live audio control is unavailable for linux-wallpaperengine'
    return
  fi
  if [[ ${child_controls[$output]:-pause-only} != mpv-ipc ]]; then
    emit "$nonce" unsupported "$output" "$backend" 95 'no supported private mpv IPC client is available'
    return
  fi
  if [[ ${child_paused[$output]:-0} == 1 && ${child_pause_mode[$output]:-none} == signal ]]; then
    emit "$nonce" control-error "$output" "$backend" 75 'resume signal-paused playback before changing audio'
    return
  fi

  case $action in
    toggle_mute)
      action=mute
      [[ ${child_muted[$output]:-0} == 1 ]] && action=unmute
      ;;
    set_volume)
      if ! socket_command "${child_socket[$output]:-}" "set volume $requested_volume"; then
        emit "$nonce" control-error "$output" "$backend" 74 'private mpv IPC could not set volume'
        return
      fi
      emit "$nonce" volume-set "$output" "$backend" 0 "volume=$requested_volume"
      return
      ;;
  esac

  local mute_value=0
  local event=unmuted
  local property=no
  if [[ $action == mute ]]; then
    mute_value=1
    event=muted
    property=yes
  fi
  if ! socket_command "${child_socket[$output]:-}" "set mute $property"; then
    emit "$nonce" control-error "$output" "$backend" 74 'private mpv IPC could not change mute state'
    return
  fi
  child_muted[$output]=$mute_value
  emit "$nonce" "$event" "$output" "$backend" 0 "mute=$property"
}

finish_capture() {
  local output=$1
  local nonce=${child_artifact_nonce[$output]:-${child_nonce[$output]:-$last_nonce}}
  local pid=${child_pid[$output]:-}

  if [[ -n $pid ]]; then
    kill -CONT "$pid" 2>/dev/null || true
    kill -TERM "$pid" 2>/dev/null || true
    for _ in {1..20}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.05
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
    wait "$pid" 2>/dev/null || true
  fi
  forget_output "$output" 1
  emit "$nonce" captured "$output" w-engine 0 'owned Wallpaper Engine screenshot is ready'
}

fail_capture() {
  local output=$1
  local code=$2
  local detail=$3
  local nonce=${child_artifact_nonce[$output]:-${child_nonce[$output]:-$last_nonce}}
  local pid=${child_pid[$output]:-}

  if [[ -n $pid ]]; then
    kill -CONT "$pid" 2>/dev/null || true
    kill -TERM "$pid" 2>/dev/null || true
    for _ in {1..10}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.05
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
    wait "$pid" 2>/dev/null || true
  fi
  forget_output "$output"
  emit "$nonce" capture-error "$output" w-engine "$code" "$detail"
}

check_captures() {
  local outputs=()
  local output artifact pid size previous stable deadline rc
  for output in "${!child_artifact[@]}"; do
    outputs+=("$output")
  done
  for output in "${outputs[@]}"; do
    artifact=${child_artifact[$output]:-}
    pid=${child_pid[$output]:-}
    [[ -n $artifact && -n $pid ]] || continue

    if [[ -f $artifact && -s $artifact ]]; then
      size=$(stat -c %s -- "$artifact" 2>/dev/null) || size=0
      previous=${child_artifact_size[$output]:-0}
      stable=${child_artifact_stable[$output]:-0}
      if (( size > 0 && size == previous )); then
        (( stable += 1 ))
      else
        stable=0
      fi
      child_artifact_size[$output]=$size
      child_artifact_stable[$output]=$stable
      if (( stable >= 1 )) && ! artifact_open_by_child "$pid" "$artifact"; then
        finish_capture "$output"
        continue
      fi
    fi

    if ! kill -0 "$pid" 2>/dev/null; then
      rc=0
      wait "$pid" 2>/dev/null || rc=$?
      if [[ -f $artifact && -s $artifact && $rc == 0 ]]; then
        finish_capture "$output"
      else
        fail_capture "$output" "$rc" 'Wallpaper Engine exited before producing a screenshot'
      fi
      continue
    fi

    deadline=${child_artifact_deadline[$output]:-0}
    if (( deadline > 0 && SECONDS >= deadline )); then
      fail_capture "$output" 124 'Wallpaper Engine screenshot timed out'
    fi
  done
}

handle_line() {
  local line=$1
  local -a fields=()
  IFS=$'\t' read -r -a fields <<<"$line"
  local protocol=${fields[0]:-}
  local nonce=${fields[1]:-}
  local action=${fields[2]:-}
  local output=${fields[3]:-}

  if [[ $protocol != WIO1 || ! $nonce =~ ^[0-9]+$ ]]; then
    emit 0 error - supervisor 64 'invalid command envelope'
    return
  fi
  if (( 10#$nonce <= last_nonce )); then
    emit "$nonce" ignored "$output" supervisor 0 'nonce is not newer'
    return
  fi
  last_nonce=$((10#$nonce))

  if [[ $action == stop_all ]]; then
    if (( ${#fields[@]} != 4 )); then
      emit "$nonce" error - supervisor 64 'stop_all has invalid fields'
      return
    fi
    stop_all "$nonce" 1
    return
  fi

  if ! valid_output "$output"; then
    emit "$nonce" error - supervisor 64 'invalid output identifier'
    return
  fi

  case $action in
    start_w_engine)
      if (( ${#fields[@]} != 18 )); then
        emit "$nonce" error "$output" w-engine 64 'start_w_engine has invalid fields'
        return
      fi
      start_w_engine "$nonce" "$output" "${fields[@]:4}"
      ;;
    capture_w_engine)
      if (( ${#fields[@]} != 20 )); then
        emit "$nonce" error "$output" w-engine 64 'capture_w_engine has invalid fields'
        return
      fi
      start_w_engine "$nonce" "$output" \
        "${fields[4]}" "${fields[7]}" "${fields[8]}" "${fields[9]}" "${fields[10]}" "${fields[11]}" \
        "${fields[12]}" "${fields[13]}" "${fields[14]}" "${fields[15]}" "${fields[16]}" "${fields[17]}" \
        "${fields[18]}" "${fields[19]}" "${fields[5]}" "${fields[6]}"
      ;;
    start_mpvpaper)
      if (( ${#fields[@]} != 12 )); then
        emit "$nonce" error "$output" mpvpaper 64 'start_mpvpaper has invalid fields'
        return
      fi
      start_mpvpaper "$nonce" "$output" "${fields[@]:4}"
      ;;
    stop)
      (( ${#fields[@]} == 4 )) || { emit "$nonce" error "$output" supervisor 64 'stop has invalid fields'; return; }
      stop_output "$output" "$nonce" 1
      ;;
    pause|resume|toggle)
      (( ${#fields[@]} == 4 )) || { emit "$nonce" error "$output" supervisor 64 "$action has invalid fields"; return; }
      playback_output "$nonce" "$action" "$output"
      ;;
    mute|unmute|toggle_mute)
      (( ${#fields[@]} == 4 )) || { emit "$nonce" error "$output" supervisor 64 "$action has invalid fields"; return; }
      audio_output "$nonce" "$action" "$output"
      ;;
    set_volume)
      if (( ${#fields[@]} != 5 )) || [[ ! ${fields[4]} =~ ^[0-9]+$ ]] || (( 10#${fields[4]} > 100 )); then
        emit "$nonce" error "$output" supervisor 64 'set_volume has invalid fields'
        return
      fi
      audio_output "$nonce" "$action" "$output" "$((10#${fields[4]}))"
      ;;
    *) emit "$nonce" error "$output" supervisor 64 'unsupported action' ;;
  esac
}

check_children() {
  local outputs=()
  local output pid backend nonce rc
  for output in "${!child_pid[@]}"; do
    outputs+=("$output")
  done
  for output in "${outputs[@]}"; do
    pid=${child_pid[$output]:-}
    [[ -n $pid ]] || continue
    [[ -z ${child_artifact[$output]:-} ]] || continue
    if ! kill -0 "$pid" 2>/dev/null; then
      backend=${child_backend[$output]:-unknown}
      nonce=${child_nonce[$output]:-$last_nonce}
      rc=0
      wait "$pid" 2>/dev/null || rc=$?
      forget_output "$output"
      emit "$nonce" exited "$output" "$backend" "$rc" 'owned renderer exited'
    fi
  done
}

emit 0 ready - supervisor 0 'renderer supervisor ready'

heartbeat_ticks=0
while :; do
  if IFS= read -r -t 1 line <&3; then
    handle_line "$line"
  fi
  check_captures
  check_children
  truncate_large_logs
  (( heartbeat_ticks += 1 ))
  if (( heartbeat_ticks >= 5 )); then
    heartbeat_ticks=0
    emit "$last_nonce" heartbeat - supervisor 0 alive
  fi
done
